 402 0134 2D 5C		BL convert_moleinput_moleoutput	; FICA EM R0 o index da marretada detetada
 403 0136 05 B0		MOV R5, R0
 404           	
 405 0138 35 5C		BL get_mole_green 				; VAI BUSCAR A MASCARA QUE REPRESENTA OS LEDS VERDES NO INDEX DA MARRETA
 406 013A 00 C2		AND R0, R0, R4					; VALIDA SE O BIT GREEN OBTIDO CORRESPONDE À POSICAO DA TOUPEIRA
 407           	
 408 013C 03 40		BZS mole_hit_return_false
 409           	
 410 013E 80 B2		MOV R0, R5
 411 0140 43 5C		BL turn_mole_red				; APAGA O LED VERDE E ACENDE O RESPETIVO LED VERMERLHO
 412 0142 02 58		B mole_hit_return_true
 413           	
 414           	mole_hit_return_false:
 415 0144 00 60		MOV R0, #0
 416 0146 01 58		B mole_hit_return
 417           	mole_hit_return_true:
 418 0148 10 60		MOV R0, #1
 419           	
 420           	mole_hit_return:
 421           	
 422 014A 05 04		POP R5
 423 014C 04 04		POP R4
 424 014E 0F 04		POP PC
 425           	; end_is_mole_hit
