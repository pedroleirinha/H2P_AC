 691           	;; 		PORTS API 		;;
 692           	;; 						;;
 693           	
 694           	; OUTPORT_SET_BITS
 695           	; Introduz os BITS ao valor já no outputport através de uma mascara
 696           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 697           	;
 698           	outport_set_bits:
 699 01F2 0E 24	    PUSH LR
 700           	    
 701 01F4 61 0D	    LDR r1, out_port_img_addr
 702 01F6 11 08	    LDRB r1, [r1]
 703           	
 704 01F8 80 C8	    ORR r0, r0, r1
 705           	
 706 01FA 08 5C	    BL outport_write
 707           	    
 708 01FC 0F 04	    POP PC
 709           	
 710           	; OUTPORT_CLR_BITS
 711           	; Limpa os BITS do valor já no outputport através de uma mascara
 712           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 713           	;
 714           	outport_clr_bits:
 715 01FE 0E 24	    PUSH LR
 716           	    
 717 0200 01 0D	    LDR r1, out_port_img_addr
 718 0202 11 08	    LDRB r1, [r1]
 719           	
 720 0204 10 B0	    MVN r0, r0
 721 0206 80 C0	    AND r0, r0, r1
 722           	
 723 0208 01 5C	    BL outport_write
 724           	    
 725 020A 0F 04	    POP PC
 726           	
 727           	
 728           	; Rotina:    outport_write
 729           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 730           	;            Interface exemplo: void outport_write( uint8_t value );
 731           	; Entradas:  r0 - valor a escrever no porto de saida
 732           	; Saidas:    -
 733           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 734           	outport_write:
 735 020C 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 736 020E F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 737 0210 10 28		STRB r0, [r1, #0]
 738           	
 739           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 740           		; uma mascara
 741           	
 742 0212 71 0C	    LDR r1, out_port_img_addr    
 743 0214 10 28	    STRB r0, [r1, #0]
 744           	
 745 0216 0F B7		MOV	pc, lr
 746           	
 747           	; Rotina:    INPORT_READ
 748           	; Descricao: lê do porto de saida os 8 bits.
 749           	;            Interface exemplo: uint8_t outport_write();
 750           	; Entradas:   - 
 751           	; Saidas:    r0 - valor lido do porto de entrada
 752           	
 753           	inport_read:
 754 0218 20 0C	    LDR r0, input_port_addr
 755 021A 00 08	    LDRB r0, [r0]
 756 021C 0F B7	    MOV pc, lr
 757           	
 758 021E B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 759 0220 C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 760 0222 AE 02	out_port_img_addr:  .word outport_img
 761           	
