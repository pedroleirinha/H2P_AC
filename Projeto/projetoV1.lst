 768           	
 769           	/************************************************************************************
 770           	 * LIB time
 771           	 ************************************************************************************/
 772           	; Rotina:    time_get_ref
 773           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 774           	; Entradas:  void
 775           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 776           	; Efeitos:   *** Para completar ***
 777           	time_get_ref:
 778 0224 0E 24		PUSH LR
 779           	
 780 0226 18 5C		BL sysclk_get_ticks
 781           	
 782 0228 0F 04		POP PC
 783           	;time_get_ref
 784           	
 785           	; Rotina:    time_elapsed
 786           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 787           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 788           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 789           	; Efeitos:   *** Para completar ***
 790           	time_elapsed:
 791 022A 0E 24		PUSH LR
 792           	
 793 022C 01 B0		MOV R1, R0
 794           	
 795 022E 14 5C		BL sysclk_get_ticks		; Retorna o valor atual do sysclock
 796           	
 797 0230 80 88		SUB R0, R0, R1			; Calcula a diferença entre o tempo atual (sysclk) e o valor referncia (sysclk antigo)
 798           	
 799 0232 0F 04		POP PC
 800           	;time_elapsed
 801           	
 802           	/************************************************************************************
 803           	 * HAL sys_clk
 804           	 ************************************************************************************/
 805           	; Rotina:    isr
 806           	; Descricao: Incrementa o valor da variável global sysclk.
 807           	; Entradas:  -
 808           	; Saidas:    -
 809           	; Efeitos:   *** Para completar ***
 810           	isr:
 811 0234 0E 24		PUSH	LR
 812 0236 01 24		PUSH	r1
 813 0238 00 24		PUSH	r0
 814           		
 815 023A 26 5C		BL 		ptc_clr_irq
 816           	
 817 023C 00 0D		LDR		r0, SYSCLK_ADDR
 818 023E 01 00		LDR		r1, [r0, #0]
 819 0240 91 A0		ADD		r1, r1, #1
 820 0242 01 20		STR		r1, [r0, #0]
 821 0244 00 04		POP		r0
 822 0246 01 04		POP		r1	
 823 0248 0E 04		POP		LR 
 824           	
 825 024A 20 B0		MOVS	pc, lr
 826           	
 827           	
 828           	; Rotina:    sysclk_init
 829           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 830           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 831           	;            interrupção pendentes e iniciando com o valor zero a variavel
 832           	;            global sysclk.
 833           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 834           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 835           	; Saidas:    -
 836           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 837           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 838           	;            valor zero a variavel global sysclk
 839           	sysclk_init:
 840 024C 0E 24		PUSH	lr
 841 024E 71 0C		LDR		r1, SYSCLK_ADDR
 842 0250 02 60		MOV		r2, #0
 843 0252 12 20		STR 	r2, [r1]
 844 0254 05 5C		BL		ptc_init
 845 0256 0F 04		POP		pc
 846           		
 847           	; Rotina:    sysclk_get_ticks
 848           	; Descricao: Devolve o valor corrente da variável global sysclk.
 849           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 850           	; Entradas:  -
 851           	; Saidas:    *** Para completar ***
 852           	; Efeitos:   -
 853           	sysclk_get_ticks:
 854 0258 20 0C		LDR		r0, SYSCLK_ADDR
 855 025A 00 00		LDR		r0, [r0]
 856 025C 0F B7		MOV		pc, lr
 857           	
 858           	
 859          	.align 1
 860 025E B0 02	SYSCLK_ADDR: .word	sysclk
 861           	
 862           	
 863           	/************************************************************************************
 864           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 865           	 ************************************************************************************/
 866           	; Rotina:    ptc_init
 867           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 868           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 869           	;            ticks.
 870           	;            Interface exemplo: void ptc_init( uint8_t interval );
 871           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 872           	; Saidas:    -
 873           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 874           	;            o pedido de interrupcao eventualmente pendente.
 875           	ptc_init:
 876 0260 0E 24	    PUSH    lr
 877 0262 00 24		PUSH	r0
 878 0264 0A 5C		BL 		ptc_stop
 879 0266 00 04		POP		r0
 880 0268 21 0D		LDR		r1, PTC_ADDR
 881 026A 10 29		STRB	r0, [r1, #PTC_TMR_ADDRESS]
 882 026C 0D 5C	    BL  	ptc_clr_irq
 883 026E 01 5C		BL 		ptc_start
 884 0270 0F 04		POP pc
 885           	
 886           	
 887           	
 888           	; Rotina:    ptc_start
 889           	; Descricao: Habilita a contagem no periferico pTC.
 890           	;            Interface exemplo: void ptc_start( );
 891           	; Entradas:  -
 892           	; Saidas:    -
 893           	; Efeitos:   -
 894           	ptc_start:
 895 0272 D0 0C		LDR		r0, PTC_ADDR
 896 0274 01 60		MOV		r1, #PTC_CMD_START
 897 0276 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 898 0278 0F B7		MOV		pc, lr
 899           	
 900           	; Rotina:    ptc_stop
 901           	; Descricao: Para a contagem no periferico pTC.
 902           	;            Interface exemplo: void ptc_stop( );
 903           	; Entradas:  -
 904           	; Saidas:    -
 905           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 906           	ptc_stop:
 907 027A 90 0C		LDR		r0, PTC_ADDR
 908 027C 11 60		MOV		r1, #PTC_CMD_STOP
 909 027E 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 910 0280 0F B7		MOV		pc, lr
 911           	
 912           	; Rotina:    ptc_get_value
 913           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 914           	;            Interface exemplo: uint8_t ptc_get_value( );
 915           	; Entradas:  -
 916           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 917           	; Efeitos:   -
 918           	ptc_get_value:
 919 0282 51 0C		LDR		r1, PTC_ADDR
 920 0284 10 0A		LDRB	r0, [r1, #PTC_TC_ADDRESS]
 921 0286 0F B7		MOV		pc, lr
 922           	
 923           	; Rotina:    ptc_clr_irq
 924           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 925           	;            interrupção.
 926           	;            Interface exemplo: void ptc_clr_irq( );
 927           	; Entradas:  -
 928           	; Saidas:    -
 929           	; Efeitos:   -
 930           	ptc_clr_irq:
 931 0288 20 0C		LDR		r0, PTC_ADDR
 932 028A 01 2B		STRB	r1, [r0, #PTC_TIR_ADDRESS]
 933 028C 0F B7		MOV		pc, lr
 934           	
 935           	PTC_ADDR:
 936 028E 00 FF		.word	PTC_ADDRESS
 937           	
