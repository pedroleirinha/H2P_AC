 451           	
 452           	; Rotina:    detect play
 453           	; Descricao: Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 454           	; Entradas:  -
 455           	; Saidas:    -
 456           	; Efeitos:   
 457           	detect_play:
 458 015E 0E 24		PUSH LR
 459 0160 04 24		PUSH R4
 460           		
 461 0162 2D 5C		BL read_marreta 				; Lê e retorna os 4 bits de menor peso R0
 462 0164 F1 60		MOV R1, #0x0F
 463 0166 02 5C		BL falling_edge_v2
 464           	
 465 0168 04 04		POP R4
 466 016A 0F 04		POP PC
 467           	
 468           	;END DETECT_PLAY
 469           	
 470           	
 471           	
 472           	; Entradas:  r0 - valor lido o porto de entrada
 473           	; 			 r1 - Mascara inicial 
 474           	falling_edge_v2:
 475 016C 62 0C		LDR	 r2, last_play_addr
 476 016E 23 08		LDRB r3, [r2]	; VALOR EM MEMORIA
 477           	
 478 0170 20 28		STRB r0, [r2]	; ATUALIZA EM MEMORIA
 479           	
 480 0172 10 B0		MVN R0, R0		; INVERTE OS BITS 
 481 0174 80 C1		AND R0, R0, R3	
 482           	
 483 0176 80 C0		AND R0, R0, R1 ; FILTRA OS 4 BITS menos significativos 
 484 0178 0F B7		MOV PC, LR
 485           	
 486           	last_play_addr:
 487 017A AF 02		.word	last_play
 488           	
 489           	
 490           	; START_UP
 491           	; Rotina que inicializa o programa.
 492           	start_up_interruptions:
 493 017C 0E 24		PUSH LR
 494           	
 495 017E 46 5C		BL	outport_write		 					; Escreve o zero no output port
 496 0180 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 497 0182 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 498 0184 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 499           	
 500 0186 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 501 0188 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 502 018A 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 503 018C 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 504           	
 505 018E 0F 04		POP PC
 506           	;END interruption
