 509           	;
 510           	; >> Função CONVERT_MOLEINPUT_MOLEOUTPUT <<
 511           	; Tipo: - FOLHA -
 512           	; Parametros de entrada:
 513           	;   uint4_t num_ -------> r0
 514           	;
 515           	; variaveis locais:
 516           	;   uint8_t contador  --> r2
 517           	;
 518           	; Parametros de saida:
 519           	;   uint8_t ---------> r0
 520           	;
 521           	convert_moleinput_moleoutput:
 522 0190 01 60		MOV R1, #0
 523           	convert_while:
 524           	
 525 0192 80 E8	    LSR r0, r0, #1          
 526 0194 02 40		BZS convert_end
 527 0196 91 A0	    ADD r1, r1, #1          ; m => contador; m--
 528 0198 FC 5B	    B	convert_while
 529           	
 530           	convert_end:
 531 019A 80 B0		MOV R0, R1
 532 019C 0F B7		MOV PC, LR
 533           	; END CONVERT
