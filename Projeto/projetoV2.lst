 313 00C8 0E 24		PUSH LR
 314 00CA 04 24		PUSH R4
 315           	
 316 00CC 34 60		MOV R4, #BLINKING_COUNT
 317           		
 318 00CE 33 65		MOV R3, #WAIT_500MS
 319           		
 320 00D0 02 60		MOV R2, #LOSER_LIGHTS
 321 00D2 00 B9		CMP R0, R2
 322 00D4 02 40		BEQ loser_prep
 323           	
