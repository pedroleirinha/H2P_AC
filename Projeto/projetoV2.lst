 418 0126 00 60		MOV R0, #0
 419 0128 01 58		B mole_hit_return
 420           	mole_hit_return_true:
 421 012A 10 60		MOV R0, #1
 422           	
 423           	mole_hit_return:
 424           	
 425 012C 05 04		POP R5
 426 012E 04 04		POP R4
 427 0130 0F 04		POP PC
 428           	; end_is_mole_hit
