1038           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
1039           	 ************************************************************************************/
1040           	; Rotina:    ptc_init
1041           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
1042           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
1043           	;            ticks.
1044           	;            Interface exemplo: void ptc_init( uint8_t interval );
1045           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
1046           	; Saidas:    -
1047           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
1048           	;            o pedido de interrupcao eventualmente pendente.
1049           	ptc_init:
1050 026E 0E 24	    PUSH    lr
1051 0270 00 24		PUSH	r0
1052 0272 0A 5C		BL 		ptc_stop
1053 0274 00 04		POP		r0
1054 0276 21 0D		LDR		r1, PTC_ADDR
1055 0278 10 29		STRB	r0, [r1, #PTC_TMR_ADDRESS]
1056 027A 0D 5C	    BL  	ptc_clr_irq
1057 027C 01 5C		BL 		ptc_start
1058 027E 0F 04		POP pc
