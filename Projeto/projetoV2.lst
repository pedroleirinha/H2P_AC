 433           	
 434           	; Rotina:    detect play
 435           	; Descricao: Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 436           	; Entradas:  -
 437           	; Saidas:    -
 438           	; Efeitos:   
 439           	detect_play:
 440 013E 0E 24		PUSH LR
 441 0140 04 24		PUSH R4
 442           		
 443 0142 2D 5C		BL read_marreta 				; Lê e retorna os 4 bits de menor peso R0
 444 0144 F1 60		MOV R1, #0x0F
 445 0146 02 5C		BL falling_edge_v2
 446           	
 447 0148 04 04		POP R4
 448 014A 0F 04		POP PC
 449           	
 450           	;END DETECT_PLAY
 451           	
 452           	
 453           	
 454           	; Entradas:  r0 - valor lido o porto de entrada
 455           	; 			 r1 - Mascara inicial 
 456           	falling_edge_v2:
 457 014C 62 0C		LDR	 r2, last_play_addr
 458 014E 23 08		LDRB r3, [r2]	; VALOR EM MEMORIA
 459           	
 460 0150 20 28		STRB r0, [r2]	; ATUALIZA EM MEMORIA
 461           	
 462 0152 10 B0		MVN R0, R0		; INVERTE OS BITS 
 463 0154 80 C1		AND R0, R0, R3	
 464           	
 465 0156 80 C0		AND R0, R0, R1 ; FILTRA OS 4 BITS menos significativos 
 466 0158 0F B7		MOV PC, LR
 467           	
 468           	last_play_addr:
 469 015A C7 02		.word	last_play
 470           	
 471           	
 472           	; START_UP
 473           	; Rotina que inicializa o programa.
 474           	start_up_interruptions:
 475 015C 0E 24		PUSH LR
 476           	
 477 015E 62 5C		BL	outport_write		 					; Escreve o zero no output port
 478 0160 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 479 0162 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 480 0164 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 481           	
 482 0166 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 483 0168 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 484 016A 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 485 016C 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 486           	
 487 016E 0F 04		POP PC
 488           	;END interruption
