 501           	; START_UP
 502           	; Rotina que inicializa o programa.
 503           	start_up_interruptions:
 504 0182 0E 24		PUSH LR
 505           	
 506 0184 50 5C		BL	outport_write		 					; Escreve o zero no output port
 507 0186 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 508 0188 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 509 018A 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 510           	
 511 018C 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 512 018E 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 513 0190 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 514 0192 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 515           	
 516 0194 0F 04		POP PC
 517           	;END interruption
