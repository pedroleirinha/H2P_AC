 476           	;
 477           	; >> Função detect_play << 
 478           	;	Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 479           	; Tipo: - FOLHA -
 480           	; Parametros de entrada:
 481           	;	-
 482           	; variaveis locais:
 483           	;	-
 484           	; Parametros de saida:
 485           	;   R0 -> Devolve a mascara com as posições aleatórias retirada do array moles_position.
 486           	;  
 487           	detect_play:
 488 0140 0E 24		PUSH LR
 489 0142 04 24		PUSH R4
 490           		
 491 0144 2D 5C		BL read_marreta 				; Lê e retorna os 4 bits de menor peso R0
 492 0146 F1 60		MOV R1, #0x0F
 493 0148 02 5C		BL falling_edge_v2
 494           	
 495 014A 04 04		POP R4
 496 014C 0F 04		POP PC
 497           	
 498           	;END DETECT_PLAY
 499           	
 500           	
 501           	
 502           	;
 503           	; >> Função detect_play << 
 504           	;	Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 505           	; Tipo: - FOLHA -
 506           	; Parametros de entrada:
 507           	;	R0 - valor lido o porto de entrada
 508           	; 	R1 - Mascara inicial 
 509           	; variaveis locais:
 510           	;	-
 511           	; Parametros de saida:
 512           	;   R0 -> Devolve a mascara que identifica os bits onde foi detetada uma transição descendente,
 513           	;  
 514           	falling_edge_v2:
 515 014E 62 0C		LDR	 r2, last_play_addr
 516 0150 23 08		LDRB r3, [r2]	; VALOR EM MEMORIA
 517           	
 518 0152 20 28		STRB r0, [r2]	; ATUALIZA EM MEMORIA
 519           	
 520 0154 10 B0		MVN R0, R0		; INVERTE OS BITS 
 521 0156 80 C1		AND R0, R0, R3	
 522           	
 523 0158 80 C0		AND R0, R0, R1 ; FILTRA OS 4 BITS menos significativos 
 524 015A 0F B7		MOV PC, LR
 525           	
 526           	last_play_addr:
 527 015C BD 02		.word	last_play
 528           	
 529           	
 530           	;
 531           	; >> Função start_up_interruptions << 
 532           	;	Rotina que inicializa as interrupções no programa
 533           	; Tipo: - FOLHA -
 534           	; Parametros de entrada:
 535           	;	-
 536           	; variaveis locais:
 537           	;	-
 538           	; Parametros de saida:
 539           	;   -
 540           	; 
 541           	start_up_interruptions:
 542 015E 0E 24		PUSH LR
 543           	
 544 0160 5C 5C		BL	outport_write		 					; Escreve o zero no output port
 545 0162 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 546 0164 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 547 0166 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 548           	
 549 0168 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 550 016A 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 551 016C 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 552 016E 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 553           	
 554 0170 0F 04		POP PC
 555           	;END interruption
 556           	
