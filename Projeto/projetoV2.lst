 725           	;; 		PORTS API 		;;
 726           	;; 						;;
 727           	
 728           	; OUTPORT_SET_BITS
 729           	; Introduz os BITS ao valor já no outputport através de uma mascara
 730           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 731           	;
 732           	outport_set_bits:
 733 020C 0E 24	    PUSH LR
 734           	    
 735 020E 61 0D	    LDR r1, out_port_img_addr
 736 0210 11 08	    LDRB r1, [r1]
 737           	
 738 0212 80 C8	    ORR r0, r0, r1
 739           	
 740 0214 08 5C	    BL outport_write
 741           	    
 742 0216 0F 04	    POP PC
 743           	
 744           	; OUTPORT_CLR_BITS
 745           	; Limpa os BITS do valor já no outputport através de uma mascara
 746           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 747           	;
 748           	outport_clr_bits:
 749 0218 0E 24	    PUSH LR
 750           	    
 751 021A 01 0D	    LDR r1, out_port_img_addr
 752 021C 11 08	    LDRB r1, [r1]
 753           	
 754 021E 10 B0	    MVN r0, r0
 755 0220 80 C0	    AND r0, r0, r1
 756           	
 757 0222 01 5C	    BL outport_write
 758           	    
 759 0224 0F 04	    POP PC
 760           	
 761           	
 762           	; Rotina:    outport_write
 763           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 764           	;            Interface exemplo: void outport_write( uint8_t value );
 765           	; Entradas:  r0 - valor a escrever no porto de saida
 766           	; Saidas:    -
 767           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 768           	outport_write:
 769 0226 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 770 0228 F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 771 022A 10 28		STRB r0, [r1, #0]
 772           	
 773           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 774           		; uma mascara
 775           	
 776 022C 71 0C	    LDR r1, out_port_img_addr    
 777 022E 10 28	    STRB r0, [r1, #0]
 778           	
 779 0230 0F B7		MOV	pc, lr
 780           	
 781           	; Rotina:    INPORT_READ
 782           	; Descricao: lê do porto de saida os 8 bits.
 783           	;            Interface exemplo: uint8_t outport_write();
 784           	; Entradas:   - 
 785           	; Saidas:    r0 - valor lido do porto de entrada
 786           	
 787           	inport_read:
 788 0232 20 0C	    LDR r0, input_port_addr
 789 0234 00 08	    LDRB r0, [r0]
 790 0236 0F B7	    MOV pc, lr
 791           	
 792 0238 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 793 023A C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 794 023C C8 02	out_port_img_addr:  .word outport_img
 795           	
