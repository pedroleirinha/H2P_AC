 865           	;; 		PORTS API 		;;
 866           	;; 						;;
 867           	
 868           	; OUTPORT_SET_BITS
 869           	; Introduz os BITS ao valor já no outputport através de uma mascara
 870           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 871           	;
 872           	outport_set_bits:
 873 0200 0E 24	    PUSH LR
 874           	    
 875 0202 61 0D	    LDR r1, out_port_img_addr
 876 0204 11 08	    LDRB r1, [r1]
 877           	
 878 0206 80 C8	    ORR r0, r0, r1
 879           	
 880 0208 08 5C	    BL outport_write
 881           	    
 882 020A 0F 04	    POP PC
 883           	
 884           	; OUTPORT_CLR_BITS
 885           	; Limpa os BITS do valor já no outputport através de uma mascara
 886           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 887           	;
 888           	outport_clr_bits:
 889 020C 0E 24	    PUSH LR
 890           	    
 891 020E 01 0D	    LDR r1, out_port_img_addr
 892 0210 11 08	    LDRB r1, [r1]
 893           	
 894 0212 10 B0	    MVN r0, r0
 895 0214 80 C0	    AND r0, r0, r1
 896           	
 897 0216 01 5C	    BL outport_write
 898           	    
 899 0218 0F 04	    POP PC
 900           	
 901           	
 902           	; Rotina:    outport_write
 903           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 904           	;            Interface exemplo: void outport_write( uint8_t value );
 905           	; Entradas:  r0 - valor a escrever no porto de saida
 906           	; Saidas:    -
 907           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 908           	outport_write:
 909 021A 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 910 021C F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 911 021E 10 28		STRB r0, [r1, #0]
 912           	
 913           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 914           		; uma mascara
 915           	
 916 0220 71 0C	    LDR r1, out_port_img_addr    
 917 0222 10 28	    STRB r0, [r1, #0]
 918           	
 919 0224 0F B7		MOV	pc, lr
 920           	
 921           	; Rotina:    INPORT_READ
 922           	; Descricao: lê do porto de saida os 8 bits.
 923           	;            Interface exemplo: uint8_t outport_write();
 924           	; Entradas:   - 
 925           	; Saidas:    r0 - valor lido do porto de entrada
 926           	
 927           	inport_read:
 928 0226 20 0C	    LDR r0, input_port_addr
 929 0228 00 08	    LDRB r0, [r0]
 930 022A 0F B7	    MOV pc, lr
 931           	
 932 022C B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 933 022E C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 934 0230 BC 02	out_port_img_addr:  .word outport_img
 935           	
