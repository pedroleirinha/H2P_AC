 943           	/************************************************************************************
 944           	 * LIB time
 945           	 ************************************************************************************/
 946           	; Rotina:    time_get_ref
 947           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 948           	; Entradas:  void
 949           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 950           	; Efeitos:   *** Para completar ***
 951           	time_get_ref:
 952 0232 0E 24		PUSH LR
 953           	
 954 0234 18 5C		BL sysclk_get_ticks
 955           	
 956 0236 0F 04		POP PC
 957           	;time_get_ref
 958           	
 959           	; Rotina:    time_elapsed
 960           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 961           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 962           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 963           	; Efeitos:   *** Para completar ***
 964           	time_elapsed:
 965 0238 0E 24		PUSH LR
 966           	
 967 023A 01 B0		MOV R1, R0
 968           	
