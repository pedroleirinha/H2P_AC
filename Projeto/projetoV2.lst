 521           	; >> Função CONVERT_MOLEINPUT_MOLEOUTPUT <<
 522           	; Tipo: - FOLHA -
 523           	; Parametros de entrada:
 524           	;   uint4_t num_ -------> r0
 525           	;
 526           	; variaveis locais:
