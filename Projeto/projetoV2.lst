 462           	
 463           	; Rotina:    detect play
 464           	; Descricao: Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 465           	; Entradas:  -
 466           	; Saidas:    -
 467           	; Efeitos:   
 468           	detect_play:
 469 0164 0E 24		PUSH LR
 470 0166 04 24		PUSH R4
 471           		
 472 0168 2D 5C		BL read_marreta 				; Lê e retorna os 4 bits de menor peso R0
 473 016A F1 60		MOV R1, #0x0F
 474 016C 02 5C		BL falling_edge_v2
 475           	
 476 016E 04 04		POP R4
 477 0170 0F 04		POP PC
 478           	
 479           	;END DETECT_PLAY
 480           	
 481           	
 482           	
 483           	; Entradas:  r0 - valor lido o porto de entrada
 484           	; 			 r1 - Mascara inicial 
 485           	falling_edge_v2:
 486 0172 62 0C		LDR	 r2, last_play_addr
 487 0174 23 08		LDRB r3, [r2]	; VALOR EM MEMORIA
 488           	
 489 0176 20 28		STRB r0, [r2]	; ATUALIZA EM MEMORIA
 490           	
 491 0178 10 B0		MVN R0, R0		; INVERTE OS BITS 
 492 017A 80 C1		AND R0, R0, R3	
 493           	
 494 017C 80 C0		AND R0, R0, R1 ; FILTRA OS 4 BITS menos significativos 
 495 017E 0F B7		MOV PC, LR
 496           	
 497           	last_play_addr:
 498 0180 C9 02		.word	last_play
 499           	
