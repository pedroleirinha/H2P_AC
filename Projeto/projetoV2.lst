 558           	;
 559           	; >> Função convert_moleinput_moleoutput << 
 560           	;	Converte de mascara que representa os hits para indice de posicao para aceder a um array
 561           	;	Realiza shifts à direita consecutivos até a flag Z se encontrar ativa. Obtendo assim o nº da posição.
 562           	; Tipo: - NAO FOLHA -
 563           	; Parametros de entrada:
 564           	;	-
 565           	; variaveis locais:
 566           	;	-
 567           	; Parametros de saida:
 568           	;   R0 -> Devolve o valor da posição a aceder no array
 569           	; 
 570           	convert_moleinput_moleoutput:
 571 0172 01 60		MOV R1, #0
 572           	convert_while:
 573           	
 574 0174 80 E8	    LSR r0, r0, #1          
 575 0176 02 40		BZS convert_end
 576 0178 91 A0	    ADD r1, r1, #1          ; m => contador; m--
 577 017A FC 5B	    B	convert_while
 578           	
 579           	convert_end:
 580 017C 80 B0		MOV R0, R1
 581 017E 0F B7		MOV PC, LR
 582           	; END CONVERT
