 802           	
 803           	/************************************************************************************
 804           	 * LIB time
 805           	 ************************************************************************************/
 806           	; Rotina:    time_get_ref
 807           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 808           	; Entradas:  void
 809           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 810           	; Efeitos:   *** Para completar ***
 811           	time_get_ref:
 812 023E 0E 24		PUSH LR
 813           	
 814 0240 18 5C		BL sysclk_get_ticks
 815           	
 816 0242 0F 04		POP PC
 817           	;time_get_ref
 818           	
 819           	; Rotina:    time_elapsed
 820           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 821           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 822           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 823           	; Efeitos:   *** Para completar ***
 824           	time_elapsed:
 825 0244 0E 24		PUSH LR
 826           	
 827 0246 01 B0		MOV R1, R0
 828           	
 829 0248 14 5C		BL sysclk_get_ticks		; Retorna o valor atual do sysclock
 830           	
 831 024A 80 88		SUB R0, R0, R1			; Calcula a diferença entre o tempo atual (sysclk) e o valor referncia (sysclk antigo)
 832           	
 833 024C 0F 04		POP PC
 834           	;time_elapsed
 835           	
 836           	/************************************************************************************
 837           	 * HAL sys_clk
 838           	 ************************************************************************************/
 839           	; Rotina:    isr
 840           	; Descricao: Incrementa o valor da variável global sysclk.
 841           	; Entradas:  -
 842           	; Saidas:    -
 843           	; Efeitos:   *** Para completar ***
 844           	isr:
 845 024E 0E 24		PUSH	LR
 846 0250 01 24		PUSH	r1
 847 0252 00 24		PUSH	r0
 848           		
 849 0254 26 5C		BL 		ptc_clr_irq
 850           	
 851 0256 00 0D		LDR		r0, SYSCLK_ADDR
 852 0258 01 00		LDR		r1, [r0, #0]
 853 025A 91 A0		ADD		r1, r1, #1
 854 025C 01 20		STR		r1, [r0, #0]
 855 025E 00 04		POP		r0
 856 0260 01 04		POP		r1	
 857 0262 0E 04		POP		LR 
 858           	
 859 0264 20 B0		MOVS	pc, lr
 860           	
 861           	
 862           	; Rotina:    sysclk_init
 863           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 864           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 865           	;            interrupção pendentes e iniciando com o valor zero a variavel
 866           	;            global sysclk.
 867           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 868           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 869           	; Saidas:    -
 870           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 871           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 872           	;            valor zero a variavel global sysclk
 873           	sysclk_init:
 874 0266 0E 24		PUSH	lr
 875 0268 71 0C		LDR		r1, SYSCLK_ADDR
 876 026A 02 60		MOV		r2, #0
 877 026C 12 20		STR 	r2, [r1]
 878 026E 05 5C		BL		ptc_init
 879 0270 0F 04		POP		pc
 880           		
 881           	; Rotina:    sysclk_get_ticks
 882           	; Descricao: Devolve o valor corrente da variável global sysclk.
 883           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 884           	; Entradas:  -
 885           	; Saidas:    *** Para completar ***
 886           	; Efeitos:   -
 887           	sysclk_get_ticks:
 888 0272 20 0C		LDR		r0, SYSCLK_ADDR
 889 0274 00 00		LDR		r0, [r0]
 890 0276 0F B7		MOV		pc, lr
 891           	
 892           	
 893          	.align 1
 894 0278 CA 02	SYSCLK_ADDR: .word	sysclk
 895           	
 896           	
 897           	/************************************************************************************
 898           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 899           	 ************************************************************************************/
 900           	; Rotina:    ptc_init
 901           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 902           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 903           	;            ticks.
 904           	;            Interface exemplo: void ptc_init( uint8_t interval );
 905           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 906           	; Saidas:    -
 907           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 908           	;            o pedido de interrupcao eventualmente pendente.
 909           	ptc_init:
 910 027A 0E 24	    PUSH    lr
 911 027C 00 24		PUSH	r0
 912 027E 0A 5C		BL 		ptc_stop
 913 0280 00 04		POP		r0
 914 0282 21 0D		LDR		r1, PTC_ADDR
 915 0284 10 29		STRB	r0, [r1, #PTC_TMR_ADDRESS]
 916 0286 0D 5C	    BL  	ptc_clr_irq
 917 0288 01 5C		BL 		ptc_start
 918 028A 0F 04		POP pc
 919           	
 920           	
 921           	
 922           	; Rotina:    ptc_start
 923           	; Descricao: Habilita a contagem no periferico pTC.
 924           	;            Interface exemplo: void ptc_start( );
 925           	; Entradas:  -
 926           	; Saidas:    -
 927           	; Efeitos:   -
 928           	ptc_start:
 929 028C D0 0C		LDR		r0, PTC_ADDR
 930 028E 01 60		MOV		r1, #PTC_CMD_START
 931 0290 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 932 0292 0F B7		MOV		pc, lr
 933           	
 934           	; Rotina:    ptc_stop
 935           	; Descricao: Para a contagem no periferico pTC.
 936           	;            Interface exemplo: void ptc_stop( );
 937           	; Entradas:  -
 938           	; Saidas:    -
 939           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 940           	ptc_stop:
 941 0294 90 0C		LDR		r0, PTC_ADDR
 942 0296 11 60		MOV		r1, #PTC_CMD_STOP
 943 0298 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 944 029A 0F B7		MOV		pc, lr
