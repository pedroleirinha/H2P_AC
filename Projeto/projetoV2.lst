  73           	; >> Função GAME SETUP << Rotina que prepeara o inicio do jogo. 
  74           	;	Inicia o PicoTimer, Faz enable ás interrupções, Lê a dificuldade do jogo posta no inputport e 
  75           	;	deteta o primeiro input para iniciar o jogo
  76           	; Tipo: - NAO FOLHA -
  77           	; Parametros de entrada:
  78           	;	-
  79           	; variaveis locais:
  80           	;	R1 -> i (Mascara usada para definir qual o input que estamos a "detetar")
  81           	; Parametros de saida:
  82           	;   VOID
  83           	;
  84           	game_setup_fun:
  85 0016 0E 24		PUSH LR
  86           		
  87 0018 BA 5C		BL game_start_signal 
  88 001A A0 5C		BL start_up_interruptions		; PROCESSO DE INICIALIZAÇÃO DAS INTERRUPÇÕES
  89           	
  90 001C 14 60		MOV R4, #0x01
  91           	detect_cycle:
  92 001E 01 B2		MOV R1, R4
  93 0020 8E 5C		BL detect_play
  94 0022 00 C2		AND R0, R0, R4
  95           		
  96 0024 FC 43		BZS detect_cycle
  97           	game_setup_return:
  98 0026 46 5C		BL read_and_save_game_dificulty ; Lê e grava em memória o tempo selecionado para a ronda
  99           	
 100 0028 0F 04		POP PC
 101           	;; END Game_Setup_Fun
