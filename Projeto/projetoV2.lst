 759           	;; 		PORTS API 		;;
 760           	;; 						;;
 761           	
 762           	; OUTPORT_SET_BITS
 763           	; Introduz os BITS ao valor já no outputport através de uma mascara
 764           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 765           	;
 766           	outport_set_bits:
 767 020A 0E 24	    PUSH LR
 768           	    
 769 020C 61 0D	    LDR r1, out_port_img_addr
 770 020E 11 08	    LDRB r1, [r1]
 771           	
 772 0210 80 C8	    ORR r0, r0, r1
 773           	
 774 0212 08 5C	    BL outport_write
 775           	    
 776 0214 0F 04	    POP PC
 777           	
 778           	; OUTPORT_CLR_BITS
 779           	; Limpa os BITS do valor já no outputport através de uma mascara
 780           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 781           	;
 782           	outport_clr_bits:
 783 0216 0E 24	    PUSH LR
 784           	    
 785 0218 01 0D	    LDR r1, out_port_img_addr
 786 021A 11 08	    LDRB r1, [r1]
 787           	
 788 021C 10 B0	    MVN r0, r0
 789 021E 80 C0	    AND r0, r0, r1
 790           	
 791 0220 01 5C	    BL outport_write
 792           	    
 793 0222 0F 04	    POP PC
 794           	
 795           	
 796           	; Rotina:    outport_write
 797           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 798           	;            Interface exemplo: void outport_write( uint8_t value );
 799           	; Entradas:  r0 - valor a escrever no porto de saida
 800           	; Saidas:    -
 801           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 802           	outport_write:
 803 0224 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 804 0226 F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 805 0228 10 28		STRB r0, [r1, #0]
 806           	
 807           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 808           		; uma mascara
 809           	
 810 022A 71 0C	    LDR r1, out_port_img_addr    
 811 022C 10 28	    STRB r0, [r1, #0]
 812           	
 813 022E 0F B7		MOV	pc, lr
 814           	
 815           	; Rotina:    INPORT_READ
 816           	; Descricao: lê do porto de saida os 8 bits.
 817           	;            Interface exemplo: uint8_t outport_write();
 818           	; Entradas:   - 
 819           	; Saidas:    r0 - valor lido do porto de entrada
 820           	
 821           	inport_read:
 822 0230 20 0C	    LDR r0, input_port_addr
 823 0232 00 08	    LDRB r0, [r0]
 824 0234 0F B7	    MOV pc, lr
 825           	
 826 0236 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 827 0238 C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 828 023A C6 02	out_port_img_addr:  .word outport_img
 829           	
