 491           	;
 492           	; >> Função CONVERT_MOLEINPUT_MOLEOUTPUT <<
 493           	; Tipo: - FOLHA -
 494           	; Parametros de entrada:
 495           	;   uint4_t num_ -------> r0
 496           	;
 497           	; variaveis locais:
 498           	;   uint8_t contador  --> r2
 499           	;
 500           	; Parametros de saida:
 501           	;   uint8_t ---------> r0
 502           	;
 503           	convert_moleinput_moleoutput:
 504 0170 01 60		MOV R1, #0
 505           	convert_while:
 506           	
 507 0172 80 E8	    LSR r0, r0, #1          
 508 0174 02 40		BZS convert_end
 509 0176 91 A0	    ADD r1, r1, #1          ; m => contador; m--
 510 0178 FC 5B	    B	convert_while
 511           	
 512           	convert_end:
 513 017A 80 B0		MOV R0, R1
 514 017C 0F B7		MOV PC, LR
 515           	; END CONVERT
