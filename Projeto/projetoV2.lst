 837           	/************************************************************************************
 838           	 * LIB time
 839           	 ************************************************************************************/
 840           	; Rotina:    time_get_ref
 841           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 842           	; Entradas:  void
 843           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 844           	; Efeitos:   *** Para completar ***
 845           	time_get_ref:
 846 023C 0E 24		PUSH LR
 847           	
 848 023E 18 5C		BL sysclk_get_ticks
 849           	
 850 0240 0F 04		POP PC
 851           	;time_get_ref
 852           	
 853           	; Rotina:    time_elapsed
 854           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 855           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 856           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 857           	; Efeitos:   *** Para completar ***
 858           	time_elapsed:
 859 0242 0E 24		PUSH LR
 860           	
 861 0244 01 B0		MOV R1, R0
 862           	
 863 0246 14 5C		BL sysclk_get_ticks		; Retorna o valor atual do sysclock
 864           	
 865 0248 80 88		SUB R0, R0, R1			; Calcula a diferença entre o tempo atual (sysclk) e o valor referncia (sysclk antigo)
 866           	
 867 024A 0F 04		POP PC
 868           	;time_elapsed
 869           	
 870           	/************************************************************************************
 871           	 * HAL sys_clk
 872           	 ************************************************************************************/
 873           	; Rotina:    isr
 874           	; Descricao: Incrementa o valor da variável global sysclk.
 875           	; Entradas:  -
 876           	; Saidas:    -
 877           	; Efeitos:   *** Para completar ***
 878           	isr:
 879 024C 0E 24		PUSH	LR
 880 024E 01 24		PUSH	r1
 881 0250 00 24		PUSH	r0
 882           		
 883 0252 26 5C		BL 		ptc_clr_irq
 884           	
 885 0254 00 0D		LDR		r0, SYSCLK_ADDR
 886 0256 01 00		LDR		r1, [r0, #0]
 887 0258 91 A0		ADD		r1, r1, #1
 888 025A 01 20		STR		r1, [r0, #0]
 889 025C 00 04		POP		r0
 890 025E 01 04		POP		r1	
 891 0260 0E 04		POP		LR 
 892           	
 893 0262 20 B0		MOVS	pc, lr
 894           	
 895           	
 896           	; Rotina:    sysclk_init
 897           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 898           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 899           	;            interrupção pendentes e iniciando com o valor zero a variavel
 900           	;            global sysclk.
 901           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 902           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 903           	; Saidas:    -
 904           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 905           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 906           	;            valor zero a variavel global sysclk
 907           	sysclk_init:
 908 0264 0E 24		PUSH	lr
 909 0266 71 0C		LDR		r1, SYSCLK_ADDR
 910 0268 02 60		MOV		r2, #0
 911 026A 12 20		STR 	r2, [r1]
 912 026C 05 5C		BL		ptc_init
 913 026E 0F 04		POP		pc
 914           		
 915           	; Rotina:    sysclk_get_ticks
 916           	; Descricao: Devolve o valor corrente da variável global sysclk.
 917           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 918           	; Entradas:  -
 919           	; Saidas:    *** Para completar ***
 920           	; Efeitos:   -
 921           	sysclk_get_ticks:
 922 0270 20 0C		LDR		r0, SYSCLK_ADDR
 923 0272 00 00		LDR		r0, [r0]
 924 0274 0F B7		MOV		pc, lr
 925           	
 926           	
 927          	.align 1
 928 0276 C8 02	SYSCLK_ADDR: .word	sysclk
 929           	
 930           	
 931           	/************************************************************************************
 932           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 933           	 ************************************************************************************/
 934           	; Rotina:    ptc_init
 935           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 936           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 937           	;            ticks.
 938           	;            Interface exemplo: void ptc_init( uint8_t interval );
 939           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 940           	; Saidas:    -
 941           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 942           	;            o pedido de interrupcao eventualmente pendente.
 943           	ptc_init:
 944 0278 0E 24	    PUSH    lr
