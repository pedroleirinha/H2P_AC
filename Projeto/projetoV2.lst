 536 0198 80 E8	    LSR r0, r0, #1          
 537 019A 02 40		BZS convert_end
 538 019C 91 A0	    ADD r1, r1, #1          ; m => contador; m--
 539 019E FC 5B	    B	convert_while
 540           	
 541           	convert_end:
 542 01A0 80 B0		MOV R0, R1
 543 01A2 0F B7		MOV PC, LR
 544           	; END CONVERT
