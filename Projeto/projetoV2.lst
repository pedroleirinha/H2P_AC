1002           	; Rotina:    sysclk_init
1003           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
1004           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
1005           	;            interrupção pendentes e iniciando com o valor zero a variavel
1006           	;            global sysclk.
1007           	;            Interface exemplo: void sysclk_init( uint8_t interval );
1008           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
1009           	; Saidas:    -
1010           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
1011           	;            eventuais pedidos de interrupção pendentes e iniciando com o
1012           	;            valor zero a variavel global sysclk
1013           	sysclk_init:
1014 025A 0E 24		PUSH	lr
1015 025C 71 0C		LDR		r1, SYSCLK_ADDR
1016 025E 02 60		MOV		r2, #0
1017 0260 12 20		STR 	r2, [r1]
1018 0262 05 5C		BL		ptc_init
1019 0264 0F 04		POP		pc
