 745           	; >> Função generate_new_mole << 
 746           	;	Utiliza os 3 bits menos significativos do sysclk para ter um numero aleatorio.
 747           	;	Acedendo a uma posição aleatoria do array de posições já existente
 748           	; Tipo: - FOLHA -
 749           	; Parametros de entrada:
 750           	;	-
 751           	; variaveis locais:
 752           	;	-
 753           	; Parametros de saida:
 754           	;   R0 -> Devolve a posição do array das toupeiras gerada aleatoriamente
 755           	; 
 756           	generate_new_mole:
 757 01C8 0E 24		PUSH LR
 758           	
 759 01CA 4D 5C		BL sysclk_get_ticks		; VAI buscar o valor da variavel sysclk
 760 01CC 71 60		MOV R1, #0x07
 761 01CE 80 C0		AND R0, R0, R1			; Filtra para ficar só com os 2 bits menos significativos __XX
 762           	
 763           	
 764 01D0 0F 04		POP PC
 765           	;END
 766           	
 767           	
 768           	
 769           	;
 770           	; >> Função generate_new_mole << 
 771           	;	Gera uma número aleatorio e devolve uma combinação de toupeiras dependendo do número da ronda
 772           	; Tipo: - FOLHA -
 773           	; Parametros de entrada:
 774           	;	 R0 -> N º da ronda atual
 775           	; variaveis locais:
 776           	;	-
 777           	; Parametros de saida:
 778           	;    R0 -> Mascarada de onde estão posicionadas as toupeiras geradas aleatoriamente
 779           	;				1 Toupeira se: 0 <= N <= 3
 780           	;				2 Toupeira se: 4 <= N <  7
 781           	;
 782           	generate_random_mole:
 783 01D2 0E 24		PUSH LR
 784 01D4 04 24		PUSH R4
 785 01D6 04 B0		MOV R4, R0
 786           	
 787 01D8 F7 5F		BL generate_new_mole 
 788 01DA 41 60		MOV R1, #4
 789 01DC C0 B8		CMP R4, R1		; SE nº de ronda for >= que 3
 790 01DE 02 4C		BLO return_random_mole
 791           	
 792           	two_moles:
 793 01E0 81 60		MOV R1, #0x08
 794 01E2 10 C8		ORR R0, R1, R0
 795           	
 796           	return_random_mole:
 797           	
 798 01E4 A9 5F		BL get_moles_positions_from_array
 799           	
 800 01E6 04 04		POP R4
 801 01E8 0F 04		POP PC
 802           	;END
