 409 011C 00 C2		AND R0, R0, R4					; VALIDA SE O BIT GREEN OBTIDO CORRESPONDE À POSICAO DA TOUPEIRA
 410           	
 411 011E 03 40		BZS mole_hit_return_false
 412           	
 413 0120 80 B2		MOV R0, R5
 414 0122 43 5C		BL turn_mole_red				; APAGA O LED VERDE E ACENDE O RESPETIVO LED VERMERLHO
 415 0124 02 58		B mole_hit_return_true
 416           	
