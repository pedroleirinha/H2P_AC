 274           	start_up_interruptions:
 275 00D8 0E 24		PUSH LR
 276           	
 277 00DA 5A 5C		bl	outport_write		 					; Escreve o zero no output port
 278 00DC 00 60		mov	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 279 00DE F0 7F		movt	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 280 00E0 00 28		strb	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 281           	
 282 00E2 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 283 00E4 01 61		mov	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 284 00E6 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 285 00E8 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 286           	
 287 00EA 0F 04		POP PC
