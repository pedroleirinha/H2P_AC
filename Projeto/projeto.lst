 449 013E F0 6F		MOV R0, #0xFF ; Coloca todos os 8 bits do output a 1, que significa ativar o RED e GREEN simultaneamente
 450           	
 451 0140 1F 5C		BL outport_set_bits
 452           	
 453 0142 0F 04		POP PC
 454           	; END
