 284 00CA 02 58		B show_mole_end
 285           	
 286           	mole_green:
 287 00CC 0C 5C		BL show_mole_green
 288 00CE 00 58		B show_mole_end
 289           	show_mole_end:
 290 00D0 0F 04		POP PC
