 691           	
 692           	; OUTPORT_SET_BITS
 693           	; Introduz os BITS ao valor já no outputport através de uma mascara
 694           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 695           	;
 696           	outport_set_bits:
 697 01F0 0E 24	    PUSH LR
 698           	    
 699 01F2 61 0D	    LDR r1, out_port_img_addr
 700 01F4 11 08	    LDRB r1, [r1]
 701           	
 702 01F6 80 C8	    ORR r0, r0, r1
 703           	
 704 01F8 08 5C	    BL outport_write
 705           	    
 706 01FA 0F 04	    POP PC
 707           	
 708           	; OUTPORT_CLR_BITS
 709           	; Limpa os BITS do valor já no outputport através de uma mascara
 710           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 711           	;
 712           	outport_clr_bits:
 713 01FC 0E 24	    PUSH LR
 714           	    
 715 01FE 01 0D	    LDR r1, out_port_img_addr
 716 0200 11 08	    LDRB r1, [r1]
 717           	
 718 0202 10 B0	    MVN r0, r0
 719 0204 80 C0	    AND r0, r0, r1
 720           	
 721 0206 01 5C	    BL outport_write
 722           	    
 723 0208 0F 04	    POP PC
 724           	
 725           	
 726           	; Rotina:    outport_write
 727           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 728           	;            Interface exemplo: void outport_write( uint8_t value );
 729           	; Entradas:  r0 - valor a escrever no porto de saida
 730           	; Saidas:    -
 731           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 732           	outport_write:
 733 020A 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 734 020C F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 735 020E 10 28		STRB r0, [r1, #0]
 736           	
 737           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 738           		; uma mascara
 739           	
 740 0210 71 0C	    LDR r1, out_port_img_addr    
 741 0212 10 28	    STRB r0, [r1, #0]
 742           	
 743 0214 0F B7		MOV	pc, lr
 744           	
 745           	; Rotina:    INPORT_READ
 746           	; Descricao: lê do porto de saida os 8 bits.
 747           	;            Interface exemplo: uint8_t outport_write();
 748           	; Entradas:   - 
 749           	; Saidas:    r0 - valor lido do porto de entrada
 750           	
 751           	inport_read:
 752 0216 20 0C	    LDR r0, input_port_addr
 753 0218 00 08	    LDRB r0, [r0]
 754 021A 0F B7	    MOV pc, lr
 755           	
 756 021C B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 757 021E C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 758 0220 AC 02	out_port_img_addr:  .word outport_img
 759           	
