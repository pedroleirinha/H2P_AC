 590           	;; 		PORTS API 		;;
 591           	;; 						;;
 592           	
 593           	; OUTPORT_SET_BITS
 594           	; Introduz os BITS ao valor já no outputport através de uma mascara
 595           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 596           	;
 597           	outport_set_bits:
 598 0180 0E 24	    PUSH LR
 599           	    
 600 0182 61 0D	    LDR r1, out_port_img_addr
 601 0184 11 08	    LDRB r1, [r1]
 602           	
 603 0186 80 C8	    ORR r0, r0, r1
 604           	
 605 0188 08 5C	    BL outport_write
 606           	    
 607 018A 0F 04	    POP PC
 608           	
 609           	; OUTPORT_CLR_BITS
 610           	; Limpa os BITS do valor já no outputport através de uma mascara
 611           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 612           	;
 613           	outport_clr_bits:
 614 018C 0E 24	    PUSH LR
 615           	    
 616 018E 01 0D	    LDR r1, out_port_img_addr
 617 0190 11 08	    LDRB r1, [r1]
 618           	
 619 0192 10 B0	    MVN r0, r0
 620 0194 80 C0	    AND r0, r0, r1
 621           	
 622 0196 01 5C	    BL outport_write
 623           	    
 624 0198 0F 04	    POP PC
 625           	
 626           	
 627           	; Rotina:    outport_write
 628           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 629           	;            Interface exemplo: void outport_write( uint8_t value );
 630           	; Entradas:  r0 - valor a escrever no porto de saida
 631           	; Saidas:    -
 632           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 633           	outport_write:
 634 019A 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 635 019C F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 636 019E 10 28		STRB r0, [r1, #0]
 637           	
 638           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 639           		; uma mascara
 640           	
 641 01A0 71 0C	    LDR r1, out_port_img_addr    
 642 01A2 10 28	    STRB r0, [r1, #0]
 643           	
 644 01A4 0F B7		MOV	pc, lr
 645           	
 646           	; Rotina:    INPORT_READ
 647           	; Descricao: lê do porto de saida os 8 bits.
 648           	;            Interface exemplo: uint8_t outport_write();
 649           	; Entradas:   - 
 650           	; Saidas:    r0 - valor lido do porto de entrada
 651           	
 652           	inport_read:
 653 01A6 20 0C	    LDR r0, input_port_addr
 654 01A8 00 08	    LDRB r0, [r0]
 655 01AA 0F B7	    MOV pc, lr
 656           	
 657 01AC B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 658 01AE C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 659 01B0 27 02	out_port_img_addr:  .word outport_img
 660           	
