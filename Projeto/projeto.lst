 196           	;
 197           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 198           	; Tipo: - NÃO FOLHA -
 199           	; Parametros de entrada:
 200           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 201           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 202           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 203           	;
 204           	; variaveis locais:
 205           	;   uint8_t i --> r3
 206           	;
 207           	; Parametros de saida:
 208           	;   uint8_t ---------> r0
 209           	;
 210           	show_mole:
 211 008A 0E 24		PUSH LR
 212           	
 213 008C 13 60		MOV R3, #1
 214 008E A0 B9		CMP R2, R3
 215           	
 216 0090 03 40		BEQ mole_yellow		; SE o R1 for 1, é YELLOW 
 217           	
 218 0092 90 B9		CMP R1, R3			; 
 219           		
 220 0094 03 44		BNE mole_red		; SE o R0 for 0, é RED
 221 0096 04 5C		BL mole_green		; SE o R0 for 1, é GREEN
 222           	
 223           	mole_yellow:
 224 0098 13 5C		BL show_mole_yellow
 225 009A 04 58		B show_mole_end
 226           		
 227           	mole_red:
