 501           	; Rotina:    turn_mole_red
 502           	; Descricao: 
 503           	; Entradas:  R0 -> INDEX da toupeira
 504           	; Saidas:    -
 505           	; Efeitos:   
 506           	turn_mole_red:
 507 015C 0E 24		PUSH LR
 508 015E 04 24		PUSH R4
 509           	
 510 0160 04 B0		MOV R4, R0
 511 0162 E2 5F		BL get_mole_green 
 512           		
 513 0164 16 5C		BL outport_clr_bits			; LIMPA O BIT QUE TORNA O LED VERDE NA TOUPEIRA 
 514           	
 515 0166 00 B2		MOV R0, R4
 516 0168 DC 5F		BL get_mole_red 
 517           	
 518 016A 0D 5C		BL outport_set_bits			; ATIVA O BIT QUE TORNA O LED VERMELHO NA TOUPEIRA 
 519           	
 520 016C 04 04		POP R4
 521 016E 0F 04		POP PC
 522           	;END TURN_MOLE_RED
