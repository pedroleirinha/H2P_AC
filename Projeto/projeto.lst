 448           	
 449           	; Rotina:    detect play
 450           	; Descricao: Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 451           	; Entradas:  -
 452           	; Saidas:    -
 453           	; Efeitos:   
 454           	detect_play:
 455 015A 0E 24		PUSH LR
 456 015C 04 24		PUSH R4
 457           		
 458 015E 2D 5C		BL read_marreta 				; Lê e retorna os 4 bits de menor peso R0
 459 0160 F1 60		MOV R1, #0x0F
 460 0162 02 5C		BL falling_edge_v2
 461           	
 462 0164 04 04		POP R4
 463 0166 0F 04		POP PC
 464           	
 465           	;END DETECT_PLAY
 466           	
 467           	
 468           	
 469           	; Entradas:  r0 - valor lido o porto de entrada
 470           	; 			 r1 - Mascara inicial 
 471           	falling_edge_v2:
 472 0168 62 0C		LDR	 r2, last_play_addr
 473 016A 23 08		LDRB r3, [r2]	; VALOR EM MEMORIA
 474           	
 475 016C 20 28		STRB r0, [r2]	; ATUALIZA EM MEMORIA
 476           	
 477 016E 10 B0		MVN R0, R0		; INVERTE OS BITS 
 478 0170 80 C1		AND R0, R0, R3	
 479           	
 480 0172 80 C0		AND R0, R0, R1 ; FILTRA OS 4 BITS menos significativos 
 481 0174 0F B7		MOV PC, LR
 482           	
 483           	last_play_addr:
 484 0176 AF 02		.word	last_play
 485           	
 486           	
 487           	; START_UP
 488           	; Rotina que inicializa o programa.
 489           	start_up_interruptions:
 490 0178 0E 24		PUSH LR
 491           	
 492 017A 46 5C		BL	outport_write		 					; Escreve o zero no output port
 493 017C 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 494 017E F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 495 0180 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 496           	
 497 0182 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 498 0184 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 499 0186 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 500 0188 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 501           	
 502 018A 0F 04		POP PC
 503           	;END interruption
 504           	
