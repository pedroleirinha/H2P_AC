 547 01A0 31 0C		LDR R1, moles_green_addr
 548 01A2 10 18		LDRB R0, [R1, R0]
 549           	
 550 01A4 0F B7		MOV PC, LR
 551           	
 552           	;END
 553           	
 554           	
 555           	
 556           	
 557 01A6 8C 02	moles_red_addr:  .word moles_red
 558 01A8 90 02	moles_green_addr:  .word moles_green
