 648           	
 649           	; OUTPORT_SET_BITS
 650           	; Introduz os BITS ao valor já no outputport através de uma mascara
 651           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 652           	;
 653           	outport_set_bits:
 654 01C0 0E 24	    PUSH LR
 655           	    
 656 01C2 61 0D	    LDR r1, out_port_img_addr
 657 01C4 11 08	    LDRB r1, [r1]
 658           	
 659 01C6 80 C8	    ORR r0, r0, r1
 660           	
 661 01C8 08 5C	    BL outport_write
 662           	    
 663 01CA 0F 04	    POP PC
 664           	
 665           	; OUTPORT_CLR_BITS
 666           	; Limpa os BITS do valor já no outputport através de uma mascara
 667           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 668           	;
 669           	outport_clr_bits:
 670 01CC 0E 24	    PUSH LR
 671           	    
 672 01CE 01 0D	    LDR r1, out_port_img_addr
 673 01D0 11 08	    LDRB r1, [r1]
 674           	
 675 01D2 10 B0	    MVN r0, r0
 676 01D4 80 C0	    AND r0, r0, r1
 677           	
 678 01D6 01 5C	    BL outport_write
 679           	    
 680 01D8 0F 04	    POP PC
 681           	
 682           	
 683           	; Rotina:    outport_write
 684           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 685           	;            Interface exemplo: void outport_write( uint8_t value );
 686           	; Entradas:  r0 - valor a escrever no porto de saida
 687           	; Saidas:    -
 688           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 689           	outport_write:
 690 01DA 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 691 01DC F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 692 01DE 10 28		STRB r0, [r1, #0]
 693           	
 694           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 695           		; uma mascara
 696           	
 697 01E0 71 0C	    LDR r1, out_port_img_addr    
 698 01E2 10 28	    STRB r0, [r1, #0]
 699           	
 700 01E4 0F B7		MOV	pc, lr
 701           	
 702           	; Rotina:    INPORT_READ
 703           	; Descricao: lê do porto de saida os 8 bits.
 704           	;            Interface exemplo: uint8_t outport_write();
 705           	; Entradas:   - 
 706           	; Saidas:    r0 - valor lido do porto de entrada
 707           	
 708           	inport_read:
 709 01E6 20 0C	    LDR r0, input_port_addr
 710 01E8 00 08	    LDRB r0, [r0]
 711 01EA 0F B7	    MOV pc, lr
 712           	
 713 01EC B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 714 01EE C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 715 01F0 81 02	out_port_img_addr:  .word outport_img
 716           	
