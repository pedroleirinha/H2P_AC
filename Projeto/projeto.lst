 335           	; START_UP
 336           	; Rotina que inicializa o programa.
 337           	start_up_interruptions:
 338 00E4 0E 24		PUSH LR
 339           	
 340 00E6 5C 5C		BL	outport_write		 					; Escreve o zero no output port
 341 00E8 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 342 00EA F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 343 00EC 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 344           	
 345 00EE 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 346 00F0 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 347 00F2 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 348 00F4 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 349           	
 350 00F6 0F 04		POP PC
 351           	;END interruption
