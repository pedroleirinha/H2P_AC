 400 0132 05 B0		MOV R5, R0
 401           	
 402 0134 35 5C		BL get_mole_green 				; VAI BUSCAR A MASCARA QUE REPRESENTA OS LEDS VERDES NO INDEX DA MARRETA
 403 0136 00 C2		AND R0, R0, R4					; VALIDA SE O BIT GREEN OBTIDO CORRESPONDE À POSICAO DA TOUPEIRA
 404           	
 405 0138 03 40		BZS mole_hit_return_false
 406           	
 407 013A 80 B2		MOV R0, R5
 408 013C 43 5C		BL turn_mole_red				; APAGA O LED VERDE E ACENDE O RESPETIVO LED VERMERLHO
 409 013E 02 58		B mole_hit_return_true
 410           	
 411           	mole_hit_return_false:
 412 0140 00 60		MOV R0, #0
 413 0142 01 58		B mole_hit_return
 414           	mole_hit_return_true:
 415 0144 10 60		MOV R0, #1
 416           	
 417           	mole_hit_return:
 418           	
 419 0146 05 04		POP R5
 420 0148 04 04		POP R4
 421 014A 0F 04		POP PC
 422           	; end_is_mole_hit
