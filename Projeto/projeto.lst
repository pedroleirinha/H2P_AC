  90           	; Rotina:    falling_edge
  91           	; Descricao: Retorna booleano indicando se detetou uma transição descendente no bit que controla o modo de funcionamento do sistema;
  92           	; Entradas:  r0 - valor lido o porto de entrada
  93           	; 			 r1 - a mascara do bit
  94           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
  95           	; Efeitos:   
  96           	falling_edge:
  97           	
  98 003A 82 0D		ldr		r2, last_play_addr
  99 003C 22 08		ldrb	r2, [r2]			; R2 = observação anterior do bit que controla o modo de operação
 100 003E 85 C0		AND 	r5, r0, r1 			; Aplica a mascara no valor de entrada
 101           	
 102           		; O bit atual do valor no inputport tem de ser 0 para detetar uma transição descendente 
 103           	
 104 0040 05 44		BNE falling_edge_false
 105           	
 106 0042 12 C1		AND 	r2, r1, r2 			; Aplica a mascara no valor antigo
 107           	
 108 0044 03 40		BZS falling_edge_false
 109           	; TRANSICAO DESCENDENTE
 110 0046 10 60		mov		r0, #1				; retorna true: observação anterior igual a OFF (1) e observação atual igual a ON (0)
 111 0048 0F B7		mov		pc, lr
