 646           	/************************************************************************************
 647           	 * LIB time
 648           	 ************************************************************************************/
 649           	; Rotina:    time_get_ref
 650           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 651           	; Entradas:  void
 652           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 653           	; Efeitos:   *** Para completar ***
 654           	time_get_ref:
 655           		; Completar
 656           	
 657           	; Rotina:    time_elapsed
 658           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 659           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 660           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 661           	; Efeitos:   *** Para completar ***
 662           	time_elapsed:
 663           		; Completar
 664           	
 665           	/************************************************************************************
 666           	 * HAL sys_clk
 667           	 ************************************************************************************/
 668           	; Rotina:    isr
 669           	; Descricao: Incrementa o valor da variável global sysclk.
 670           	; Entradas:  -
 671           	; Saidas:    -
 672           	; Efeitos:   *** Para completar ***
 673           	isr:
 674 01B8 01 24		push	r1
 675 01BA 00 24		push	r0
 676 01BC 00 60		mov	r0, #INT_CS_ADDRESS & 0xFF
 677 01BE F0 7F		movt	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 678 01C0 02 28		strb	r2, [r0, #0]
 679 01C2 F0 0C		ldr	r0, SYSCLK_ADDR
 680 01C4 01 08		ldrb	r1, [r0, #0]
 681 01C6 91 A0		add	r1, r1, #1
 682 01C8 01 28		strb	r1, [r0, #0]
 683 01CA 00 04		pop	r0
 684 01CC 01 04		pop	r1
 685 01CE 20 B0		movs	pc, lr
 686           	
 687           	
 688           	; Rotina:    sysclk_init
 689           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 690           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 691           	;            interrupção pendentes e iniciando com o valor zero a variavel
 692           	;            global sysclk.
 693           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 694           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 695           	; Saidas:    -
 696           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 697           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 698           	;            valor zero a variavel global sysclk
 699           	sysclk_init:
 700 01D0 0E 24		push	lr
 701 01D2 71 0C		ldr		r1, SYSCLK_ADDR
 702 01D4 02 60		mov		r2, #0
 703 01D6 12 20		str 	r2, [r1]
 704 01D8 05 5C		bl		ptc_init
 705 01DA 0F 04		pop		pc
 706           		
 707           	; Rotina:    sysclk_get_ticks
 708           	; Descricao: Devolve o valor corrente da variável global sysclk.
 709           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 710           	; Entradas:  -
 711           	; Saidas:    *** Para completar ***
 712           	; Efeitos:   -
 713           	sysclk_get_ticks:
 714 01DC 20 0C		ldr		r0, SYSCLK_ADDR
 715 01DE 00 00		ldr		r0, [r0]
 716 01E0 0F B7		mov		pc, lr
 717           	
 718           	SYSCLK_ADDR:
 719 01E2 2F 02		.word	sysclk
 720           	
 721           	/************************************************************************************
 722           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 723           	 ************************************************************************************/
 724           	; Rotina:    ptc_init
 725           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 726           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 727           	;            ticks.
 728           	;            Interface exemplo: void ptc_init( uint8_t interval );
 729           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 730           	; Saidas:    -
 731           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 732           	;            o pedido de interrupcao eventualmente pendente.
 733           	ptc_init:
 734 01E4 0E 24	    push    lr
 735 01E6 00 24		push	r0
 736 01E8 0A 5C		bl 		ptc_stop
 737 01EA 00 04		pop		r0
 738 01EC 21 0D		ldr		r1, PTC_ADDR
 739 01EE 90 28		strb	r0, [r1, #PTC_TMR_ADDRESS]
 740 01F0 0D 5C	    bl  	ptc_clr_irq
 741 01F2 01 5C		bl 		ptc_start
 742 01F4 0F 04		pop pc
 743           	
 744           	
 745           	; Rotina:    ptc_start
 746           	; Descricao: Habilita a contagem no periferico pTC.
 747           	;            Interface exemplo: void ptc_start( );
 748           	; Entradas:  -
 749           	; Saidas:    -
 750           	; Efeitos:   -
 751           	ptc_start:
 752 01F6 D0 0C		ldr		r0, PTC_ADDR
 753 01F8 01 60		mov		r1, #PTC_CMD_START
 754 01FA 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 755 01FC 0F B7		mov		pc, lr
 756           	
 757           	; Rotina:    ptc_stop
 758           	; Descricao: Para a contagem no periferico pTC.
 759           	;            Interface exemplo: void ptc_stop( );
 760           	; Entradas:  -
 761           	; Saidas:    -
 762           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 763           	ptc_stop:
 764 01FE 90 0C		ldr		r0, PTC_ADDR
 765 0200 11 60		mov		r1, #PTC_CMD_STOP
 766 0202 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 767 0204 0F B7		mov		pc, lr
 768           	
 769           	; Rotina:    ptc_get_value
 770           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 771           	;            Interface exemplo: uint8_t ptc_get_value( );
 772           	; Entradas:  -
 773           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 774           	; Efeitos:   -
 775           	ptc_get_value:
 776 0206 51 0C		ldr		r1, PTC_ADDR
 777 0208 10 09		ldrb	r0, [r1, #PTC_TC_ADDRESS]
 778 020A 0F B7		mov		pc, lr
 779           	
 780           	; Rotina:    ptc_clr_irq
 781           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 782           	;            interrupção.
 783           	;            Interface exemplo: void ptc_clr_irq( );
 784           	; Entradas:  -
 785           	; Saidas:    -
 786           	; Efeitos:   -
 787           	ptc_clr_irq:
 788 020C 20 0C		ldr		r0, PTC_ADDR
 789 020E 81 29		strb	r1, [r0, #PTC_TIR_ADDRESS]
 790 0210 0F B7		mov		pc, lr
 791           	
 792           	PTC_ADDR:
 793 0212 00 FF		.word	PTC_ADDRESS
