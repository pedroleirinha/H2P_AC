 437           	
 438           	; Rotina:    detect play
 439           	; Descricao: Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 440           	; Entradas:  -
 441           	; Saidas:    -
 442           	; Efeitos:   
 443           	detect_play:
 444 0150 0E 24		PUSH LR
 445 0152 04 24		PUSH R4
 446           		
 447 0154 2D 5C		BL read_marreta 				; Lê e retorna os 4 bits de menor peso R0
 448 0156 F1 60		MOV R1, #0x0F
 449 0158 02 5C		BL falling_edge_v2
 450           	
 451 015A 04 04		POP R4
 452 015C 0F 04		POP PC
 453           	
 454           	;END DETECT_PLAY
 455           	
 456           	
 457           	
 458           	; Entradas:  r0 - valor lido o porto de entrada
 459           	; 			 r1 - Mascara inicial 
 460           	falling_edge_v2:
 461 015E 62 0C		LDR	 r2, last_play_addr
 462 0160 23 08		LDRB r3, [r2]	; VALOR EM MEMORIA
 463           	
 464 0162 20 28		STRB r0, [r2]	; ATUALIZA EM MEMORIA
 465           	
 466 0164 10 B0		MVN R0, R0		; INVERTE OS BITS 
 467 0166 80 C1		AND R0, R0, R3	
 468           	
 469 0168 80 C0		AND R0, R0, R1 ; FILTRA OS 4 BITS menos significativos 
 470 016A 0F B7		MOV PC, LR
 471           	
 472           	last_play_addr:
 473 016C A4 02		.word	last_play
 474           	
 475           	
 476           	; START_UP
 477           	; Rotina que inicializa o programa.
 478           	start_up_interruptions:
 479 016E 0E 24		PUSH LR
 480           	
 481 0170 46 5C		BL	outport_write		 					; Escreve o zero no output port
 482 0172 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 483 0174 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 484 0176 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 485           	
 486 0178 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 487 017A 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 488 017C 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 489 017E 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 490           	
 491 0180 0F 04		POP PC
 492           	;END interruption
