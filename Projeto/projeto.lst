 591           	/************************************************************************************
 592           	 * LIB time
 593           	 ************************************************************************************/
 594           	; Rotina:    time_get_ref
 595           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 596           	; Entradas:  void
 597           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 598           	; Efeitos:   *** Para completar ***
 599           	time_get_ref:
 600           		; Completar
 601           	
 602           	; Rotina:    time_elapsed
 603           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 604           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 605           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 606           	; Efeitos:   *** Para completar ***
 607           	time_elapsed:
 608           		; Completar
 609           	
 610           	/************************************************************************************
 611           	 * HAL sys_clk
 612           	 ************************************************************************************/
 613           	; Rotina:    isr
 614           	; Descricao: Incrementa o valor da variável global sysclk.
 615           	; Entradas:  -
 616           	; Saidas:    -
 617           	; Efeitos:   *** Para completar ***
 618           	isr:
 619 01A8 01 24		push	r1
 620 01AA 00 24		push	r0
 621 01AC 00 60		mov	r0, #INT_CS_ADDRESS & 0xFF
 622 01AE F0 7F		movt	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 623 01B0 02 28		strb	r2, [r0, #0]
 624 01B2 60 0C		ldr	r0, var_addr_isr
 625 01B4 01 08		ldrb	r1, [r0, #0]
 626 01B6 91 A0		add	r1, r1, #1
 627 01B8 01 28		strb	r1, [r0, #0]
 628 01BA 00 04		pop	r0
 629 01BC 01 04		pop	r1
 630 01BE 20 B0		movs	pc, lr
 631           	
 632 01C0 0E 02	var_addr_isr:		.word var
 633           	
 634           	; Rotina:    sysclk_init
 635           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 636           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 637           	;            interrupção pendentes e iniciando com o valor zero a variavel
 638           	;            global sysclk.
 639           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 640           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 641           	; Saidas:    -
 642           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 643           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 644           	;            valor zero a variavel global sysclk
 645           	sysclk_init:
 646 01C2 0E 24		push	lr
 647 01C4 71 0C		ldr		r1, SYSCLK_ADDR
 648 01C6 02 60		mov		r2, #0
 649 01C8 12 20		str 	r2, [r1]
 650 01CA 05 5C		bl		ptc_init
 651 01CC 0F 04		pop		pc
 652           		
 653           	; Rotina:    sysclk_get_ticks
 654           	; Descricao: Devolve o valor corrente da variável global sysclk.
 655           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 656           	; Entradas:  -
 657           	; Saidas:    *** Para completar ***
 658           	; Efeitos:   -
 659           	sysclk_get_ticks:
 660 01CE 20 0C		ldr		r0, SYSCLK_ADDR
 661 01D0 00 00		ldr		r0, [r0]
 662 01D2 0F B7		mov		pc, lr
 663           	
 664           	SYSCLK_ADDR:
 665 01D4 12 02		.word	sysclk
 666           	
 667           	/************************************************************************************
 668           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 669           	 ************************************************************************************/
 670           	; Rotina:    ptc_init
 671           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 672           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 673           	;            ticks.
 674           	;            Interface exemplo: void ptc_init( uint8_t interval );
 675           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 676           	; Saidas:    -
 677           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 678           	;            o pedido de interrupcao eventualmente pendente.
 679           	ptc_init:
 680 01D6 0E 24	    push    lr
 681 01D8 00 24		push	r0
 682 01DA 0A 5C		bl 		ptc_stop
 683 01DC 00 04		pop		r0
 684 01DE 21 0D		ldr		r1, PTC_ADDR
 685 01E0 90 28		strb	r0, [r1, #PTC_TMR_ADDRESS]
 686 01E2 0D 5C	    bl  	ptc_clr_irq
 687 01E4 01 5C		bl 		ptc_start
 688 01E6 0F 04		pop pc
 689           	
 690           	
 691           	; Rotina:    ptc_start
 692           	; Descricao: Habilita a contagem no periferico pTC.
 693           	;            Interface exemplo: void ptc_start( );
 694           	; Entradas:  -
 695           	; Saidas:    -
 696           	; Efeitos:   -
 697           	ptc_start:
 698 01E8 D0 0C		ldr		r0, PTC_ADDR
 699 01EA 11 60		mov		r1, #PTC_CMD_START
 700 01EC 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 701 01EE 0F B7		mov		pc, lr
 702           	
 703           	; Rotina:    ptc_stop
 704           	; Descricao: Para a contagem no periferico pTC.
 705           	;            Interface exemplo: void ptc_stop( );
 706           	; Entradas:  -
 707           	; Saidas:    -
 708           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 709           	ptc_stop:
 710 01F0 90 0C		ldr		r0, PTC_ADDR
 711 01F2 01 60		mov		r1, #PTC_CMD_STOP
 712 01F4 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 713 01F6 0F B7		mov		pc, lr
 714           	
 715           	; Rotina:    ptc_get_value
 716           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 717           	;            Interface exemplo: uint8_t ptc_get_value( );
 718           	; Entradas:  -
 719           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 720           	; Efeitos:   -
 721           	ptc_get_value:
 722 01F8 51 0C		ldr		r1, PTC_ADDR
 723 01FA 10 09		ldrb	r0, [r1, #PTC_TC_ADDRESS]
 724 01FC 0F B7		mov		pc, lr
 725           	
 726           	; Rotina:    ptc_clr_irq
 727           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 728           	;            interrupção.
 729           	;            Interface exemplo: void ptc_clr_irq( );
 730           	; Entradas:  -
 731           	; Saidas:    -
 732           	; Efeitos:   -
 733           	ptc_clr_irq:
 734 01FE 20 0C		ldr		r0, PTC_ADDR
 735 0200 81 29		strb	r1, [r0, #PTC_TIR_ADDRESS]
 736 0202 0F B7		mov		pc, lr
 737           	
 738           	PTC_ADDR:
 739 0204 00 FF		.word	PTC_ADDRESS
 740           	
 741           	
 742           	
 743           	period:
 744 0206 05		.byte 0x05 ; 1s
 745 0207 0A	    .byte 0x0A ; 2s
 746 0208 0F	    .byte 0x0F ; 3s
 747 0209 14	    .byte 0x14 ; 4s
 748 020A 19	    .byte 0x19 ; 5s
 749 020B 1E	    .byte 0x1E ; 6s
 750 020C 23	    .byte 0x23 ; 7s
 751 020D 28	    .byte 0x28 ; 8s
 752           	
