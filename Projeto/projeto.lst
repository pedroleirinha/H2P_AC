 495           	;
 496           	; >> Função CONVERT_MOLEINPUT_MOLEOUTPUT <<
 497           	; Tipo: - FOLHA -
 498           	; Parametros de entrada:
 499           	;   uint4_t num_ -------> r0
 500           	;
 501           	; variaveis locais:
 502           	;   uint8_t contador  --> r2
 503           	;
 504           	; Parametros de saida:
 505           	;   uint8_t ---------> r0
 506           	;
 507           	convert_moleinput_moleoutput:
 508 0182 01 60		MOV R1, #0
 509           	convert_while:
 510           	
 511 0184 80 E8	    LSR r0, r0, #1          
 512 0186 02 40		BZS convert_end
 513 0188 91 A0	    ADD r1, r1, #1          ; m => contador; m--
 514 018A FC 5B	    B	convert_while
 515           	
 516           	convert_end:
 517 018C 80 B0		MOV R0, R1
 518 018E 0F B7		MOV PC, LR
 519           	; END CONVERT
