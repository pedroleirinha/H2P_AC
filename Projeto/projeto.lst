 814           	/************************************************************************************
 815           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 816           	 ************************************************************************************/
 817           	; Rotina:    ptc_init
 818           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 819           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 820           	;            ticks.
 821           	;            Interface exemplo: void ptc_init( uint8_t interval );
 822           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 823           	; Saidas:    -
 824           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 825           	;            o pedido de interrupcao eventualmente pendente.
 826           	ptc_init:
 827 022E 0E 24	    PUSH    lr
 828 0230 00 24		PUSH	r0
 829 0232 0A 5C		BL 		ptc_stop
 830 0234 00 04		POP		r0
 831 0236 21 0D		LDR		r1, PTC_ADDR
 832 0238 10 29		STRB	r0, [r1, #PTC_TMR_ADDRESS]
 833 023A 0D 5C	    BL  	ptc_clr_irq
 834 023C 01 5C		BL 		ptc_start
 835 023E 0F 04		POP pc
 836           	
 837           	
 838           	; Rotina:    ptc_start
 839           	; Descricao: Habilita a contagem no periferico pTC.
 840           	;            Interface exemplo: void ptc_start( );
 841           	; Entradas:  -
 842           	; Saidas:    -
 843           	; Efeitos:   -
 844           	ptc_start:
 845 0240 D0 0C		LDR		r0, PTC_ADDR
 846 0242 01 60		MOV		r1, #PTC_CMD_START
 847 0244 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 848 0246 0F B7		MOV		pc, lr
 849           	
 850           	; Rotina:    ptc_stop
 851           	; Descricao: Para a contagem no periferico pTC.
 852           	;            Interface exemplo: void ptc_stop( );
 853           	; Entradas:  -
 854           	; Saidas:    -
 855           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 856           	ptc_stop:
 857 0248 90 0C		LDR		r0, PTC_ADDR
 858 024A 11 60		MOV		r1, #PTC_CMD_STOP
 859 024C 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 860 024E 0F B7		MOV		pc, lr
 861           	
 862           	; Rotina:    ptc_get_value
 863           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 864           	;            Interface exemplo: uint8_t ptc_get_value( );
 865           	; Entradas:  -
 866           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 867           	; Efeitos:   -
 868           	ptc_get_value:
 869 0250 51 0C		LDR		r1, PTC_ADDR
 870 0252 10 0A		LDRB	r0, [r1, #PTC_TC_ADDRESS]
 871 0254 0F B7		MOV		pc, lr
 872           	
 873           	; Rotina:    ptc_clr_irq
 874           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 875           	;            interrupção.
