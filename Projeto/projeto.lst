 336           	; Rotina:    outport_write
 337           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 338           	;            Interface exemplo: void outport_write( uint8_t value );
 339           	; Entradas:  r0 - valor a escrever no porto de saida
 340           	; Saidas:    -
 341           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 342           	outport_write:
 343 00E2 01 6C		mov	 r1, #OUTPORT_ADDRESS & 0xFF
 344 00E4 F1 7F		movt r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 345 00E6 10 28		strb r0, [r1, #0]
 346           	
 347           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 348           		; uma mascara
 349           	
 350 00E8 71 0C	    ldr r1, out_port_img_addr    
 351 00EA 10 28	    strb r0, [r1, #0]
