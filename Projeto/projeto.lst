 765           	
 766           	/************************************************************************************
 767           	 * LIB time
 768           	 ************************************************************************************/
 769           	; Rotina:    time_get_ref
 770           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 771           	; Entradas:  void
 772           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 773           	; Efeitos:   *** Para completar ***
 774           	time_get_ref:
 775 0220 0E 24		PUSH LR
 776           	
 777 0222 18 5C		BL sysclk_get_ticks
 778           	
 779 0224 0F 04		POP PC
 780           	;time_get_ref
 781           	
 782           	; Rotina:    time_elapsed
 783           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 784           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 785           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 786           	; Efeitos:   *** Para completar ***
 787           	time_elapsed:
 788 0226 0E 24		PUSH LR
 789           	
 790 0228 01 B0		MOV R1, R0
 791           	
 792 022A 14 5C		BL sysclk_get_ticks		; Retorna o valor atual do sysclock
 793           	
 794 022C 80 88		SUB R0, R0, R1			; Calcula a diferença entre o tempo atual (sysclk) e o valor referncia (sysclk antigo)
 795           	
 796 022E 0F 04		POP PC
 797           	;time_elapsed
 798           	
 799           	/************************************************************************************
 800           	 * HAL sys_clk
 801           	 ************************************************************************************/
 802           	; Rotina:    isr
 803           	; Descricao: Incrementa o valor da variável global sysclk.
 804           	; Entradas:  -
 805           	; Saidas:    -
 806           	; Efeitos:   *** Para completar ***
 807           	isr:
 808 0230 0E 24		PUSH	LR
 809 0232 01 24		PUSH	r1
 810 0234 00 24		PUSH	r0
 811           		
 812 0236 26 5C		BL 		ptc_clr_irq
 813           	
 814 0238 00 0D		LDR		r0, SYSCLK_ADDR
 815 023A 01 00		LDR		r1, [r0, #0]
 816 023C 91 A0		ADD		r1, r1, #1
 817 023E 01 20		STR		r1, [r0, #0]
 818 0240 00 04		POP		r0
 819 0242 01 04		POP		r1	
 820 0244 0E 04		POP		LR 
 821           	
 822 0246 20 B0		MOVS	pc, lr
 823           	
 824           	
 825           	; Rotina:    sysclk_init
 826           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 827           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 828           	;            interrupção pendentes e iniciando com o valor zero a variavel
 829           	;            global sysclk.
 830           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 831           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 832           	; Saidas:    -
 833           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 834           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 835           	;            valor zero a variavel global sysclk
 836           	sysclk_init:
 837 0248 0E 24		PUSH	lr
 838 024A 71 0C		LDR		r1, SYSCLK_ADDR
 839 024C 02 60		MOV		r2, #0
 840 024E 12 20		STR 	r2, [r1]
 841 0250 05 5C		BL		ptc_init
 842 0252 0F 04		POP		pc
 843           		
 844           	; Rotina:    sysclk_get_ticks
 845           	; Descricao: Devolve o valor corrente da variável global sysclk.
 846           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 847           	; Entradas:  -
 848           	; Saidas:    *** Para completar ***
 849           	; Efeitos:   -
 850           	sysclk_get_ticks:
 851 0254 20 0C		LDR		r0, SYSCLK_ADDR
 852 0256 00 00		LDR		r0, [r0]
 853 0258 0F B7		MOV		pc, lr
 854           	
 855           	
 856          	.align 1
 857 025A B0 02	SYSCLK_ADDR: .word	sysclk
 858           	
 859           	
 860           	/************************************************************************************
 861           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 862           	 ************************************************************************************/
 863           	; Rotina:    ptc_init
 864           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 865           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 866           	;            ticks.
 867           	;            Interface exemplo: void ptc_init( uint8_t interval );
 868           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 869           	; Saidas:    -
 870           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 871           	;            o pedido de interrupcao eventualmente pendente.
 872           	ptc_init:
 873 025C 0E 24	    PUSH    lr
 874 025E 00 24		PUSH	r0
 875 0260 0A 5C		BL 		ptc_stop
 876 0262 00 04		POP		r0
 877 0264 21 0D		LDR		r1, PTC_ADDR
 878 0266 10 29		STRB	r0, [r1, #PTC_TMR_ADDRESS]
 879 0268 0D 5C	    BL  	ptc_clr_irq
 880 026A 01 5C		BL 		ptc_start
 881 026C 0F 04		POP pc
 882           	
 883           	
 884           	
 885           	; Rotina:    ptc_start
 886           	; Descricao: Habilita a contagem no periferico pTC.
 887           	;            Interface exemplo: void ptc_start( );
 888           	; Entradas:  -
 889           	; Saidas:    -
 890           	; Efeitos:   -
 891           	ptc_start:
 892 026E D0 0C		LDR		r0, PTC_ADDR
 893 0270 01 60		MOV		r1, #PTC_CMD_START
 894 0272 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 895 0274 0F B7		MOV		pc, lr
 896           	
 897           	; Rotina:    ptc_stop
 898           	; Descricao: Para a contagem no periferico pTC.
 899           	;            Interface exemplo: void ptc_stop( );
 900           	; Entradas:  -
 901           	; Saidas:    -
 902           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 903           	ptc_stop:
 904 0276 90 0C		LDR		r0, PTC_ADDR
 905 0278 11 60		MOV		r1, #PTC_CMD_STOP
 906 027A 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 907 027C 0F B7		MOV		pc, lr
 908           	
 909           	; Rotina:    ptc_get_value
 910           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 911           	;            Interface exemplo: uint8_t ptc_get_value( );
 912           	; Entradas:  -
 913           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 914           	; Efeitos:   -
 915           	ptc_get_value:
 916 027E 51 0C		LDR		r1, PTC_ADDR
 917 0280 10 0A		LDRB	r0, [r1, #PTC_TC_ADDRESS]
 918 0282 0F B7		MOV		pc, lr
 919           	
 920           	; Rotina:    ptc_clr_irq
 921           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 922           	;            interrupção.
 923           	;            Interface exemplo: void ptc_clr_irq( );
 924           	; Entradas:  -
 925           	; Saidas:    -
 926           	; Efeitos:   -
 927           	ptc_clr_irq:
 928 0284 20 0C		LDR		r0, PTC_ADDR
 929 0286 01 2B		STRB	r1, [r0, #PTC_TIR_ADDRESS]
 930 0288 0F B7		MOV		pc, lr
 931           	
 932           	PTC_ADDR:
 933 028A 00 FF		.word	PTC_ADDRESS
 934           	
 935           	
 936           	
