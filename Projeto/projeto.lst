 458           	
 459           	; Rotina:    sleep
 460           	; Descricao: Faz um atraso de tempo de #1 em r0 e r1
 461           	; Entradas:  Recebe r0
 462           	; Saidas:    Não têm
 463           	; Efeitos:   Altera os registos R0 e R1
 464           	sleep:
 465 0138 00 C0		and	r0, r0, r0
 466 013A 06 40		beq	sleep_end
 467           	sleep_outer_loop:
 468 013C E1 63		mov	r1, #0x3E
 469 013E 31 70		movt	r1, #0x03
 470           	sleep_inner_loop:
 471 0140 91 A8		sub	r1, r1, #1
 472 0142 FE 47		bne	sleep_inner_loop
 473 0144 80 A8		sub	r0, r0, #1
 474 0146 FA 47		bne	sleep_outer_loop
 475           	sleep_end:
 476 0148 0F B7		mov	pc, lr
