 102           	; Rotina:    falling_edge
 103           	; Descricao: Retorna booleano indicando se detetou uma transição descendente no bit que controla o modo de funcionamento do sistema;
 104           	; Entradas:  r0 - valor lido o porto de entrada
 105           	; 			 r1 - a mascara do bit
 106           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
 107           	; Efeitos:   
 108           	falling_edge:
 109           	
 110 003C 82 0D		ldr		r2, last_play_addr
 111 003E 22 08		ldrb	r2, [r2]			; R2 = observação anterior do bit que controla o modo de operação
 112 0040 85 C0		AND 	r5, r0, r1 			; Aplica a mascara no valor de entrada
 113           	
 114           		; O bit atual do valor no inputport tem de ser 0 para detetar uma transição descendente 
 115           	
 116 0042 05 44		BNE falling_edge_false
 117           	
 118 0044 12 C1		AND 	r2, r1, r2 			; Aplica a mascara no valor antigo
 119           	
 120 0046 03 40		BZS falling_edge_false
 121           	; TRANSICAO DESCENDENTE
 122 0048 10 60		mov		r0, #1				; retorna true: observação anterior igual a OFF (1) e observação atual igual a ON (0)
 123 004A 0F B7		mov		pc, lr
 124           	
 125 004C 03 58		B falling_edge_return
 126           	
 127           	falling_edge_false:
 128           	
 129 004E 75 60		mov 	r5, #FALLING_EDGE_MODE_MSK
 130 0050 80 C2		and		r0, r0, r5			; isola o valor atual do bit modo piscar
 131 0052 10 28		strb	r0, [r1]
 132           	
 133           	
 134           	falling_edge_return:
 135           	
 136 0054 00 60		mov		r0, #0
 137 0056 0F B7		mov		pc, lr
