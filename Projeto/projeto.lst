 724           	/************************************************************************************
 725           	 * LIB time
 726           	 ************************************************************************************/
 727           	; Rotina:    time_get_ref
 728           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 729           	; Entradas:  void
 730           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 731           	; Efeitos:   *** Para completar ***
 732           	time_get_ref:
 733 01F2 0E 04		POP LR
 734           	
 735 01F4 18 5C		BL sysclk_get_ticks
 736           	
 737 01F6 0F 04		POP PC
 738           	;time_get_ref
 739           	
 740           	; Rotina:    time_elapsed
 741           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 742           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 743           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 744           	; Efeitos:   *** Para completar ***
 745           	time_elapsed:
 746 01F8 0E 04		POP LR
 747           	
 748 01FA 01 B0		MOV R1, R0
 749           	
 750 01FC 14 5C		BL sysclk_get_ticks		; Retorna o valor atual do sysclock
 751           	
 752 01FE 10 88		SUB R0, R1, R0			; Calcula a diferença entre o tempo atual (sysclk) e o valor referncia (sysclk antigo)
 753           	
 754 0200 0F 04		POP PC
 755           	;time_elapsed
 756           	
 757           	/************************************************************************************
 758           	 * HAL sys_clk
 759           	 ************************************************************************************/
 760           	; Rotina:    isr
 761           	; Descricao: Incrementa o valor da variável global sysclk.
 762           	; Entradas:  -
 763           	; Saidas:    -
 764           	; Efeitos:   *** Para completar ***
 765           	isr:
 766 0202 01 24		PUSH	r1
 767 0204 00 24		PUSH	r0
 768 0206 00 60		MOV		r0, #INT_CS_ADDRESS & 0xFF
 769 0208 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 770 020A 02 28		STRB	r2, [r0, #0]
 771 020C F0 0C		LDR		r0, SYSCLK_ADDR
 772 020E 01 08		LDRB	r1, [r0, #0]
 773 0210 91 A0		ADD		r1, r1, #1
 774 0212 01 28		STRB	r1, [r0, #0]
 775 0214 00 04		POP		r0
 776 0216 01 04		POP		r1	
 777 0218 20 B0		MOVS	pc, lr
 778           	
 779           	
 780           	; Rotina:    sysclk_init
 781           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 782           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 783           	;            interrupção pendentes e iniciando com o valor zero a variavel
 784           	;            global sysclk.
 785           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 786           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 787           	; Saidas:    -
 788           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 789           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 790           	;            valor zero a variavel global sysclk
 791           	sysclk_init:
 792 021A 0E 24		PUSH	lr
 793 021C 71 0C		LDR		r1, SYSCLK_ADDR
 794 021E 02 60		MOV		r2, #0
 795 0220 12 20		STR 	r2, [r1]
 796 0222 05 5C		BL		ptc_init
 797 0224 0F 04		POP		pc
 798           		
 799           	; Rotina:    sysclk_get_ticks
 800           	; Descricao: Devolve o valor corrente da variável global sysclk.
 801           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 802           	; Entradas:  -
 803           	; Saidas:    *** Para completar ***
 804           	; Efeitos:   -
 805           	sysclk_get_ticks:
 806 0226 20 0C		LDR		r0, SYSCLK_ADDR
 807 0228 00 00		LDR		r0, [r0]
 808 022A 0F B7		MOV		pc, lr
 809           	
 810           	SYSCLK_ADDR:
 811 022C 83 02		.word	sysclk
 812           	
