 400 0132 2D 5C		BL convert_moleinput_moleoutput	; FICA EM R0 o index da marretada detetada
 401 0134 05 B0		MOV R5, R0
 402           	
 403 0136 35 5C		BL get_mole_green 				; VAI BUSCAR A MASCARA QUE REPRESENTA OS LEDS VERDES NO INDEX DA MARRETA
 404 0138 00 C2		AND R0, R0, R4					; VALIDA SE O BIT GREEN OBTIDO CORRESPONDE À POSICAO DA TOUPEIRA
 405           	
 406 013A 03 40		BZS mole_hit_return_false
 407           	
 408 013C 80 B2		MOV R0, R5
 409 013E 43 5C		BL turn_mole_red				; APAGA O LED VERDE E ACENDE O RESPETIVO LED VERMERLHO
 410 0140 02 58		B mole_hit_return_true
 411           	
 412           	mole_hit_return_false:
 413 0142 00 60		MOV R0, #0
 414 0144 01 58		B mole_hit_return
 415           	mole_hit_return_true:
 416 0146 10 60		MOV R0, #1
 417           	
 418           	mole_hit_return:
 419           	
 420 0148 05 04		POP R5
 421 014A 04 04		POP R4
 422 014C 0F 04		POP PC
 423           	; end_is_mole_hit
