 271           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 272           	; Tipo: - NÃO FOLHA -
 273           	; Parametros de entrada:
 274           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 275           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 276           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 277           	;
 278           	; variaveis locais:
 279           	;   uint8_t i --> r3
 280           	;
 281           	; Parametros de saida:
 282           	;   uint8_t ---------> r0
 283           	;
 284           	show_mole:
 285 00B2 0E 24		PUSH LR
 286           	
 287 00B4 13 60		MOV R3, #1
 288 00B6 A0 B9		CMP R2, R3
 289           	
 290 00B8 03 40		BEQ mole_yellow		; SE o R1 for 1, é YELLOW 
 291           	
 292 00BA 90 B9		CMP R1, R3			; 
 293           		
 294 00BC 03 44		BNE mole_red		; SE o R0 for 0, é RED
 295 00BE 04 5C		BL mole_green		; SE o R0 for 1, é GREEN
 296           	
 297           	mole_yellow:
 298 00C0 13 5C		BL show_mole_yellow
 299 00C2 04 58		B show_mole_end
 300           		
 301           	mole_red:
 302 00C4 0C 5C		BL show_mole_red
 303 00C6 02 58		B show_mole_end
 304           	
 305           	mole_green:
 306 00C8 0C 5C		BL show_mole_green
 307 00CA 00 58		B show_mole_end
 308           	show_mole_end:
 309 00CC 0F 04		POP PC
 310           	
 311           	
