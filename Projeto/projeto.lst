 330           	; START_UP
 331           	; Rotina que inicializa o programa.
 332           	start_up_interruptions:
 333 00DE 0E 24		PUSH LR
 334           	
 335 00E0 5C 5C		BL	outport_write		 					; Escreve o zero no output port
 336 00E2 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 337 00E4 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 338 00E6 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 339           	
 340 00E8 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 341 00EA 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 342 00EC 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 343 00EE 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 344           	
 345 00F0 0F 04		POP PC
 346           	;END interruption
