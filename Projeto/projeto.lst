 259 00AC 03 48	    BHS	convert_end 
 260           	    
 261 00AE 80 E0	    LSL r0, r0, #1          
 262 00B0 91 A8	    SUB	r1, r1, #1          ; m => contador; m--
 263 00B2 FB 5B	    B	convert_while
