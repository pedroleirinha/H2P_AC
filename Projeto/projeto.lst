 231           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 232           	; Tipo: - NÃO FOLHA -
 233           	; Parametros de entrada:
 234           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 235           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 236           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 237           	;
 238           	; variaveis locais:
 239           	;   uint8_t i --> r3
 240           	;
 241           	; Parametros de saida:
 242           	;   uint8_t ---------> r0
 243           	;
 244           	show_mole:
 245 009A 0E 24		PUSH LR
 246           	
 247 009C 13 60		MOV R3, #1
 248 009E A0 B9		CMP R2, R3
 249           	
 250 00A0 03 40		BEQ mole_yellow		; SE o R1 for 1, é YELLOW 
 251           	
 252 00A2 90 B9		CMP R1, R3			; 
 253           		
 254 00A4 03 44		BNE mole_red		; SE o R0 for 0, é RED
 255 00A6 04 5C		BL mole_green		; SE o R0 for 1, é GREEN
 256           	
