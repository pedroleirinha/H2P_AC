 350           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 351           	; Tipo: - NÃO FOLHA -
 352           	; Parametros de entrada:
 353           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 354           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 355           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 356           	;
 357           	; variaveis locais:
 358           	;   uint8_t i --> r3
 359           	;
 360           	; Parametros de saida:
 361           	;   uint8_t ---------> r0
 362           	;
 363           	show_mole:
 364 0118 0E 24		PUSH LR
 365           	
 366 011A 13 60		MOV R3, #1
 367 011C A0 B9		CMP R2, R3
 368           	
 369 011E 03 40		BEQ mole_yellow		; SE o R1 for 1, é YELLOW 
 370           	
 371 0120 90 B9		CMP R1, R3			; 
 372           		
 373 0122 03 44		BNE mole_red		; SE o R0 for 0, é RED
 374 0124 04 5C		BL mole_green		; SE o R0 for 1, é GREEN
 375           	
 376           	mole_yellow:
 377 0126 15 5C		BL show_mole_yellow
 378 0128 04 58		B show_mole_end
 379           		
