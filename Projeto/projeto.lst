 690           	
 691           	; OUTPORT_SET_BITS
 692           	; Introduz os BITS ao valor já no outputport através de uma mascara
 693           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 694           	;
 695           	outport_set_bits:
 696 01EE 0E 24	    PUSH LR
 697           	    
 698 01F0 61 0D	    LDR r1, out_port_img_addr
 699 01F2 11 08	    LDRB r1, [r1]
 700           	
 701 01F4 80 C8	    ORR r0, r0, r1
 702           	
 703 01F6 08 5C	    BL outport_write
 704           	    
 705 01F8 0F 04	    POP PC
 706           	
 707           	; OUTPORT_CLR_BITS
 708           	; Limpa os BITS do valor já no outputport através de uma mascara
 709           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 710           	;
 711           	outport_clr_bits:
 712 01FA 0E 24	    PUSH LR
 713           	    
 714 01FC 01 0D	    LDR r1, out_port_img_addr
 715 01FE 11 08	    LDRB r1, [r1]
 716           	
 717 0200 10 B0	    MVN r0, r0
 718 0202 80 C0	    AND r0, r0, r1
 719           	
 720 0204 01 5C	    BL outport_write
 721           	    
 722 0206 0F 04	    POP PC
 723           	
 724           	
 725           	; Rotina:    outport_write
 726           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 727           	;            Interface exemplo: void outport_write( uint8_t value );
 728           	; Entradas:  r0 - valor a escrever no porto de saida
 729           	; Saidas:    -
 730           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 731           	outport_write:
 732 0208 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 733 020A F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 734 020C 10 28		STRB r0, [r1, #0]
 735           	
 736           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 737           		; uma mascara
 738           	
 739 020E 71 0C	    LDR r1, out_port_img_addr    
 740 0210 10 28	    STRB r0, [r1, #0]
 741           	
 742 0212 0F B7		MOV	pc, lr
 743           	
 744           	; Rotina:    INPORT_READ
 745           	; Descricao: lê do porto de saida os 8 bits.
 746           	;            Interface exemplo: uint8_t outport_write();
 747           	; Entradas:   - 
 748           	; Saidas:    r0 - valor lido do porto de entrada
 749           	
 750           	inport_read:
 751 0214 20 0C	    LDR r0, input_port_addr
 752 0216 00 08	    LDRB r0, [r0]
 753 0218 0F B7	    MOV pc, lr
 754           	
 755 021A B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 756 021C C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 757 021E AE 02	out_port_img_addr:  .word outport_img
 758           	
