 507           	;
 508           	; >> Função CONVERT_MOLEINPUT_MOLEOUTPUT <<
 509           	; Tipo: - FOLHA -
 510           	; Parametros de entrada:
 511           	;   uint4_t num_ -------> r0
 512           	;
 513           	; variaveis locais:
 514           	;   uint8_t contador  --> r2
 515           	;
 516           	; Parametros de saida:
 517           	;   uint8_t ---------> r0
 518           	;
 519           	convert_moleinput_moleoutput:
 520 018E 01 60		MOV R1, #0
 521           	convert_while:
 522           	
 523 0190 80 E8	    LSR r0, r0, #1          
 524 0192 02 40		BZS convert_end
 525 0194 91 A0	    ADD r1, r1, #1          ; m => contador; m--
 526 0196 FC 5B	    B	convert_while
 527           	
 528           	convert_end:
 529 0198 80 B0		MOV R0, R1
 530 019A 0F B7		MOV PC, LR
 531           	; END CONVERT
