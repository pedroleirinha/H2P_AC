 123           	; Rotina:    falling_edge_all_bits
 124           	; Descricao: Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 125           	; Entradas:  r0 - valor lido o porto de entrada
 126           	; 			 r1 - Mascara inicial que será shiftada até chegar ao zero (Verifica todos os bits de uma trama)
 127           	; 			 r2 - valor antigo a comparar
 128           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
 129           	; Efeitos:   
 130           	falling_edge_all_bits:
 131 0048 0E 24		PUSH LR
 132 004A 04 24		PUSH R4
 133 004C 05 24		PUSH R5
 134 004E 06 24		PUSH R6
 135           	
 136 0050 04 B0		MOV R4, R0
 137 0052 85 B0		MOV R5, R1
 138 0054 06 B1		MOV R6, R2
 139           		
 140           	check_cycle:
 141 0056 00 B2		MOV R0, R4	; Carrega o valor lido do porto para o R0
 142 0058 81 B2		MOV R1, R5	; Carrega a mascara a utilizar na verificacao do fallingedge no R1	
 143 005A 02 B3		MOV R2, R6	; Carrega a ultima observação lida do porto para o R2
 144 005C 0A 5C		BL falling_edge  				; RETORNA TRUE (1) OU FALSE (0)
 145 005E 13 60		MOV R3, #1	
 146 0060 80 B9		CMP R0, R3
 147 0062 03 40		BZS return_falling_edge_all			; SE RETORNO DO FALLING EDGE É IGUAL A 1 => (R2)
 148           	
 149 0064 D5 E8		LSR R5, R5, #1					; FAZ O SHIFT da mascara [1000] em R1 um bit para a direita
 150 0066 01 40		BZS return_falling_edge_all
 151           	
 152 0068 F6 5B		B check_cycle
 153           	
 154           	return_falling_edge_all:
 155 006A 06 04		POP R6
 156 006C 05 04		POP R5
 157 006E 04 04		POP R4
 158 0070 0F 04		POP PC
 159           	;END falling_edge_all_bits
 160           	
 161           	; Rotina:    falling_edge
 162           	; Descricao: Retorna booleano indicando se detetou uma transição descendente no bit que controla o modo de funcionamento do sistema;
 163           	; Entradas:  r0 - valor lido o porto de entrada
 164           	; 			 r1 - a mascara do bit
 165           	;			 r2 - valor em memória
 166           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
 167           	; Efeitos:   
 168           	falling_edge:
 169 0072 04 24		PUSH R4
 170 0074 05 24		PUSH R5
 171           	
 172 0076 84 C0		AND	r4, r0, r1 			; Aplica a mascara no valor de entrada. VERIFICA SE O VALOR ATUAL DO BIT É 0
 173           		; O bit atual do valor no inputport tem de ser 0 para detetar uma transição descendente 
 174           	
 175 0078 04 44		BNE falling_edge_false	
 176           	
 177 007A 14 C1		AND r4, r1, r2 			; Aplica a mascara no valor antigo. VERIFICA SE O VALOR ANTIGO DO BIT É 1
 178           	
 179 007C 02 40		BZS falling_edge_false
 180           	
 181           		; TRANSICAO DESCENDENTE
 182 007E 10 60		mov		r0, #1				; retorna true: observação anterior igual a OFF (1) e observação atual igual a ON (0)
 183 0080 01 58		B  falling_edge_return
 184           	
 185           	falling_edge_false:
 186 0082 00 60		mov		r0, #0
 187           	
 188           	falling_edge_return:
 189           		
 190 0084 05 04		POP R5
 191 0086 04 04		POP R4
 192           	
 193 0088 0F B7		mov		pc, lr
