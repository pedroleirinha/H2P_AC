 617           	/************************************************************************************
 618           	 * HAL sys_clk
 619           	 ************************************************************************************/
 620           	; Rotina:    isr
 621           	; Descricao: Incrementa o valor da variável global sysclk.
 622           	; Entradas:  -
 623           	; Saidas:    -
 624           	; Efeitos:   *** Para completar ***
 625           	isr:
 626 018A 01 24		push	r1
 627 018C 00 24		push	r0
 628 018E 00 60		mov	r0, #INT_CS_ADDRESS & 0xFF
 629 0190 F0 7F		movt	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 630 0192 02 28		strb	r2, [r0, #0]
 631 0194 F0 0C		ldr	r0, SYSCLK_ADDR
 632 0196 01 08		ldrb	r1, [r0, #0]
 633 0198 91 A0		add	r1, r1, #1
 634 019A 01 28		strb	r1, [r0, #0]
 635 019C 00 04		pop	r0
 636 019E 01 04		pop	r1
 637 01A0 20 B0		movs	pc, lr
 638           	
 639           	
 640           	; Rotina:    sysclk_init
 641           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 642           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 643           	;            interrupção pendentes e iniciando com o valor zero a variavel
 644           	;            global sysclk.
 645           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 646           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 647           	; Saidas:    -
 648           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 649           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 650           	;            valor zero a variavel global sysclk
 651           	sysclk_init:
 652 01A2 0E 24		push	lr
 653 01A4 71 0C		ldr		r1, SYSCLK_ADDR
 654 01A6 02 60		mov		r2, #0
 655 01A8 12 20		str 	r2, [r1]
 656 01AA 05 5C		bl		ptc_init
 657 01AC 0F 04		pop		pc
 658           		
 659           	; Rotina:    sysclk_get_ticks
 660           	; Descricao: Devolve o valor corrente da variável global sysclk.
 661           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 662           	; Entradas:  -
 663           	; Saidas:    *** Para completar ***
 664           	; Efeitos:   -
 665           	sysclk_get_ticks:
 666 01AE 20 0C		ldr		r0, SYSCLK_ADDR
 667 01B0 00 00		ldr		r0, [r0]
 668 01B2 0F B7		mov		pc, lr
 669           	
 670           	SYSCLK_ADDR:
 671 01B4 FD 01		.word	sysclk
 672           	
 673           	/************************************************************************************
 674           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 675           	 ************************************************************************************/
 676           	; Rotina:    ptc_init
 677           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 678           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 679           	;            ticks.
 680           	;            Interface exemplo: void ptc_init( uint8_t interval );
 681           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 682           	; Saidas:    -
 683           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 684           	;            o pedido de interrupcao eventualmente pendente.
 685           	ptc_init:
 686 01B6 0E 24	    push    lr
 687 01B8 00 24		push	r0
 688 01BA 0A 5C		bl 		ptc_stop
 689 01BC 00 04		pop		r0
 690 01BE 21 0D		ldr		r1, PTC_ADDR
 691 01C0 90 28		strb	r0, [r1, #PTC_TMR_ADDRESS]
 692 01C2 0D 5C	    bl  	ptc_clr_irq
 693 01C4 01 5C		bl 		ptc_start
 694 01C6 0F 04		pop pc
 695           	
 696           	
 697           	; Rotina:    ptc_start
 698           	; Descricao: Habilita a contagem no periferico pTC.
 699           	;            Interface exemplo: void ptc_start( );
 700           	; Entradas:  -
 701           	; Saidas:    -
 702           	; Efeitos:   -
 703           	ptc_start:
 704 01C8 D0 0C		ldr		r0, PTC_ADDR
 705 01CA 11 60		mov		r1, #PTC_CMD_START
 706 01CC 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 707 01CE 0F B7		mov		pc, lr
 708           	
 709           	; Rotina:    ptc_stop
 710           	; Descricao: Para a contagem no periferico pTC.
 711           	;            Interface exemplo: void ptc_stop( );
 712           	; Entradas:  -
 713           	; Saidas:    -
 714           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 715           	ptc_stop:
 716 01D0 90 0C		ldr		r0, PTC_ADDR
 717 01D2 01 60		mov		r1, #PTC_CMD_STOP
 718 01D4 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 719 01D6 0F B7		mov		pc, lr
 720           	
 721           	; Rotina:    ptc_get_value
 722           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 723           	;            Interface exemplo: uint8_t ptc_get_value( );
 724           	; Entradas:  -
 725           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 726           	; Efeitos:   -
 727           	ptc_get_value:
 728 01D8 51 0C		ldr		r1, PTC_ADDR
 729 01DA 10 09		ldrb	r0, [r1, #PTC_TC_ADDRESS]
 730 01DC 0F B7		mov		pc, lr
 731           	
 732           	; Rotina:    ptc_clr_irq
 733           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 734           	;            interrupção.
 735           	;            Interface exemplo: void ptc_clr_irq( );
 736           	; Entradas:  -
 737           	; Saidas:    -
 738           	; Efeitos:   -
 739           	ptc_clr_irq:
 740 01DE 20 0C		ldr		r0, PTC_ADDR
 741 01E0 81 29		strb	r1, [r0, #PTC_TIR_ADDRESS]
 742 01E2 0F B7		mov		pc, lr
 743           	
