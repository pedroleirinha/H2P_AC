 498           	; Rotina:    turn_mole_red
 499           	; Descricao: 
 500           	; Entradas:  R0 -> INDEX da toupeira
 501           	; Saidas:    -
 502           	; Efeitos:   
 503           	turn_mole_red:
 504 0156 0E 24		PUSH LR
 505 0158 04 24		PUSH R4
 506           	
 507 015A 04 B0		MOV R4, R0
 508 015C E2 5F		BL get_mole_green 
 509           		
 510 015E 16 5C		BL outport_clr_bits			; LIMPA O BIT QUE TORNA O LED VERDE NA TOUPEIRA 
 511           	
 512 0160 00 B2		MOV R0, R4
 513 0162 DC 5F		BL get_mole_red 
 514           	
 515 0164 0D 5C		BL outport_set_bits			; ATIVA O BIT QUE TORNA O LED VERMELHO NA TOUPEIRA 
 516           	
 517 0166 04 04		POP R4
 518 0168 0F 04		POP PC
 519           	;END TURN_MOLE_RED
