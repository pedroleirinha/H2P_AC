 598           	; OUTPORT_SET_BITS
 599           	; Introduz os BITS ao valor já no outputport através de uma mascara
 600           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 601           	;
 602           	outport_set_bits:
 603 0186 0E 24	    PUSH LR
 604           	    
 605 0188 61 0D	    LDR r1, out_port_img_addr
 606 018A 11 08	    LDRB r1, [r1]
 607           	
 608 018C 80 C8	    ORR r0, r0, r1
 609           	
 610 018E 08 5C	    BL outport_write
 611           	    
 612 0190 0F 04	    POP PC
 613           	
 614           	; OUTPORT_CLR_BITS
 615           	; Limpa os BITS do valor já no outputport através de uma mascara
 616           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 617           	;
 618           	outport_clr_bits:
 619 0192 0E 24	    PUSH LR
 620           	    
 621 0194 01 0D	    LDR r1, out_port_img_addr
 622 0196 11 08	    LDRB r1, [r1]
 623           	
 624 0198 10 B0	    MVN r0, r0
 625 019A 80 C0	    AND r0, r0, r1
 626           	
 627 019C 01 5C	    BL outport_write
 628           	    
 629 019E 0F 04	    POP PC
 630           	
 631           	
 632           	; Rotina:    outport_write
 633           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 634           	;            Interface exemplo: void outport_write( uint8_t value );
 635           	; Entradas:  r0 - valor a escrever no porto de saida
 636           	; Saidas:    -
 637           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 638           	outport_write:
 639 01A0 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 640 01A2 F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 641 01A4 10 28		STRB r0, [r1, #0]
 642           	
 643           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 644           		; uma mascara
 645           	
 646 01A6 71 0C	    LDR r1, out_port_img_addr    
 647 01A8 10 28	    STRB r0, [r1, #0]
 648           	
 649 01AA 0F B7		MOV	pc, lr
 650           	
 651           	; Rotina:    INPORT_READ
 652           	; Descricao: lê do porto de saida os 8 bits.
 653           	;            Interface exemplo: uint8_t outport_write();
 654           	; Entradas:   - 
 655           	; Saidas:    r0 - valor lido do porto de entrada
 656           	
 657           	inport_read:
 658 01AC 20 0C	    LDR r0, input_port_addr
 659 01AE 00 08	    LDRB r0, [r0]
 660 01B0 0F B7	    MOV pc, lr
 661           	
 662 01B2 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 663 01B4 C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 664 01B6 2D 02	out_port_img_addr:  .word outport_img
 665           	
