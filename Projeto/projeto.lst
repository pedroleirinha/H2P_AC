 558           	; Descricao: Devolve o valor corrente da variável global sysclk.
 559           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 560           	; Entradas:  -
 561           	; Saidas:    *** Para completar ***
 562           	; Efeitos:   -
 563           	sysclk_get_ticks:
 564 0172 20 0C		ldr		r0, SYSCLK_ADDR
 565 0174 00 00		ldr		r0, [r0]
 566 0176 0F B7		mov		pc, lr
 567           	
 568           	SYSCLK_ADDR:
 569 0178 B6 01		.word	sysclk
 570           	
 571           	/************************************************************************************
 572           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 573           	 ************************************************************************************/
 574           	; Rotina:    ptc_init
 575           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 576           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 577           	;            ticks.
 578           	;            Interface exemplo: void ptc_init( uint8_t interval );
 579           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 580           	; Saidas:    -
 581           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 582           	;            o pedido de interrupcao eventualmente pendente.
 583           	ptc_init:
 584 017A 0E 24	    push    lr
 585 017C 00 24		push	r0
 586 017E 0A 5C		bl 		ptc_stop
 587 0180 00 04		pop		r0
 588 0182 21 0D		ldr		r1, PTC_ADDR
 589 0184 90 28		strb	r0, [r1, #PTC_TMR_ADDRESS]
 590 0186 0D 5C	    bl  	ptc_clr_irq
 591 0188 01 5C		bl 		ptc_start
 592 018A 0F 04		pop pc
 593           	
 594           	
 595           	; Rotina:    ptc_start
 596           	; Descricao: Habilita a contagem no periferico pTC.
 597           	;            Interface exemplo: void ptc_start( );
 598           	; Entradas:  -
 599           	; Saidas:    -
 600           	; Efeitos:   -
 601           	ptc_start:
 602 018C D0 0C		ldr		r0, PTC_ADDR
 603 018E 11 60		mov		r1, #PTC_CMD_START
 604 0190 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 605 0192 0F B7		mov		pc, lr
 606           	
 607           	; Rotina:    ptc_stop
 608           	; Descricao: Para a contagem no periferico pTC.
 609           	;            Interface exemplo: void ptc_stop( );
 610           	; Entradas:  -
 611           	; Saidas:    -
 612           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 613           	ptc_stop:
 614 0194 90 0C		ldr		r0, PTC_ADDR
 615 0196 01 60		mov		r1, #PTC_CMD_STOP
 616 0198 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 617 019A 0F B7		mov		pc, lr
 618           	
 619           	; Rotina:    ptc_get_value
 620           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 621           	;            Interface exemplo: uint8_t ptc_get_value( );
 622           	; Entradas:  -
 623           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 624           	; Efeitos:   -
 625           	ptc_get_value:
 626 019C 51 0C		ldr		r1, PTC_ADDR
 627 019E 10 09		ldrb	r0, [r1, #PTC_TC_ADDRESS]
 628 01A0 0F B7		mov		pc, lr
 629           	
 630           	; Rotina:    ptc_clr_irq
 631           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 632           	;            interrupção.
 633           	;            Interface exemplo: void ptc_clr_irq( );
 634           	; Entradas:  -
 635           	; Saidas:    -
 636           	; Efeitos:   -
 637           	ptc_clr_irq:
 638 01A2 20 0C		ldr		r0, PTC_ADDR
 639 01A4 81 29		strb	r1, [r0, #PTC_TIR_ADDRESS]
 640 01A6 0F B7		mov		pc, lr
