 671           	; Rotina:    time_get_ref
 672           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 673           	; Entradas:  void
 674           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 675           	; Efeitos:   *** Para completar ***
 676           	time_get_ref:
 677           		; Completar
 678           	
 679           	; Rotina:    time_elapsed
 680           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 681           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 682           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 683           	; Efeitos:   *** Para completar ***
 684           	time_elapsed:
 685           		; Completar
