 538 0154 20 0C		ldr		r0, SYSCLK_ADDR
 539 0156 00 00		ldr		r0, [r0]
 540 0158 0F B7		mov		pc, lr
 541           	
 542           	SYSCLK_ADDR:
 543 015A 98 01		.word	sysclk
 544           	
 545           	/************************************************************************************
 546           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 547           	 ************************************************************************************/
 548           	; Rotina:    ptc_init
 549           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 550           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 551           	;            ticks.
 552           	;            Interface exemplo: void ptc_init( uint8_t interval );
 553           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 554           	; Saidas:    -
 555           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 556           	;            o pedido de interrupcao eventualmente pendente.
 557           	ptc_init:
 558 015C 0E 24	    push    lr
 559 015E 00 24		push	r0
 560 0160 0A 5C		bl 		ptc_stop
 561 0162 00 04		pop		r0
 562 0164 21 0D		ldr		r1, PTC_ADDR
 563 0166 90 28		strb	r0, [r1, #PTC_TMR_ADDRESS]
 564 0168 0D 5C	    bl  	ptc_clr_irq
 565 016A 01 5C		bl 		ptc_start
 566 016C 0F 04		pop pc
 567           	
 568           	
 569           	; Rotina:    ptc_start
 570           	; Descricao: Habilita a contagem no periferico pTC.
 571           	;            Interface exemplo: void ptc_start( );
 572           	; Entradas:  -
 573           	; Saidas:    -
 574           	; Efeitos:   -
 575           	ptc_start:
 576 016E D0 0C		ldr		r0, PTC_ADDR
 577 0170 11 60		mov		r1, #PTC_CMD_START
 578 0172 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 579 0174 0F B7		mov		pc, lr
 580           	
 581           	; Rotina:    ptc_stop
 582           	; Descricao: Para a contagem no periferico pTC.
 583           	;            Interface exemplo: void ptc_stop( );
 584           	; Entradas:  -
 585           	; Saidas:    -
 586           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 587           	ptc_stop:
 588 0176 90 0C		ldr		r0, PTC_ADDR
 589 0178 01 60		mov		r1, #PTC_CMD_STOP
 590 017A 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 591 017C 0F B7		mov		pc, lr
 592           	
 593           	; Rotina:    ptc_get_value
 594           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 595           	;            Interface exemplo: uint8_t ptc_get_value( );
 596           	; Entradas:  -
 597           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 598           	; Efeitos:   -
 599           	ptc_get_value:
 600 017E 51 0C		ldr		r1, PTC_ADDR
 601 0180 10 09		ldrb	r0, [r1, #PTC_TC_ADDRESS]
 602 0182 0F B7		mov		pc, lr
 603           	
 604           	; Rotina:    ptc_clr_irq
 605           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 606           	;            interrupção.
 607           	;            Interface exemplo: void ptc_clr_irq( );
 608           	; Entradas:  -
 609           	; Saidas:    -
 610           	; Efeitos:   -
 611           	ptc_clr_irq:
 612 0184 20 0C		ldr		r0, PTC_ADDR
 613 0186 81 29		strb	r1, [r0, #PTC_TIR_ADDRESS]
 614 0188 0F B7		mov		pc, lr
 615           	
 616           	PTC_ADDR:
 617 018A 00 FF		.word	PTC_ADDRESS
 618           	
 619           	
