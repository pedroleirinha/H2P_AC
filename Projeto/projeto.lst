 308           	;
 309           	; Parametros de saida:
 310           	;   uint8_t ---------> r0
 311           	;
 312           	convert_moleinput_moleoutput:
 313 00D4 02 B0		MOV R2, R0
 314           	
 315           	convert_before_while:
 316 00D6 02 60	    MOV r2, #0 ; 1
 317           	convert_while:
 318 00D8 A0 B8	    CMP	r2, r1              ; n >= 1
 319 00DA 03 48	    BHS	convert_end 
 320           	    
 321 00DC 80 E0	    LSL r0, r0, #1          
 322 00DE 91 A8	    SUB	r1, r1, #1          ; m => contador; m--
 323 00E0 FB 5B	    B	convert_while
 324           	
 325           	convert_end:
 326           	
 327 00E2 0F B7		MOV PC, LR
