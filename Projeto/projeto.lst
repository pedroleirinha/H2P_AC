 300           	; >> Função CONVERT_MOLEINPUT_MOLEOUTPUT <<
 301           	; Tipo: - FOLHA -
 302           	; Parametros de entrada:
 303           	;   uint4_t num_ -------> r0
 304           	;   uint4_t index -------> r1
 305           	;
 306           	; variaveis locais:
