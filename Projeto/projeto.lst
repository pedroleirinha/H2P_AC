 549 01A4 10 18		LDRB R0, [R1, R0]
 550           	
 551 01A6 0F B7		MOV PC, LR
 552           	
 553           	;END
 554           	
 555           	
 556           	
 557           	
 558 01A8 8E 02	moles_red_addr:  .word moles_red
 559 01AA 92 02	moles_green_addr:  .word moles_green
