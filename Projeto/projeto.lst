 212           	;
 213           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 214           	; Tipo: - NÃO FOLHA -
 215           	; Parametros de entrada:
 216           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 217           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 218           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 219           	;
 220           	; variaveis locais:
 221           	;   uint8_t i --> r3
 222           	;
 223           	; Parametros de saida:
 224           	;   uint8_t ---------> r0
 225           	;
 226           	show_mole:
 227 00A0 0E 24		PUSH LR
 228           	
 229 00A2 13 60		MOV R3, #1
 230 00A4 A0 B9		CMP R2, R3
 231           	
 232 00A6 03 40		BEQ mole_yellow		; SE o R1 for 1, é YELLOW 
 233           	
 234 00A8 90 B9		CMP R1, R3			; 
 235           		
 236 00AA 03 44		BNE mole_red		; SE o R0 for 0, é RED
 237 00AC 04 5C		BL mole_green		; SE o R0 for 1, é GREEN
 238           	
 239           	mole_yellow:
 240 00AE 13 5C		BL show_mole_yellow
 241 00B0 04 58		B show_mole_end
 242           		
 243           	mole_red:
 244 00B2 0C 5C		BL show_mole_red
 245 00B4 02 58		B show_mole_end
 246           	
 247           	mole_green:
 248 00B6 0C 5C		BL show_mole_green
 249 00B8 00 58		B show_mole_end
 250           	show_mole_end:
 251 00BA 0F 04		POP PC
 252           	
 253           	
