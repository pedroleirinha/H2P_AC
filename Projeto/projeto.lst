 252           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 253           	; Tipo: - NÃO FOLHA -
 254           	; Parametros de entrada:
 255           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 256           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 257           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 258           	;
 259           	; variaveis locais:
 260           	;   uint8_t i --> r3
 261           	;
 262           	; Parametros de saida:
 263           	;   uint8_t ---------> r0
 264           	;
 265           	show_mole:
 266 00B6 0E 24		PUSH LR
 267           	
 268 00B8 13 60		MOV R3, #1
 269 00BA A0 B9		CMP R2, R3
 270           	
 271 00BC 03 40		BEQ mole_yellow		; SE o R1 for 1, é YELLOW 
 272           	
 273 00BE 90 B9		CMP R1, R3			; 
 274           		
 275 00C0 03 44		BNE mole_red		; SE o R0 for 0, é RED
 276 00C2 04 5C		BL mole_green		; SE o R0 for 1, é GREEN
 277           	
 278           	mole_yellow:
 279 00C4 13 5C		BL show_mole_yellow
 280 00C6 04 58		B show_mole_end
 281           		
 282           	mole_red:
