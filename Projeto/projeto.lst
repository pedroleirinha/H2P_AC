 302           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 303           	; Tipo: - NÃO FOLHA -
 304           	; Parametros de entrada:
 305           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 306           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 307           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 308           	;
 309           	; variaveis locais:
 310           	;   uint8_t i --> r3
 311           	;
 312           	; Parametros de saida:
 313           	;   uint8_t ---------> r0
 314           	;
 315           	show_mole:
 316 00DC 0E 24		PUSH LR
 317           	
 318 00DE 13 60		MOV R3, #1
 319 00E0 90 B9		CMP R1, R3			; 
 320           		
 321 00E2 01 44		BNE mole_red		; SE o R0 for 0, é RED
 322 00E4 02 5C		BL mole_green		; SE o R0 for 1, é GREEN
 323           	
 324           	mole_red:
 325 00E6 11 5C		BL show_mole_red
 326 00E8 02 58		B show_mole_end
 327           	
 328           	mole_green:
 329 00EA 13 5C		BL show_mole_green
 330 00EC 00 58		B show_mole_end
 331           	show_mole_end:
 332 00EE 0F 04		POP PC
