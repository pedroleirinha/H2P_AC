 679           	
 680           	; OUTPORT_SET_BITS
 681           	; Introduz os BITS ao valor já no outputport através de uma mascara
 682           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 683           	;
 684           	outport_set_bits:
 685 01E4 0E 24	    PUSH LR
 686           	    
 687 01E6 61 0D	    LDR r1, out_port_img_addr
 688 01E8 11 08	    LDRB r1, [r1]
 689           	
 690 01EA 80 C8	    ORR r0, r0, r1
 691           	
 692 01EC 08 5C	    BL outport_write
 693           	    
 694 01EE 0F 04	    POP PC
 695           	
 696           	; OUTPORT_CLR_BITS
 697           	; Limpa os BITS do valor já no outputport através de uma mascara
 698           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 699           	;
 700           	outport_clr_bits:
 701 01F0 0E 24	    PUSH LR
 702           	    
 703 01F2 01 0D	    LDR r1, out_port_img_addr
 704 01F4 11 08	    LDRB r1, [r1]
 705           	
 706 01F6 10 B0	    MVN r0, r0
 707 01F8 80 C0	    AND r0, r0, r1
 708           	
 709 01FA 01 5C	    BL outport_write
 710           	    
 711 01FC 0F 04	    POP PC
 712           	
 713           	
 714           	; Rotina:    outport_write
 715           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 716           	;            Interface exemplo: void outport_write( uint8_t value );
 717           	; Entradas:  r0 - valor a escrever no porto de saida
 718           	; Saidas:    -
 719           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 720           	outport_write:
 721 01FE 01 6C		MOV	 r1, #OUTPORT_ADDRESS & 0xFF
 722 0200 F1 7F		MOVT r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 723 0202 10 28		STRB r0, [r1, #0]
 724           	
 725           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 726           		; uma mascara
 727           	
 728 0204 71 0C	    LDR r1, out_port_img_addr    
 729 0206 10 28	    STRB r0, [r1, #0]
 730           	
 731 0208 0F B7		MOV	pc, lr
 732           	
 733           	; Rotina:    INPORT_READ
 734           	; Descricao: lê do porto de saida os 8 bits.
 735           	;            Interface exemplo: uint8_t outport_write();
 736           	; Entradas:   - 
 737           	; Saidas:    r0 - valor lido do porto de entrada
 738           	
 739           	inport_read:
 740 020A 20 0C	    LDR r0, input_port_addr
 741 020C 00 08	    LDRB r0, [r0]
 742 020E 0F B7	    MOV pc, lr
 743           	
 744 0210 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 745 0212 C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 746 0214 A3 02	out_port_img_addr:  .word outport_img
 747           	
