  95           	; Rotina:    falling_edge_all_bits
  96           	; Descricao: Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
  97           	; Entradas:  r0 - valor lido o porto de entrada
  98           	; 			 r1 - a mascara do bit
  99           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
 100           	; Efeitos:   
 101           	falling_edge_all_bits:
 102 0026 0E 24		PUSH LR
 103 0028 04 24		PUSH R4
 104 002A 05 24		PUSH R5
 105 002C 06 24		PUSH R6
 106           	game_start_cycle:
 107 002E F5 60		MOV R5, #0x0F
 108 0030 84 60		MOV R4, #0x08					; CARREGA a mascara 1000 para o registo R1
 109           	
 110 0032 83 0E		ldr	 r3, last_play_addr
 111 0034 32 08		ldrb r2, [r3]				; R2 = observação anterior do bit que controla o modo de operação
 112           	
 113           	game_cycle:
 114 0036 60 5C		BL read_marreta 				; Lê do INPUTPORT e retorna os 4 bits de menor peso
 115           		;EOR R1, R4, R5					; INVERTE todos os bits da mascara para ter os bits em active high 
 116 0038 01 B2		MOV R1, R4
 117 003A 0D 5C		BL falling_edge  				; RETORNA TRUE (1) OU FALSE (0)
 118 003C 13 60		MOV R3, #1	
 119 003E 80 B9		CMP R0, R3
 120 0040 F1 43		BZS game_start_return			; SE RETORNO DO FALLING EDGE É IGUAL A 1 => (R2)
 121           	
 122 0042 C4 E8		LSR R4, R4, #1					; FAZ O SHIFT da mascara [1000] em R1 um bit para a direita
 123 0044 01 40		BZS update_value
 124           	
 125 0046 F7 5B		B game_cycle
 126           	
 127           	update_value:
 128 0048 D3 0D		ldr	 r3, last_play_addr
 129 004A 36 28		strb r6, [r3]
 130 004C F0 5B		B game_start_cycle
 131           	return_falling_edge_all:
 132 004E 06 04		POP R6
 133 0050 05 04		POP R5
 134 0052 04 04		POP R4
 135 0054 0F 04		POP PC
 136           	;END falling_edge_all_bits
