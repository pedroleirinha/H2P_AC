 767           	/************************************************************************************
 768           	 * LIB time
 769           	 ************************************************************************************/
 770           	; Rotina:    time_get_ref
 771           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 772           	; Entradas:  void
 773           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 774           	; Efeitos:   *** Para completar ***
 775           	time_get_ref:
 776 0222 0E 24		PUSH LR
 777           	
 778 0224 18 5C		BL sysclk_get_ticks
 779           	
 780 0226 0F 04		POP PC
 781           	;time_get_ref
 782           	
 783           	; Rotina:    time_elapsed
 784           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 785           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 786           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 787           	; Efeitos:   *** Para completar ***
 788           	time_elapsed:
 789 0228 0E 24		PUSH LR
 790           	
 791 022A 01 B0		MOV R1, R0
 792           	
 793 022C 14 5C		BL sysclk_get_ticks		; Retorna o valor atual do sysclock
 794           	
 795 022E 80 88		SUB R0, R0, R1			; Calcula a diferença entre o tempo atual (sysclk) e o valor referncia (sysclk antigo)
 796           	
 797 0230 0F 04		POP PC
 798           	;time_elapsed
 799           	
 800           	/************************************************************************************
 801           	 * HAL sys_clk
 802           	 ************************************************************************************/
 803           	; Rotina:    isr
 804           	; Descricao: Incrementa o valor da variável global sysclk.
 805           	; Entradas:  -
 806           	; Saidas:    -
 807           	; Efeitos:   *** Para completar ***
 808           	isr:
 809 0232 0E 24		PUSH	LR
 810 0234 01 24		PUSH	r1
 811 0236 00 24		PUSH	r0
 812           		
 813 0238 26 5C		BL 		ptc_clr_irq
 814           	
 815 023A 00 0D		LDR		r0, SYSCLK_ADDR
 816 023C 01 00		LDR		r1, [r0, #0]
 817 023E 91 A0		ADD		r1, r1, #1
 818 0240 01 20		STR		r1, [r0, #0]
 819 0242 00 04		POP		r0
 820 0244 01 04		POP		r1	
 821 0246 0E 04		POP		LR 
 822           	
 823 0248 20 B0		MOVS	pc, lr
 824           	
 825           	
 826           	; Rotina:    sysclk_init
 827           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 828           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 829           	;            interrupção pendentes e iniciando com o valor zero a variavel
 830           	;            global sysclk.
 831           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 832           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 833           	; Saidas:    -
 834           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 835           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 836           	;            valor zero a variavel global sysclk
 837           	sysclk_init:
 838 024A 0E 24		PUSH	lr
 839 024C 71 0C		LDR		r1, SYSCLK_ADDR
 840 024E 02 60		MOV		r2, #0
 841 0250 12 20		STR 	r2, [r1]
 842 0252 05 5C		BL		ptc_init
 843 0254 0F 04		POP		pc
 844           		
 845           	; Rotina:    sysclk_get_ticks
 846           	; Descricao: Devolve o valor corrente da variável global sysclk.
 847           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 848           	; Entradas:  -
 849           	; Saidas:    *** Para completar ***
 850           	; Efeitos:   -
 851           	sysclk_get_ticks:
 852 0256 20 0C		LDR		r0, SYSCLK_ADDR
 853 0258 00 00		LDR		r0, [r0]
 854 025A 0F B7		MOV		pc, lr
 855           	
 856           	
 857          	.align 1
 858 025C AE 02	SYSCLK_ADDR: .word	sysclk
 859           	
 860           	
 861           	/************************************************************************************
 862           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 863           	 ************************************************************************************/
 864           	; Rotina:    ptc_init
 865           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 866           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 867           	;            ticks.
 868           	;            Interface exemplo: void ptc_init( uint8_t interval );
 869           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 870           	; Saidas:    -
 871           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 872           	;            o pedido de interrupcao eventualmente pendente.
 873           	ptc_init:
 874 025E 0E 24	    PUSH    lr
 875 0260 00 24		PUSH	r0
 876 0262 0A 5C		BL 		ptc_stop
 877 0264 00 04		POP		r0
 878 0266 21 0D		LDR		r1, PTC_ADDR
 879 0268 10 29		STRB	r0, [r1, #PTC_TMR_ADDRESS]
 880 026A 0D 5C	    BL  	ptc_clr_irq
 881 026C 01 5C		BL 		ptc_start
 882 026E 0F 04		POP pc
 883           	
 884           	
 885           	
 886           	; Rotina:    ptc_start
 887           	; Descricao: Habilita a contagem no periferico pTC.
 888           	;            Interface exemplo: void ptc_start( );
 889           	; Entradas:  -
 890           	; Saidas:    -
 891           	; Efeitos:   -
 892           	ptc_start:
 893 0270 D0 0C		LDR		r0, PTC_ADDR
 894 0272 01 60		MOV		r1, #PTC_CMD_START
 895 0274 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 896 0276 0F B7		MOV		pc, lr
 897           	
 898           	; Rotina:    ptc_stop
 899           	; Descricao: Para a contagem no periferico pTC.
 900           	;            Interface exemplo: void ptc_stop( );
 901           	; Entradas:  -
 902           	; Saidas:    -
 903           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 904           	ptc_stop:
 905 0278 90 0C		LDR		r0, PTC_ADDR
 906 027A 11 60		MOV		r1, #PTC_CMD_STOP
 907 027C 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 908 027E 0F B7		MOV		pc, lr
 909           	
 910           	; Rotina:    ptc_get_value
 911           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 912           	;            Interface exemplo: uint8_t ptc_get_value( );
 913           	; Entradas:  -
 914           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 915           	; Efeitos:   -
 916           	ptc_get_value:
 917 0280 51 0C		LDR		r1, PTC_ADDR
 918 0282 10 0A		LDRB	r0, [r1, #PTC_TC_ADDRESS]
 919 0284 0F B7		MOV		pc, lr
 920           	
 921           	; Rotina:    ptc_clr_irq
 922           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 923           	;            interrupção.
 924           	;            Interface exemplo: void ptc_clr_irq( );
 925           	; Entradas:  -
 926           	; Saidas:    -
 927           	; Efeitos:   -
 928           	ptc_clr_irq:
 929 0286 20 0C		LDR		r0, PTC_ADDR
 930 0288 01 2B		STRB	r1, [r0, #PTC_TIR_ADDRESS]
 931 028A 0F B7		MOV		pc, lr
 932           	
 933           	PTC_ADDR:
 934 028C 00 FF		.word	PTC_ADDRESS
