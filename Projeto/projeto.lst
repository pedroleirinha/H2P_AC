 643           	/************************************************************************************
 644           	 * LIB time
 645           	 ************************************************************************************/
 646           	; Rotina:    time_get_ref
 647           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 648           	; Entradas:  void
 649           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 650           	; Efeitos:   *** Para completar ***
 651           	time_get_ref:
 652           		; Completar
 653           	
 654           	; Rotina:    time_elapsed
 655           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 656           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 657           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 658           	; Efeitos:   *** Para completar ***
 659           	time_elapsed:
 660           		; Completar
 661           	
 662           	/************************************************************************************
 663           	 * HAL sys_clk
 664           	 ************************************************************************************/
 665           	; Rotina:    isr
 666           	; Descricao: Incrementa o valor da variável global sysclk.
 667           	; Entradas:  -
 668           	; Saidas:    -
 669           	; Efeitos:   *** Para completar ***
 670           	isr:
 671 01B2 01 24		push	r1
 672 01B4 00 24		push	r0
 673 01B6 00 60		mov	r0, #INT_CS_ADDRESS & 0xFF
 674 01B8 F0 7F		movt	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 675 01BA 02 28		strb	r2, [r0, #0]
 676 01BC F0 0C		ldr	r0, SYSCLK_ADDR
 677 01BE 01 08		ldrb	r1, [r0, #0]
 678 01C0 91 A0		add	r1, r1, #1
 679 01C2 01 28		strb	r1, [r0, #0]
 680 01C4 00 04		pop	r0
 681 01C6 01 04		pop	r1
 682 01C8 20 B0		movs	pc, lr
 683           	
 684           	
 685           	; Rotina:    sysclk_init
 686           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 687           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 688           	;            interrupção pendentes e iniciando com o valor zero a variavel
 689           	;            global sysclk.
 690           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 691           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 692           	; Saidas:    -
 693           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 694           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 695           	;            valor zero a variavel global sysclk
 696           	sysclk_init:
 697 01CA 0E 24		push	lr
 698 01CC 71 0C		ldr		r1, SYSCLK_ADDR
 699 01CE 02 60		mov		r2, #0
 700 01D0 12 20		str 	r2, [r1]
 701 01D2 05 5C		bl		ptc_init
 702 01D4 0F 04		pop		pc
 703           		
 704           	; Rotina:    sysclk_get_ticks
 705           	; Descricao: Devolve o valor corrente da variável global sysclk.
 706           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 707           	; Entradas:  -
 708           	; Saidas:    *** Para completar ***
 709           	; Efeitos:   -
 710           	sysclk_get_ticks:
 711 01D6 20 0C		ldr		r0, SYSCLK_ADDR
 712 01D8 00 00		ldr		r0, [r0]
 713 01DA 0F B7		mov		pc, lr
 714           	
 715           	SYSCLK_ADDR:
 716 01DC 25 02		.word	sysclk
 717           	
 718           	/************************************************************************************
 719           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 720           	 ************************************************************************************/
 721           	; Rotina:    ptc_init
 722           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 723           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 724           	;            ticks.
 725           	;            Interface exemplo: void ptc_init( uint8_t interval );
 726           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 727           	; Saidas:    -
 728           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 729           	;            o pedido de interrupcao eventualmente pendente.
 730           	ptc_init:
 731 01DE 0E 24	    push    lr
 732 01E0 00 24		push	r0
 733 01E2 0A 5C		bl 		ptc_stop
 734 01E4 00 04		pop		r0
 735 01E6 21 0D		ldr		r1, PTC_ADDR
 736 01E8 90 28		strb	r0, [r1, #PTC_TMR_ADDRESS]
 737 01EA 0D 5C	    bl  	ptc_clr_irq
 738 01EC 01 5C		bl 		ptc_start
 739 01EE 0F 04		pop pc
 740           	
 741           	
 742           	; Rotina:    ptc_start
 743           	; Descricao: Habilita a contagem no periferico pTC.
 744           	;            Interface exemplo: void ptc_start( );
 745           	; Entradas:  -
 746           	; Saidas:    -
 747           	; Efeitos:   -
 748           	ptc_start:
 749 01F0 D0 0C		ldr		r0, PTC_ADDR
 750 01F2 11 60		mov		r1, #PTC_CMD_START
 751 01F4 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 752 01F6 0F B7		mov		pc, lr
 753           	
 754           	; Rotina:    ptc_stop
 755           	; Descricao: Para a contagem no periferico pTC.
 756           	;            Interface exemplo: void ptc_stop( );
 757           	; Entradas:  -
 758           	; Saidas:    -
 759           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 760           	ptc_stop:
 761 01F8 90 0C		ldr		r0, PTC_ADDR
 762 01FA 01 60		mov		r1, #PTC_CMD_STOP
 763 01FC 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 764 01FE 0F B7		mov		pc, lr
 765           	
 766           	; Rotina:    ptc_get_value
 767           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 768           	;            Interface exemplo: uint8_t ptc_get_value( );
 769           	; Entradas:  -
 770           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 771           	; Efeitos:   -
 772           	ptc_get_value:
 773 0200 51 0C		ldr		r1, PTC_ADDR
 774 0202 10 09		ldrb	r0, [r1, #PTC_TC_ADDRESS]
 775 0204 0F B7		mov		pc, lr
 776           	
 777           	; Rotina:    ptc_clr_irq
 778           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 779           	;            interrupção.
 780           	;            Interface exemplo: void ptc_clr_irq( );
 781           	; Entradas:  -
 782           	; Saidas:    -
 783           	; Efeitos:   -
 784           	ptc_clr_irq:
 785 0206 20 0C		ldr		r0, PTC_ADDR
 786 0208 81 29		strb	r1, [r0, #PTC_TIR_ADDRESS]
 787 020A 0F B7		mov		pc, lr
 788           	
 789           	PTC_ADDR:
 790 020C 00 FF		.word	PTC_ADDRESS
