 877           	; Entradas:  -
 878           	; Saidas:    -
 879           	; Efeitos:   -
 880           	ptc_clr_irq:
 881 0256 20 0C		LDR		r0, PTC_ADDR
 882 0258 01 2B		STRB	r1, [r0, #PTC_TIR_ADDRESS]
 883 025A 0F B7		MOV		pc, lr
