 687           	/************************************************************************************
 688           	 * HAL sys_clk
 689           	 ************************************************************************************/
 690           	; Rotina:    isr
 691           	; Descricao: Incrementa o valor da variável global sysclk.
 692           	; Entradas:  -
 693           	; Saidas:    -
 694           	; Efeitos:   *** Para completar ***
 695           	isr:
 696 01B2 01 24		PUSH	r1
 697 01B4 00 24		PUSH	r0
 698 01B6 00 60		MOV		r0, #INT_CS_ADDRESS & 0xFF
 699 01B8 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 700 01BA 02 28		STRB	r2, [r0, #0]
 701 01BC F0 0C		LDR		r0, SYSCLK_ADDR
 702 01BE 01 08		LDRB	r1, [r0, #0]
 703 01C0 91 A0		ADD		r1, r1, #1
 704 01C2 01 28		STRB	r1, [r0, #0]
 705 01C4 00 04		POP		r0
 706 01C6 01 04		POP		r1
 707 01C8 20 B0		MOVS	pc, lr
 708           	
 709           	
 710           	; Rotina:    sysclk_init
 711           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 712           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 713           	;            interrupção pendentes e iniciando com o valor zero a variavel
 714           	;            global sysclk.
 715           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 716           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 717           	; Saidas:    -
 718           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 719           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 720           	;            valor zero a variavel global sysclk
 721           	sysclk_init:
 722 01CA 0E 24		PUSH	lr
 723 01CC 71 0C		LDR		r1, SYSCLK_ADDR
 724 01CE 02 60		MOV		r2, #0
 725 01D0 12 20		STR 	r2, [r1]
 726 01D2 05 5C		BL		ptc_init
 727 01D4 0F 04		POP		pc
 728           		
 729           	; Rotina:    sysclk_get_ticks
 730           	; Descricao: Devolve o valor corrente da variável global sysclk.
 731           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 732           	; Entradas:  -
 733           	; Saidas:    *** Para completar ***
 734           	; Efeitos:   -
 735           	sysclk_get_ticks:
 736 01D6 20 0C		LDR		r0, SYSCLK_ADDR
 737 01D8 00 00		LDR		r0, [r0]
 738 01DA 0F B7		MOV		pc, lr
 739           	
 740           	SYSCLK_ADDR:
 741 01DC 29 02		.word	sysclk
 742           	
 743           	
 744           	/************************************************************************************
 745           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 746           	 ************************************************************************************/
 747           	; Rotina:    ptc_init
 748           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 749           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 750           	;            ticks.
 751           	;            Interface exemplo: void ptc_init( uint8_t interval );
 752           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 753           	; Saidas:    -
 754           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 755           	;            o pedido de interrupcao eventualmente pendente.
 756           	ptc_init:
 757 01DE 0E 24	    PUSH    lr
 758 01E0 00 24		PUSH	r0
 759 01E2 0A 5C		BL 		ptc_stop
 760 01E4 00 04		POP		r0
 761 01E6 21 0D		LDR		r1, PTC_ADDR
 762 01E8 90 28		STRB	r0, [r1, #PTC_TMR_ADDRESS]
 763 01EA 0D 5C	    BL  	ptc_clr_irq
 764 01EC 01 5C		BL 		ptc_start
 765 01EE 0F 04		POP pc
 766           	
 767           	
 768           	; Rotina:    ptc_start
 769           	; Descricao: Habilita a contagem no periferico pTC.
 770           	;            Interface exemplo: void ptc_start( );
 771           	; Entradas:  -
 772           	; Saidas:    -
 773           	; Efeitos:   -
 774           	ptc_start:
 775 01F0 D0 0C		LDR		r0, PTC_ADDR
 776 01F2 01 60		MOV		r1, #PTC_CMD_START
 777 01F4 01 29		STRB	r1, [r0, #PTC_TC_ADDRESS]
 778 01F6 0F B7		MOV		pc, lr
 779           	
 780           	; Rotina:    ptc_stop
 781           	; Descricao: Para a contagem no periferico pTC.
 782           	;            Interface exemplo: void ptc_stop( );
 783           	; Entradas:  -
 784           	; Saidas:    -
 785           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 786           	ptc_stop:
 787 01F8 90 0C		LDR		r0, PTC_ADDR
 788 01FA 11 60		MOV		r1, #PTC_CMD_STOP
 789 01FC 01 29		STRB	r1, [r0, #PTC_TC_ADDRESS]
 790 01FE 0F B7		MOV		pc, lr
 791           	
 792           	; Rotina:    ptc_get_value
 793           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 794           	;            Interface exemplo: uint8_t ptc_get_value( );
 795           	; Entradas:  -
 796           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 797           	; Efeitos:   -
 798           	ptc_get_value:
 799 0200 51 0C		LDR		r1, PTC_ADDR
 800 0202 10 09		LDRB	r0, [r1, #PTC_TC_ADDRESS]
 801 0204 0F B7		MOV		pc, lr
 802           	
 803           	; Rotina:    ptc_clr_irq
 804           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 805           	;            interrupção.
 806           	;            Interface exemplo: void ptc_clr_irq( );
 807           	; Entradas:  -
 808           	; Saidas:    -
 809           	; Efeitos:   -
 810           	ptc_clr_irq:
 811 0206 20 0C		LDR		r0, PTC_ADDR
 812 0208 81 29		STRB	r1, [r0, #PTC_TIR_ADDRESS]
 813 020A 0F B7		MOV		pc, lr
