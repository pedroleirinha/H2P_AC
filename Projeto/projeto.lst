 138           	; Rotina:    falling_edge
 139           	; Descricao: Retorna booleano indicando se detetou uma transição descendente no bit que controla o modo de funcionamento do sistema;
 140           	; Entradas:  r0 - valor lido o porto de entrada
 141           	; 			 r1 - a mascara do bit
 142           	;			 r2 - valor em memória
 143           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
 144           	; Efeitos:   
 145           	falling_edge:
 146 0056 04 24		PUSH R4
 147 0058 05 24		PUSH R5
 148           	
 149 005A 84 C0		AND	r4, r0, r1 			; Aplica a mascara no valor de entrada. VERIFICA SE O VALOR ATUAL DO BIT É 0
 150           		; O bit atual do valor no inputport tem de ser 0 para detetar uma transição descendente 
 151           	
 152 005C 04 44		BNE falling_edge_false	
 153           	
 154 005E 14 C1		AND r4, r1, r2 			; Aplica a mascara no valor antigo. VERIFICA SE O VALOR ANTIGO DO BIT É 1
 155           	
 156 0060 02 40		BZS falling_edge_false
 157           	
 158           		; TRANSICAO DESCENDENTE
 159 0062 10 60		mov		r0, #1				; retorna true: observação anterior igual a OFF (1) e observação atual igual a ON (0)
 160 0064 01 58		B  falling_edge_return
 161           	
 162           	falling_edge_false:
 163 0066 00 60		mov		r0, #0
 164           	
 165           	falling_edge_return:
 166           		
 167 0068 05 04		POP R5
 168 006A 04 04		POP R4
 169           	
 170 006C 0F B7		mov		pc, lr
