 461           	; >> Função GAME START SIGNAL << Coloca todos os leds a laranja
 462           	; Tipo: - FOLHA -
 463           	; Parametros de entrada:
 464           	;	-
 465           	; variaveis locais:
 466           	;	-
 467           	; Parametros de saida:
 468           	;   - 
 469           	;
 470           	game_start_signal: 
 471 015C 0E 24		PUSH LR
 472 015E F0 6F		MOV R0, #0xFF ; Coloca todos os 8 bits do output a 1, que significa ativar o RED e GREEN simultaneamente
 473           	
 474 0160 0A 5C		BL outport_set_bits
 475           	
 476 0162 0F 04		POP PC
 477           	; END
 478           	
