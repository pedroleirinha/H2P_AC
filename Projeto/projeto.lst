  99           	; Rotina:    falling_edge
 100           	; Descricao: Retorna booleano indicando se detetou uma transição descendente no bit que controla o modo de funcionamento do sistema;
 101           	; Entradas:  r0 - valor lido o porto de entrada
 102           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
 103           	; Efeitos:   
 104           	falling_edge:
 105 0050 61 0E		ldr		r1, last_play_addr
 106 0052 12 08		ldrb	r2, [r1]			; R2 = observação anterior do bit que controla o modo de operação
 107 0054 03 68		mov 	r3, #SWT_BLINK_MODE_MSK
 108 0056 80 C1		and		r0, r0, r3			; isola o valor atual do bit modo piscar
 109 0058 10 28		strb	r0, [r1]
 110 005A 00 EC		lsr		r0, r0, #SWT_BLINK_MODE_POS+1
 111 005C 04 48		bcs		falling_edge_false	; se observação atual igual a OFF (1) retorna false
 112 005E 20 EC		lsr		r0, r2, #SWT_BLINK_MODE_POS+1
 113 0060 02 4C		bcc		falling_edge_false	; se observação anterior igual a ON (0) retorna false
 114 0062 10 60		mov		r0, #1				; retorna true: observação anterior igual a OFF (1) e observação atual igual a ON (0)
 115 0064 0F B7		mov		pc, lr
 116           	falling_edge_false:
 117 0066 00 60		mov		r0, #0
 118 0068 0F B7		mov		pc, lr
