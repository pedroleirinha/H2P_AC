 488           	/************************************************************************************
 489           	 * HAL sys_clk
 490           	 ************************************************************************************/
 491           	; Rotina:    isr
 492           	; Descricao: Incrementa o valor da variável global sysclk.
 493           	; Entradas:  -
 494           	; Saidas:    -
 495           	; Efeitos:   *** Para completar ***
 496           	isr:
 497 012E 01 24		push	r1
 498 0130 00 24		push	r0
 499 0132 00 60		mov	r0, #INT_CS_ADDRESS & 0xFF
 500 0134 F0 7F		movt	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 501 0136 02 28		strb	r2, [r0, #0]
 502 0138 60 0C		ldr	r0, var_addr_isr
 503 013A 01 08		ldrb	r1, [r0, #0]
 504 013C 91 A0		add	r1, r1, #1
 505 013E 01 28		strb	r1, [r0, #0]
 506 0140 00 04		pop	r0
 507 0142 01 04		pop	r1
 508 0144 20 B0		movs	pc, lr
 509           	
 510 0146 94 01	var_addr_isr:		.word var
 511           	
 512           	; Rotina:    sysclk_init
 513           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 514           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 515           	;            interrupção pendentes e iniciando com o valor zero a variavel
 516           	;            global sysclk.
 517           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 518           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 519           	; Saidas:    -
 520           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 521           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 522           	;            valor zero a variavel global sysclk
 523           	sysclk_init:
 524 0148 0E 24		push	lr
 525 014A 71 0C		ldr		r1, SYSCLK_ADDR
 526 014C 02 60		mov		r2, #0
 527 014E 12 20		str 	r2, [r1]
 528 0150 05 5C		bl		ptc_init
 529 0152 0F 04		pop		pc
 530           		
