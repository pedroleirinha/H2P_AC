 430 013A 62 0C		LDR	 r2, last_play_addr
 431 013C 23 08		LDRB r3, [r2]	; VALOR EM MEMORIA
 432           	
 433 013E 20 28		STRB r0, [r2]	; ATUALIZA EM MEMORIA
 434           	
 435 0140 10 B0		MVN R0, R0		; INVERTE OS BITS 
 436 0142 80 C1		AND R0, R0, R3	
 437           	
 438 0144 80 C0		AND R0, R0, R1 ; FILTRA OS 4 BITS menos significativos 
 439 0146 0F B7		MOV PC, LR
 440           	
 441           	last_play_addr:
 442 0148 82 02		.word	last_play
 443           	
 444           	
 445           	; START_UP
 446           	; Rotina que inicializa o programa.
 447           	start_up_interruptions:
 448 014A 0E 24		PUSH LR
 449           	
 450 014C 46 5C		BL	outport_write		 					; Escreve o zero no output port
 451 014E 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 452 0150 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 453 0152 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 454           	
 455 0154 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 456 0156 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 457 0158 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 458 015A 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 459           	
 460 015C 0F 04		POP PC
 461           	;END interruption
