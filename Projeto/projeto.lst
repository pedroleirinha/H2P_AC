 449           	
 450           	; Rotina:    detect play
 451           	; Descricao: Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 452           	; Entradas:  -
 453           	; Saidas:    -
 454           	; Efeitos:   
 455           	detect_play:
 456 015C 0E 24		PUSH LR
 457 015E 04 24		PUSH R4
 458           		
 459 0160 2D 5C		BL read_marreta 				; Lê e retorna os 4 bits de menor peso R0
 460 0162 F1 60		MOV R1, #0x0F
 461 0164 02 5C		BL falling_edge_v2
 462           	
 463 0166 04 04		POP R4
 464 0168 0F 04		POP PC
 465           	
 466           	;END DETECT_PLAY
 467           	
 468           	
 469           	
 470           	; Entradas:  r0 - valor lido o porto de entrada
 471           	; 			 r1 - Mascara inicial 
 472           	falling_edge_v2:
 473 016A 62 0C		LDR	 r2, last_play_addr
 474 016C 23 08		LDRB r3, [r2]	; VALOR EM MEMORIA
 475           	
 476 016E 20 28		STRB r0, [r2]	; ATUALIZA EM MEMORIA
 477           	
 478 0170 10 B0		MVN R0, R0		; INVERTE OS BITS 
 479 0172 80 C1		AND R0, R0, R3	
 480           	
 481 0174 80 C0		AND R0, R0, R1 ; FILTRA OS 4 BITS menos significativos 
 482 0176 0F B7		MOV PC, LR
 483           	
 484           	last_play_addr:
 485 0178 AD 02		.word	last_play
 486           	
 487           	
 488           	; START_UP
 489           	; Rotina que inicializa o programa.
 490           	start_up_interruptions:
 491 017A 0E 24		PUSH LR
 492           	
 493 017C 46 5C		BL	outport_write		 					; Escreve o zero no output port
 494 017E 00 60		MOV	r0, #INT_CS_ADDRESS & 0xFF				; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS
 495 0180 F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF	; CARREGA O ENDEREÇO DE MEMÓRIA DO INT_CS		
 496 0182 00 28		STRB	r0, [r0, #0]						; Faz um STOREB para ativar o sinal nWrL
 497           	
 498 0184 60 B0		mrs	r0, cpsr								; Passa as flags para o R0
 499 0186 01 61		MOV	r1, #ENABLE_EXTINT						; Passa para R1 a mascara que ativa a flag I
 500 0188 80 C8		orr	r0, r0, r1								; Realiza um OR bit a bit entre R0 e R1
 501 018A 40 B0		msr	cpsr, r0								; Passa as novas flags atualizadas para o registo CPSR
 502           	
 503 018C 0F 04		POP PC
 504           	;END interruption
