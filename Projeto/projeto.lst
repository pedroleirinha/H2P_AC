 433           	
 434           	; OUTPORT_SET_BITS
 435           	; Introduz os BITS ao valor já no outputport através de uma mascara
 436           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 437           	;
 438           	outport_set_bits:
 439 0114 0E 24	    PUSH LR
 440           	    
 441 0116 61 0D	    LDR r1, out_port_img_addr
 442 0118 11 08	    LDRB r1, [r1]
 443           	
 444 011A 80 C8	    ORR r0, r0, r1
 445           	
 446 011C 08 5C	    BL outport_write
 447           	    
 448 011E 0F 04	    POP PC
 449           	
 450           	; OUTPORT_CLR_BITS
 451           	; Limpa os BITS do valor já no outputport através de uma mascara
 452           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 453           	;
 454           	outport_clr_bits:
 455 0120 0E 24	    PUSH LR
 456           	    
 457 0122 01 0D	    LDR r1, out_port_img_addr
 458 0124 11 08	    LDRB r1, [r1]
 459           	
 460 0126 10 B0	    MVN r0, r0
 461 0128 80 C0	    AND r0, r0, r1
 462           	
 463 012A 01 5C	    BL outport_write
 464           	    
 465 012C 0F 04	    POP PC
 466           	
 467           	
 468           	; Rotina:    outport_write
 469           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 470           	;            Interface exemplo: void outport_write( uint8_t value );
 471           	; Entradas:  r0 - valor a escrever no porto de saida
 472           	; Saidas:    -
 473           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 474           	outport_write:
 475 012E 01 6C		mov	 r1, #OUTPORT_ADDRESS & 0xFF
 476 0130 F1 7F		movt r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 477 0132 10 28		strb r0, [r1, #0]
 478           	
 479           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 480           		; uma mascara
 481           	
 482 0134 71 0C	    ldr r1, out_port_img_addr    
 483 0136 10 28	    strb r0, [r1, #0]
 484           	
 485 0138 0F B7		mov	pc, lr
 486           	
 487           	; Rotina:    INPORT_READ
 488           	; Descricao: lê do porto de saida os 8 bits.
 489           	;            Interface exemplo: uint8_t outport_write();
 490           	; Entradas:   - 
 491           	; Saidas:    r0 - valor lido do porto de entrada
 492           	
 493           	inport_read:
 494 013A 20 0C	    ldr r0, input_port_addr
 495 013C 00 08	    ldrb r0, [r0]
 496 013E 0F B7	    mov pc, lr
 497           	
 498 0140 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 499 0142 C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 500 0144 AE 01	out_port_img_addr:  .word outport_img
 501           	
