 875           	; Descricao: Implementa a pilha com a dimensao definida pelo simbolo STACK_SIZE
 876           	;
 877           		.stack
 878 0236 00   		.space	STACK_SIZE
 878 .... ..
 878 0275 00
 879           	stack_top:
 880           	
 881           	
 882           	; SE A FREQ FOR 100kH, dá 0.01ms por cada contagem de clock. Se for até 255, dá no maximo 2,5ms
 883           	; SE A FREQ FOR 1kH, dá 1ms por cada contagem de clock. Se for até 255, dá no maximo 255ms
 884           	
 885           	; COM 10HZ
 886           	; 	TEMPO		CICLOS	PL		
 887           	; 	10 s		100		99 	[0x63]
 888           	; 	9  s		90		89	[0x59]
 889           	; 	8  s		80		79	[0x4F]
 890           	; 	7  s		70		69	[0x45]
 891           	; 	6  s		60		59	[0x3B]
 892           	; 	5  s		50		49	[0x31]
 893           	; 	4  s		40		39	[0x27]
 894           	; 	3  s		30		29	[0x1D]
 895           	; 	2  s		20		19	[0x13]
 896           	; 	1  s		10		09	[0x09]
 897           	; 	0.5s		5		04	[0x04]
 898           	; 
 898           	
