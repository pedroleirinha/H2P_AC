 567           	;;						;;
 568           	;; 		PORTS API 		;;
 569           	;; 						;;
 570           	
 571           	; OUTPORT_SET_BITS
 572           	; Introduz os BITS ao valor já no outputport através de uma mascara
 573           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 574           	;
 575           	outport_set_bits:
 576 0186 0E 24	    PUSH LR
 577           	    
 578 0188 61 0D	    LDR r1, out_port_img_addr
 579 018A 11 08	    LDRB r1, [r1]
 580           	
 581 018C 80 C8	    ORR r0, r0, r1
 582           	
 583 018E 08 5C	    BL outport_write
 584           	    
 585 0190 0F 04	    POP PC
 586           	
 587           	; OUTPORT_CLR_BITS
 588           	; Limpa os BITS do valor já no outputport através de uma mascara
 589           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 590           	;
 591           	outport_clr_bits:
 592 0192 0E 24	    PUSH LR
 593           	    
 594 0194 01 0D	    LDR r1, out_port_img_addr
 595 0196 11 08	    LDRB r1, [r1]
 596           	
 597 0198 10 B0	    MVN r0, r0
 598 019A 80 C0	    AND r0, r0, r1
 599           	
 600 019C 01 5C	    BL outport_write
 601           	    
 602 019E 0F 04	    POP PC
 603           	
 604           	
 605           	; Rotina:    outport_write
 606           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 607           	;            Interface exemplo: void outport_write( uint8_t value );
 608           	; Entradas:  r0 - valor a escrever no porto de saida
 609           	; Saidas:    -
 610           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 611           	outport_write:
 612 01A0 01 6C		mov	 r1, #OUTPORT_ADDRESS & 0xFF
 613 01A2 F1 7F		movt r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 614 01A4 10 28		strb r0, [r1, #0]
 615           	
 616           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 617           		; uma mascara
 618           	
 619 01A6 71 0C	    ldr r1, out_port_img_addr    
 620 01A8 10 28	    strb r0, [r1, #0]
 621           	
 622 01AA 0F B7		mov	pc, lr
 623           	
 624           	; Rotina:    INPORT_READ
 625           	; Descricao: lê do porto de saida os 8 bits.
 626           	;            Interface exemplo: uint8_t outport_write();
 627           	; Entradas:   - 
 628           	; Saidas:    r0 - valor lido do porto de entrada
 629           	
 630           	inport_read:
 631 01AC 20 0C	    ldr r0, input_port_addr
 632 01AE 00 08	    ldrb r0, [r0]
 633 01B0 0F B7	    mov pc, lr
 634           	
 635 01B2 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 636 01B4 C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 637 01B6 2D 02	out_port_img_addr:  .word outport_img
 638           	
