 437           	; Rotina:    outport_write
 438           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 439           	;            Interface exemplo: void outport_write( uint8_t value );
 440           	; Entradas:  r0 - valor a escrever no porto de saida
 441           	; Saidas:    -
 442           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 443           	outport_write:
 444 0130 01 6C		mov	 r1, #OUTPORT_ADDRESS & 0xFF
 445 0132 F1 7F		movt r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 446 0134 10 28		strb r0, [r1, #0]
 447           	
 448           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 449           		; uma mascara
 450           	
 451 0136 71 0C	    ldr r1, out_port_img_addr    
 452 0138 10 28	    strb r0, [r1, #0]
 453           	
 454 013A 0F B7		mov	pc, lr
 455           	
 456           	; Rotina:    INPORT_READ
 457           	; Descricao: lê do porto de saida os 8 bits.
 458           	;            Interface exemplo: uint8_t outport_write();
 459           	; Entradas:   - 
 460           	; Saidas:    r0 - valor lido do porto de entrada
 461           	
 462           	inport_read:
 463 013C 20 0C	    ldr r0, input_port_addr
 464 013E 00 08	    ldrb r0, [r0]
 465 0140 0F B7	    mov pc, lr
 466           	
