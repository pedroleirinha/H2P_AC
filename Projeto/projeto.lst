 470           	; Rotina:    turn_mole_red
 471           	; Descricao: 
 472           	; Entradas:  R0 -> INDEX da toupeira
 473           	; Saidas:    -
 474           	; Efeitos:   
 475           	turn_mole_red:
 476 0138 0E 24		PUSH LR
 477 013A 04 24		PUSH R4
 478           	
 479 013C 04 B0		MOV R4, R0
 480 013E E2 5F		BL get_mole_green 
 481           		
 482 0140 11 5C		BL outport_clr_bits			; LIMPA O BIT QUE TORNA O LED VERDE NA TOUPEIRA 
 483           	
 484 0142 00 B2		MOV R0, R4
 485 0144 DC 5F		BL get_mole_red 
 486           	
 487 0146 08 5C		BL outport_set_bits			; ATIVA O BIT QUE TORNA O LED VERMELHO NA TOUPEIRA 
 488           	
 489 0148 04 04		POP R4
 490 014A 0F 04		POP PC
 491           	;END TURN_MOLE_RED
