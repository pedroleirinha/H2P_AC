 572 01AC F0 6F		MOV R0, #ALL_YELLOW_LIGHTS ; Coloca todos os 8 bits do output a 1, que significa ativar o RED e GREEN simultaneamente
 573           	
 574 01AE 1F 5C		BL outport_set_bits
 575           	
 576 01B0 0F 04		POP PC
 577           	; END
 578           	
