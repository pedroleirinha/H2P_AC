 621           	period:
 622 018C 05		.byte 0x05 ; 1s
 623 018D 0A	    .byte 0x0A ; 2s
 624 018E 0F	    .byte 0x0F ; 3s
 625 018F 14	    .byte 0x14 ; 4s
 626 0190 19	    .byte 0x19 ; 5s
 627 0191 1E	    .byte 0x1E ; 6s
 628 0192 23	    .byte 0x23 ; 7s
 629 0193 28	    .byte 0x28 ; 8s
