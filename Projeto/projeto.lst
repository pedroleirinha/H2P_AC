 333           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 334           	; Tipo: - NÃO FOLHA -
 335           	; Parametros de entrada:
 336           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 337           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 338           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 339           	;
 340           	; variaveis locais:
 341           	;   uint8_t i --> r3
 342           	;
 343           	; Parametros de saida:
 344           	;   uint8_t ---------> r0
 345           	;
 346           	show_mole:
 347 0100 0E 24		PUSH LR
 348           	
 349 0102 13 60		MOV R3, #1
 350 0104 90 B9		CMP R1, R3			; 
 351           		
 352 0106 01 44		BNE mole_red		; SE o R0 for 0, é RED
 353 0108 02 5C		BL mole_green		; SE o R0 for 1, é GREEN
