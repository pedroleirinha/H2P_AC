 423           	; SHOW_MOLE_RED
 424           	; Mostra num LED vermelho do output port o estado de uma toupeira 
 425           	; R0 -> Nº da toupeira [4bits]
 426           	show_mole_red:
 427 0144 0E 24		PUSH LR
 428 0146 17 5C		BL outport_set_bits
 429           	
 430 0148 0F 04		POP PC
 431           	
 432           	
 433           	; SHOW_MOLE_RED
 434           	; Mostra num LED Verde do output port o estado de uma toupeira 
 435           	; R0 -> Nº da toupeira [4bits]
 436           	show_mole_green:
 437 014A 0E 24		PUSH LR
 438 014C 80 E0		LSL r0, r0, #1		; Faz o shift para a esquerda da posição inicial da toupeira para que acerte no input do LED verde
 439           	
 440 014E 13 5C		BL outport_set_bits
 441           	
 442 0150 0F 04		POP PC
 443           	
 444           	
 445           	; SHOW_MOLE_YELLOW
 446           	; Mostra num LED amarelo do output port o estado de uma toupeira 
 447           	; R0 -> Nº da toupeira [4bits]
 448           	show_mole_yellow:
 449 0152 0E 24		PUSH LR
 450 0154 81 E0		LSL r1, r0, #1		; Faz o shift para a esquerda da posição inicial da toupeira para que acerte no input do LED verde
 451 0156 80 C8		ORR r0, r0, r1
 452           	
 453 0158 0E 5C		BL outport_set_bits
 454           	
 455 015A 0F 04		POP PC
 456           	;; END SHOW MOLE
