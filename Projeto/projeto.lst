 497           	; Efeitos:   
 498           	check_mole_position:
 499 014C 0E 24		PUSH LR
 500           		
 501           		
 502 014E DA 5F		BL get_mole_green 
 503           	
 504 0150 B1 0D		LDR R1, out_port_img_addr
 505 0152 11 08		LDRB R1, [R1]
 506           	
 507 0154 80 C0		AND R0, R0, R1		; VERIFICA SE OS MESMOS BITS DO OUTPUT PORT E DA GREEN POSISTION DA TOUPEIRA SAO IGUAIS
 508           	
 509           	check_mole_return:
 510           	
 511 0156 0F 04		POP PC
 512           	;END CHECK_MOLE_POSITION
