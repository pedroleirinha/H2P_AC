 256           	;
 257           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 258           	; Tipo: - NÃO FOLHA -
 259           	; Parametros de entrada:
 260           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 261           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 262           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 263           	;
 264           	; variaveis locais:
 265           	;   uint8_t i --> r3
 266           	;
 267           	; Parametros de saida:
 268           	;   uint8_t ---------> r0
 269           	;
 270           	show_mole:
 271 00B8 0E 24		PUSH LR
 272           	
 273 00BA 13 60		MOV R3, #1
 274 00BC A0 B9		CMP R2, R3
 275           	
 276 00BE 03 40		BEQ mole_yellow		; SE o R1 for 1, é YELLOW 
 277           	
 278 00C0 90 B9		CMP R1, R3			; 
 279           		
 280 00C2 03 44		BNE mole_red		; SE o R0 for 0, é RED
 281 00C4 04 5C		BL mole_green		; SE o R0 for 1, é GREEN
 282           	
 283           	mole_yellow:
 284 00C6 13 5C		BL show_mole_yellow
 285 00C8 04 58		B show_mole_end
 286           		
 287           	mole_red:
 288 00CA 0C 5C		BL show_mole_red
 289 00CC 02 58		B show_mole_end
 290           	
 291           	mole_green:
 292 00CE 0C 5C		BL show_mole_green
 293 00D0 00 58		B show_mole_end
 294           	show_mole_end:
 295 00D2 0F 04		POP PC
