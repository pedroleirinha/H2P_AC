 462           	;
 463           	; >> Função GAME START SIGNAL << Coloca todos os leds a laranja
 464           	; Tipo: - FOLHA -
 465           	; Parametros de entrada:
 466           	;	-
 467           	; variaveis locais:
 468           	;	-
 469           	; Parametros de saida:
 470           	;   - 
 471           	;
 472           	game_start_signal: 
 473 013C 0E 24		PUSH LR
 474 013E F0 6F		MOV R0, #ALL_YELLOW_LIGHTS ; Coloca todos os 8 bits do output a 1, que significa ativar o RED e GREEN simultaneamente
 475           	
 476 0140 1F 5C		BL outport_set_bits
 477           	
 478 0142 0F 04		POP PC
 479           	; END
 480           	
 481           	;
 482           	; >> Função CLEAR LIGHTS << Desliga todos os leds
 483           	; Tipo: - NAO FOLHA -
 484           	; Parametros de entrada:
 485           	;	-
 486           	; variaveis locais:
 487           	;	-
 488           	; Parametros de saida:
 489           	;   - 
 490           	;
 491           	clear_lights: 
 492 0144 0E 24		PUSH LR
 493 0146 00 60		MOV R0, #NO_LIGHTS 
 494           	
 495 0148 28 5C		BL outport_write
 496           	
 497 014A 0F 04		POP PC
 498           	; END
 499           	
 500           	;
 501           	; >> Função READ_MARRETA << Lê os 4bits menos significativos do inputport
 502           	; Tipo: - NAO FOLHA -
 503           	; Parametros de entrada:
 504           	;	-
 505           	; variaveis locais:
 506           	;	-
 507           	; Parametros de saida:
 508           	;   - 
 509           	;
 510           	read_marreta:
 511 014C 0E 24		PUSH LR
 512           	
 513 014E F1 60		MOV R1, #0x0F
 514 0150 2A 5C		BL inport_read
 515 0152 80 C0		AND R0, R0, R1
 516           	
 517 0154 0F 04		POP PC
 518           	
 519           	;END READ_MARRETA
