 193           	; Rotina:    falling_edge_all_bits
 194           	; Descricao: Verifica se é detetada uma transição descendente em qualquer um dos primeiros 4 bits
 195           	; Entradas:  r0 - valor lido o porto de entrada
 196           	; 			 r1 - Mascara inicial que será shiftada até chegar ao zero (Verifica todos os bits de uma trama)
 197           	; 			 r2 - valor antigo a comparar
 198           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
 199           	; Efeitos:   
 200           	falling_edge_all_bits:
 201 0092 0E 24		PUSH LR
 202 0094 04 24		PUSH R4
 203 0096 05 24		PUSH R5
 204 0098 06 24		PUSH R6
 205           	
 206 009A 04 B0		MOV R4, R0
 207 009C 85 B0		MOV R5, R1
 208 009E 06 B1		MOV R6, R2
 209           		
 210           	check_cycle:
 211 00A0 00 B2		MOV R0, R4	; Carrega o valor lido do porto para o R0
 212 00A2 81 B2		MOV R1, R5	; Carrega a mascara a utilizar na verificacao do fallingedge no R1	
 213 00A4 02 B3		MOV R2, R6	; Carrega a ultima observação lida do porto para o R2
 214 00A6 0A 5C		BL falling_edge  				; RETORNA TRUE (1) OU FALSE (0)
 215 00A8 13 60		MOV R3, #1	
 216 00AA 80 B9		CMP R0, R3
 217 00AC 03 40		BZS return_falling_edge_all			; SE RETORNO DO FALLING EDGE É IGUAL A 1 => (R2)
 218           	
 219 00AE D5 E8		LSR R5, R5, #1					; FAZ O SHIFT da mascara [1000] em R1 um bit para a direita
 220 00B0 01 40		BZS return_falling_edge_all
 221           	
 222 00B2 F6 5B		B check_cycle
 223           	
 224           	return_falling_edge_all:
 225 00B4 06 04		POP R6
 226 00B6 05 04		POP R5
 227 00B8 04 04		POP R4
 228 00BA 0F 04		POP PC
 229           	;END falling_edge_all_bits
 230           	
 231           	; Rotina:    falling_edge
 232           	; Descricao: Retorna booleano indicando se detetou uma transição descendente no bit que controla o modo de funcionamento do sistema;
 233           	; Entradas:  r0 - valor lido o porto de entrada
 234           	; 			 r1 - a mascara do bit
 235           	;			 r2 - valor em memória
 236           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
 237           	; Efeitos:   
 238           	falling_edge:
 239 00BC 04 24		PUSH R4
 240 00BE 05 24		PUSH R5
 241           	
 242 00C0 84 C0		AND	r4, r0, r1 			; Aplica a mascara no valor de entrada. VERIFICA SE O VALOR ATUAL DO BIT É 0
 243           		; O bit atual do valor no inputport tem de ser 0 para detetar uma transição descendente 
 244           	
 245 00C2 04 44		BNE falling_edge_false	
 246           	
 247 00C4 14 C1		AND r4, r1, r2 			; Aplica a mascara no valor antigo. VERIFICA SE O VALOR ANTIGO DO BIT É 1
 248           	
 249 00C6 02 40		BZS falling_edge_false
 250           	
 251           		; TRANSICAO DESCENDENTE
 252 00C8 10 60		mov		r0, #1				; retorna true: observação anterior igual a OFF (1) e observação atual igual a ON (0)
 253 00CA 01 58		B  falling_edge_return
 254           	
 255           	falling_edge_false:
 256 00CC 00 60		mov		r0, #0
 257           	
 258           	falling_edge_return:
 259           		
 260 00CE 05 04		POP R5
 261 00D0 04 04		POP R4
 262           	
 263 00D2 0F B7		mov		pc, lr
 264           	
