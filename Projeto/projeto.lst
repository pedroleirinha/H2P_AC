 229 009E 02 58		B show_mole_end
 230           	
 231           	mole_green:
 232 00A0 0C 5C		BL show_mole_green
 233 00A2 00 58		B show_mole_end
 234           	show_mole_end:
 235 00A4 0F 04		POP PC
