 412 013A 03 48	    BHS	convert_end 
 413           	    
 414 013C 80 E0	    LSL r0, r0, #1          
 415 013E 91 A8	    SUB	r1, r1, #1          ; m => contador; m--
 416 0140 FB 5B	    B	convert_while
