 755           	/************************************************************************************
 756           	 * LIB time
 757           	 ************************************************************************************/
 758           	; Rotina:    time_get_ref
 759           	; Descricao: Obtém o tempo de referência (sysclk atual) para servir de referência à contagem de um tempo (implementar um relógio)
 760           	; Entradas:  void
 761           	; Saidas:    R0 - valor atual do sysclk (16 bits)
 762           	; Efeitos:   *** Para completar ***
 763           	time_get_ref:
 764 0216 0E 04		POP LR
 765           	
 766 0218 18 5C		BL sysclk_get_ticks
 767           	
 768 021A 0F 04		POP PC
 769           	;time_get_ref
 770           	
 771           	; Rotina:    time_elapsed
 772           	; Descricao: Retorna o número de ticks passados desde o tempo de referência
 773           	; Entradas:  R0 - tempo de referência (quando se iniciou a contagem de tempo)
 774           	; Saidas:    R0 - número de ticks passados desde tempo de referência (now-ref : de notar que o resultado da diferença continua a ser válido se now<ref)
 775           	; Efeitos:   *** Para completar ***
 776           	time_elapsed:
 777 021C 0E 04		POP LR
 778           	
 779 021E 01 B0		MOV R1, R0
 780           	
 781 0220 14 5C		BL sysclk_get_ticks		; Retorna o valor atual do sysclock
 782           	
 783 0222 80 88		SUB R0, R0, R1			; Calcula a diferença entre o tempo atual (sysclk) e o valor referncia (sysclk antigo)
 784           	
 785 0224 0F 04		POP PC
 786           	;time_elapsed
 787           	
 788           	/************************************************************************************
 789           	 * HAL sys_clk
 790           	 ************************************************************************************/
 791           	; Rotina:    isr
 792           	; Descricao: Incrementa o valor da variável global sysclk.
 793           	; Entradas:  -
 794           	; Saidas:    -
 795           	; Efeitos:   *** Para completar ***
 796           	isr:
 797 0226 01 24		PUSH	r1
 798 0228 00 24		PUSH	r0
 799 022A 00 60		MOV		r0, #INT_CS_ADDRESS & 0xFF
 800 022C F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 801 022E 02 28		STRB	r2, [r0, #0]
 802 0230 F0 0C		LDR		r0, SYSCLK_ADDR
 803 0232 01 08		LDRB	r1, [r0, #0]
 804 0234 91 A0		ADD		r1, r1, #1
 805 0236 01 28		STRB	r1, [r0, #0]
 806 0238 00 04		POP		r0
 807 023A 01 04		POP		r1	
 808 023C 20 B0		MOVS	pc, lr
 809           	
 810           	
 811           	; Rotina:    sysclk_init
 812           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 813           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 814           	;            interrupção pendentes e iniciando com o valor zero a variavel
 815           	;            global sysclk.
 816           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 817           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 818           	; Saidas:    -
 819           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 820           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 821           	;            valor zero a variavel global sysclk
 822           	sysclk_init:
 823 023E 0E 24		PUSH	lr
 824 0240 71 0C		LDR		r1, SYSCLK_ADDR
 825 0242 02 60		MOV		r2, #0
 826 0244 12 20		STR 	r2, [r1]
 827 0246 05 5C		BL		ptc_init
 828 0248 0F 04		POP		pc
 829           		
 830           	; Rotina:    sysclk_get_ticks
 831           	; Descricao: Devolve o valor corrente da variável global sysclk.
 832           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 833           	; Entradas:  -
 834           	; Saidas:    *** Para completar ***
 835           	; Efeitos:   -
 836           	sysclk_get_ticks:
 837 024A 20 0C		LDR		r0, SYSCLK_ADDR
 838 024C 00 00		LDR		r0, [r0]
 839 024E 0F B7		MOV		pc, lr
 840           	
 841           	SYSCLK_ADDR:
 842 0250 A5 02		.word	sysclk
 843           	
 844           	
 845           	/************************************************************************************
 846           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 847           	 ************************************************************************************/
 848           	; Rotina:    ptc_init
 849           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 850           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 851           	;            ticks.
 852           	;            Interface exemplo: void ptc_init( uint8_t interval );
 853           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 854           	; Saidas:    -
 855           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 856           	;            o pedido de interrupcao eventualmente pendente.
 857           	ptc_init:
 858 0252 0E 24	    PUSH    lr
 859 0254 00 24		PUSH	r0
 860 0256 0A 5C		BL 		ptc_stop
 861 0258 00 04		POP		r0
 862 025A 21 0D		LDR		r1, PTC_ADDR
 863 025C 10 29		STRB	r0, [r1, #PTC_TMR_ADDRESS]
 864 025E 0D 5C	    BL  	ptc_clr_irq
 865 0260 01 5C		BL 		ptc_start
 866 0262 0F 04		POP pc
 867           	
 868           	
 869           	; Rotina:    ptc_start
 870           	; Descricao: Habilita a contagem no periferico pTC.
 871           	;            Interface exemplo: void ptc_start( );
 872           	; Entradas:  -
 873           	; Saidas:    -
 874           	; Efeitos:   -
 875           	ptc_start:
 876 0264 D0 0C		LDR		r0, PTC_ADDR
 877 0266 01 60		MOV		r1, #PTC_CMD_START
 878 0268 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 879 026A 0F B7		MOV		pc, lr
 880           	
 881           	; Rotina:    ptc_stop
 882           	; Descricao: Para a contagem no periferico pTC.
 883           	;            Interface exemplo: void ptc_stop( );
 884           	; Entradas:  -
 885           	; Saidas:    -
 886           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 887           	ptc_stop:
 888 026C 90 0C		LDR		r0, PTC_ADDR
 889 026E 11 60		MOV		r1, #PTC_CMD_STOP
 890 0270 01 2A		STRB	r1, [r0, #PTC_TC_ADDRESS]
 891 0272 0F B7		MOV		pc, lr
 892           	
 893           	; Rotina:    ptc_get_value
 894           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 895           	;            Interface exemplo: uint8_t ptc_get_value( );
 896           	; Entradas:  -
 897           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 898           	; Efeitos:   -
 899           	ptc_get_value:
 900 0274 51 0C		LDR		r1, PTC_ADDR
 901 0276 10 0A		LDRB	r0, [r1, #PTC_TC_ADDRESS]
 902 0278 0F B7		MOV		pc, lr
 903           	
 904           	; Rotina:    ptc_clr_irq
 905           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 906           	;            interrupção.
 907           	;            Interface exemplo: void ptc_clr_irq( );
 908           	; Entradas:  -
 909           	; Saidas:    -
 910           	; Efeitos:   -
 911           	ptc_clr_irq:
 912 027A 20 0C		LDR		r0, PTC_ADDR
 913 027C 01 2B		STRB	r1, [r0, #PTC_TIR_ADDRESS]
 914 027E 0F B7		MOV		pc, lr
 915           	
 916           	PTC_ADDR:
 917 0280 00 FF		.word	PTC_ADDRESS
 918           	
 919           	
