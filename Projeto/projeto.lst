 454           	; Parametros de saida:
 455           	;   - 
 456           	;
 457           	read_marreta:
 458 012E 0E 24		PUSH LR
 459           	
 460 0130 F1 60		MOV R1, #0x0F
 461 0132 25 5C		BL inport_read
 462 0134 80 C0		AND R0, R0, R1
 463           	
 464 0136 0F 04		POP PC
 465           	
 466           	;END READ_MARRETA
