 335 00D6 80 E0	    LSL r0, r0, #1          
 336 00D8 91 A8	    SUB	r1, r1, #1          ; m => contador; m--
 337 00DA FB 5B	    B	convert_while
 338           	
 339           	convert_end:
 340           	
 341 00DC 0F B7		MOV PC, LR
