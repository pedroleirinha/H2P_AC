 519           	;;						;;
 520           	;; 		PORTS API 		;;
 521           	;; 						;;
 522           	
 523           	; OUTPORT_SET_BITS
 524           	; Introduz os BITS ao valor já no outputport através de uma mascara
 525           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 526           	;
 527           	outport_set_bits:
 528 0158 0E 24	    PUSH LR
 529           	    
 530 015A 61 0D	    LDR r1, out_port_img_addr
 531 015C 11 08	    LDRB r1, [r1]
 532           	
 533 015E 80 C8	    ORR r0, r0, r1
 534           	
 535 0160 08 5C	    BL outport_write
 536           	    
 537 0162 0F 04	    POP PC
 538           	
 539           	; OUTPORT_CLR_BITS
 540           	; Limpa os BITS do valor já no outputport através de uma mascara
 541           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 542           	;
 543           	outport_clr_bits:
 544 0164 0E 24	    PUSH LR
 545           	    
 546 0166 01 0D	    LDR r1, out_port_img_addr
 547 0168 11 08	    LDRB r1, [r1]
 548           	
 549 016A 10 B0	    MVN r0, r0
 550 016C 80 C0	    AND r0, r0, r1
 551           	
 552 016E 01 5C	    BL outport_write
 553           	    
 554 0170 0F 04	    POP PC
 555           	
 556           	
 557           	; Rotina:    outport_write
 558           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 559           	;            Interface exemplo: void outport_write( uint8_t value );
 560           	; Entradas:  r0 - valor a escrever no porto de saida
 561           	; Saidas:    -
 562           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 563           	outport_write:
 564 0172 01 6C		mov	 r1, #OUTPORT_ADDRESS & 0xFF
 565 0174 F1 7F		movt r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 566 0176 10 28		strb r0, [r1, #0]
 567           	
 568           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 569           		; uma mascara
 570           	
 571 0178 71 0C	    ldr r1, out_port_img_addr    
 572 017A 10 28	    strb r0, [r1, #0]
 573           	
 574 017C 0F B7		mov	pc, lr
 575           	
 576           	; Rotina:    INPORT_READ
 577           	; Descricao: lê do porto de saida os 8 bits.
 578           	;            Interface exemplo: uint8_t outport_write();
 579           	; Entradas:   - 
 580           	; Saidas:    r0 - valor lido do porto de entrada
 581           	
 582           	inport_read:
 583 017E 20 0C	    ldr r0, input_port_addr
 584 0180 00 08	    ldrb r0, [r0]
 585 0182 0F B7	    mov pc, lr
 586           	
 587 0184 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 588 0186 C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 589 0188 FB 01	out_port_img_addr:  .word outport_img
 590           	
