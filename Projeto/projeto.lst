 450           	game_start_signal: 
 451 0142 0E 24		PUSH LR
 452 0144 F0 6F		MOV R0, #0xFF ; Coloca todos os 8 bits do output a 1, que significa ativar o RED e GREEN simultaneamente
 453           	
 454 0146 1F 5C		BL outport_set_bits
 455           	
 456 0148 0F 04		POP PC
 457           	; END
