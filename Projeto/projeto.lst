 312           	; Entradas:  r0 - valor lido o porto de entrada
 313           	; 			 r1 - Mascara inicial 
 314           	falling_edge_v2:
 315 00CE 62 0C		LDR	 r2, last_play_addr
 316 00D0 23 08		LDRB r3, [r2]	; VALOR EM MEMORIA
 317           	
 318 00D2 20 28		STRB r0, [r2]	; ATUALIZA EM MEMORIA
 319           	
