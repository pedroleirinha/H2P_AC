 240           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 241           	; Tipo: - NÃO FOLHA -
 242           	; Parametros de entrada:
 243           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 244           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 245           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 246           	;
 247           	; variaveis locais:
 248           	;   uint8_t i --> r3
 249           	;
 250           	; Parametros de saida:
 251           	;   uint8_t ---------> r0
 252           	;
 253           	show_mole:
 254 00B4 0E 24		PUSH LR
 255           	
 256 00B6 13 60		MOV R3, #1
 257 00B8 A0 B9		CMP R2, R3
 258           	
 259 00BA 03 40		BEQ mole_yellow		; SE o R1 for 1, é YELLOW 
 260           	
 261 00BC 90 B9		CMP R1, R3			; 
 262           		
 263 00BE 03 44		BNE mole_red		; SE o R0 for 0, é RED
 264 00C0 04 5C		BL mole_green		; SE o R0 for 1, é GREEN
 265           	
 266           	mole_yellow:
 267 00C2 13 5C		BL show_mole_yellow
 268 00C4 04 58		B show_mole_end
 269           		
