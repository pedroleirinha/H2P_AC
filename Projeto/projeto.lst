 428           	; Rotina:    outport_write
 429           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 430           	;            Interface exemplo: void outport_write( uint8_t value );
 431           	; Entradas:  r0 - valor a escrever no porto de saida
 432           	; Saidas:    -
 433           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 434           	outport_write:
 435 0116 01 6C		mov	 r1, #OUTPORT_ADDRESS & 0xFF
 436 0118 F1 7F		movt r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 437 011A 10 28		strb r0, [r1, #0]
 438           	
 439           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 440           		; uma mascara
 441           	
 442 011C 71 0C	    ldr r1, out_port_img_addr    
 443 011E 10 28	    strb r0, [r1, #0]
 444           	
 445 0120 0F B7		mov	pc, lr
 446           	
 447           	; Rotina:    INPORT_READ
 448           	; Descricao: lê do porto de saida os 8 bits.
 449           	;            Interface exemplo: uint8_t outport_write();
 450           	; Entradas:   - 
 451           	; Saidas:    r0 - valor lido do porto de entrada
 452           	
 453           	inport_read:
 454 0122 20 0C	    ldr r0, input_port_addr
 455 0124 00 08	    ldrb r0, [r0]
 456 0126 0F B7	    mov pc, lr
 457           	
 458 0128 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 459 012A C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 460 012C 96 01	out_port_img_addr:  .word outport_img
