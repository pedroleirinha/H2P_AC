 330           	; >> Função SHOW_MOLE << Mostra nos LEDs do output port o estado de uma toupeira 
 331           	; Tipo: - NÃO FOLHA -
 332           	; Parametros de entrada:
 333           	;   uint8_t v -------> r0 - ; R0 -> Nº da toupeira [8bits]
 334           	;   uint8_t k -------> r1 - Estado da toupeira, #0 -> R, #1 -> G
 335           	;   uint8_t p -------> r2 - Estado da toupeira, #0 -> LR | G, #1 -> Yellow
 336           	;
 337           	; variaveis locais:
 338           	;   uint8_t i --> r3
 339           	;
 340           	; Parametros de saida:
 341           	;   uint8_t ---------> r0
 342           	;
 343           	show_mole:
 344 00FA 0E 24		PUSH LR
 345           	
 346 00FC 13 60		MOV R3, #1
 347 00FE 90 B9		CMP R1, R3			; 
 348           		
 349 0100 01 44		BNE mole_red		; SE o R0 for 0, é RED
 350 0102 02 5C		BL mole_green		; SE o R0 for 1, é GREEN
 351           	
