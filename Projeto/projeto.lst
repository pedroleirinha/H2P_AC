 564           	;;						;;
 565           	;; 		PORTS API 		;;
 566           	;; 						;;
 567           	
 568           	; OUTPORT_SET_BITS
 569           	; Introduz os BITS ao valor já no outputport através de uma mascara
 570           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 571           	;
 572           	outport_set_bits:
 573 0180 0E 24	    PUSH LR
 574           	    
 575 0182 61 0D	    LDR r1, out_port_img_addr
 576 0184 11 08	    LDRB r1, [r1]
 577           	
 578 0186 80 C8	    ORR r0, r0, r1
 579           	
 580 0188 08 5C	    BL outport_write
 581           	    
 582 018A 0F 04	    POP PC
 583           	
 584           	; OUTPORT_CLR_BITS
 585           	; Limpa os BITS do valor já no outputport através de uma mascara
 586           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 587           	;
 588           	outport_clr_bits:
 589 018C 0E 24	    PUSH LR
 590           	    
 591 018E 01 0D	    LDR r1, out_port_img_addr
 592 0190 11 08	    LDRB r1, [r1]
 593           	
 594 0192 10 B0	    MVN r0, r0
 595 0194 80 C0	    AND r0, r0, r1
 596           	
 597 0196 01 5C	    BL outport_write
 598           	    
 599 0198 0F 04	    POP PC
 600           	
 601           	
 602           	; Rotina:    outport_write
 603           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 604           	;            Interface exemplo: void outport_write( uint8_t value );
 605           	; Entradas:  r0 - valor a escrever no porto de saida
 606           	; Saidas:    -
 607           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 608           	outport_write:
 609 019A 01 6C		mov	 r1, #OUTPORT_ADDRESS & 0xFF
 610 019C F1 7F		movt r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 611 019E 10 28		strb r0, [r1, #0]
 612           	
 613           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 614           		; uma mascara
 615           	
 616 01A0 71 0C	    ldr r1, out_port_img_addr    
 617 01A2 10 28	    strb r0, [r1, #0]
 618           	
 619 01A4 0F B7		mov	pc, lr
 620           	
 621           	; Rotina:    INPORT_READ
 622           	; Descricao: lê do porto de saida os 8 bits.
 623           	;            Interface exemplo: uint8_t outport_write();
 624           	; Entradas:   - 
 625           	; Saidas:    r0 - valor lido do porto de entrada
 626           	
 627           	inport_read:
 628 01A6 20 0C	    ldr r0, input_port_addr
 629 01A8 00 08	    ldrb r0, [r0]
 630 01AA 0F B7	    mov pc, lr
 631           	
 632 01AC B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 633 01AE C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 634 01B0 23 02	out_port_img_addr:  .word outport_img
 635           	
