 692           	/************************************************************************************
 693           	 * HAL sys_clk
 694           	 ************************************************************************************/
 695           	; Rotina:    isr
 696           	; Descricao: Incrementa o valor da variável global sysclk.
 697           	; Entradas:  -
 698           	; Saidas:    -
 699           	; Efeitos:   *** Para completar ***
 700           	isr:
 701 01B8 01 24		PUSH	r1
 702 01BA 00 24		PUSH	r0
 703 01BC 00 60		MOV		r0, #INT_CS_ADDRESS & 0xFF
 704 01BE F0 7F		MOVT	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 705 01C0 02 28		STRB	r2, [r0, #0]
 706 01C2 F0 0C		LDR		r0, SYSCLK_ADDR
 707 01C4 01 08		LDRB	r1, [r0, #0]
 708 01C6 91 A0		ADD		r1, r1, #1
 709 01C8 01 28		STRB	r1, [r0, #0]
 710 01CA 00 04		POP		r0
 711 01CC 01 04		POP		r1
 712 01CE 20 B0		MOVS	pc, lr
 713           	
 714           	
 715           	; Rotina:    sysclk_init
 716           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 717           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 718           	;            interrupção pendentes e iniciando com o valor zero a variavel
 719           	;            global sysclk.
 720           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 721           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 722           	; Saidas:    -
 723           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 724           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 725           	;            valor zero a variavel global sysclk
 726           	sysclk_init:
 727 01D0 0E 24		PUSH	lr
 728 01D2 71 0C		LDR		r1, SYSCLK_ADDR
 729 01D4 02 60		MOV		r2, #0
 730 01D6 12 20		STR 	r2, [r1]
 731 01D8 05 5C		BL		ptc_init
 732 01DA 0F 04		POP		pc
 733           		
 734           	; Rotina:    sysclk_get_ticks
 735           	; Descricao: Devolve o valor corrente da variável global sysclk.
 736           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 737           	; Entradas:  -
 738           	; Saidas:    *** Para completar ***
 739           	; Efeitos:   -
 740           	sysclk_get_ticks:
 741 01DC 20 0C		LDR		r0, SYSCLK_ADDR
 742 01DE 00 00		LDR		r0, [r0]
 743 01E0 0F B7		MOV		pc, lr
 744           	
 745           	SYSCLK_ADDR:
 746 01E2 2F 02		.word	sysclk
 747           	
 748           	
 749           	/************************************************************************************
 750           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 751           	 ************************************************************************************/
 752           	; Rotina:    ptc_init
 753           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 754           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 755           	;            ticks.
 756           	;            Interface exemplo: void ptc_init( uint8_t interval );
 757           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 758           	; Saidas:    -
 759           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 760           	;            o pedido de interrupcao eventualmente pendente.
 761           	ptc_init:
 762 01E4 0E 24	    PUSH    lr
 763 01E6 00 24		PUSH	r0
 764 01E8 0A 5C		BL 		ptc_stop
 765 01EA 00 04		POP		r0
 766 01EC 21 0D		LDR		r1, PTC_ADDR
 767 01EE 90 28		STRB	r0, [r1, #PTC_TMR_ADDRESS]
 768 01F0 0D 5C	    BL  	ptc_clr_irq
 769 01F2 01 5C		BL 		ptc_start
 770 01F4 0F 04		POP pc
 771           	
 772           	
 773           	; Rotina:    ptc_start
 774           	; Descricao: Habilita a contagem no periferico pTC.
 775           	;            Interface exemplo: void ptc_start( );
 776           	; Entradas:  -
 777           	; Saidas:    -
 778           	; Efeitos:   -
 779           	ptc_start:
 780 01F6 D0 0C		LDR		r0, PTC_ADDR
 781 01F8 01 60		MOV		r1, #PTC_CMD_START
 782 01FA 01 29		STRB	r1, [r0, #PTC_TC_ADDRESS]
 783 01FC 0F B7		MOV		pc, lr
 784           	
 785           	; Rotina:    ptc_stop
 786           	; Descricao: Para a contagem no periferico pTC.
 787           	;            Interface exemplo: void ptc_stop( );
 788           	; Entradas:  -
 789           	; Saidas:    -
 790           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 791           	ptc_stop:
 792 01FE 90 0C		LDR		r0, PTC_ADDR
 793 0200 11 60		MOV		r1, #PTC_CMD_STOP
 794 0202 01 29		STRB	r1, [r0, #PTC_TC_ADDRESS]
 795 0204 0F B7		MOV		pc, lr
 796           	
 797           	; Rotina:    ptc_get_value
 798           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 799           	;            Interface exemplo: uint8_t ptc_get_value( );
 800           	; Entradas:  -
 801           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 802           	; Efeitos:   -
 803           	ptc_get_value:
 804 0206 51 0C		LDR		r1, PTC_ADDR
 805 0208 10 09		LDRB	r0, [r1, #PTC_TC_ADDRESS]
 806 020A 0F B7		MOV		pc, lr
 807           	
