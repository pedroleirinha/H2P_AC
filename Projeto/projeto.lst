 475           	;
 476           	; >> Função READ_MARRETA << Lê os 4bits menos significativos do inputport
 477           	; Tipo: - FOLHA -
 478           	; Parametros de entrada:
 479           	;	-
 480           	; variaveis locais:
 481           	;	-
 482           	; Parametros de saida:
 483           	;   - 
 484           	;
 485           	read_marreta:
 486 014C 0E 24		PUSH LR
 487           	
 488 014E F1 60		MOV R1, #0x0F
 489 0150 2A 5C		BL inport_read
 490 0152 80 C0		AND R0, R0, R1
 491           	
 492 0154 0F 04		POP PC
 493           	
