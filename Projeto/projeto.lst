 381 012A 0C 5C		BL show_mole_red
 382 012C 02 58		B show_mole_end
 383           	
 384           	mole_green:
 385 012E 0D 5C		BL show_mole_green
 386 0130 00 58		B show_mole_end
 387           	show_mole_end:
 388 0132 0F 04		POP PC
 389           	
 390           	
