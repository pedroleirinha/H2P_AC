  95           	; Rotina:    falling_edge
  96           	; Descricao: Retorna booleano indicando se detetou uma transição descendente no bit que controla o modo de funcionamento do sistema;
  97           	; Entradas:  r0 - valor lido o porto de entrada
  98           	; 			 r1 - a mascara do bit
  99           	; Saidas:    r0 - igual a 0 -> não ocorreu transição descendente; diferente de 0 -> ocorreu transição descendente
 100           	; Efeitos:   
 101           	falling_edge:
 102           	
 103 003A 82 0D		ldr		r2, last_play_addr
 104 003C 22 08		ldrb	r2, [r2]			; R2 = observação anterior do bit que controla o modo de operação
 105 003E 85 C0		AND 	r5, r0, r1 			; Aplica a mascara no valor de entrada
 106           	
 107           		; O bit atual do valor no inputport tem de ser 0 para detetar uma transição descendente 
 108           	
 109 0040 05 44		BNE falling_edge_false
 110           	
 111 0042 12 C1		AND 	r2, r1, r2 			; Aplica a mascara no valor antigo
 112           	
 113 0044 03 40		BZS falling_edge_false
 114           		; TRANSICAO DESCENDENTE
 115 0046 10 60		mov		r0, #1				; retorna true: observação anterior igual a OFF (1) e observação atual igual a ON (0)
 116 0048 0F B7		mov		pc, lr
 117           	
 118 004A 03 58		B falling_edge_return
 119           	
 120           	falling_edge_false:
 121           	
 122 004C 75 60		mov 	r5, #FALLING_EDGE_MODE_MSK
 123 004E 80 C2		and		r0, r0, r5			; isola o valor atual do bit modo piscar
 124 0050 10 28		strb	r0, [r1]
 125           	
 126           	
 127           	falling_edge_return:
 128           	
 129 0052 00 60		mov		r0, #0
 130 0054 0F B7		mov		pc, lr
