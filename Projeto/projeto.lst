 528           	/************************************************************************************
 529           	 * HAL sys_clk
 530           	 ************************************************************************************/
 531           	; Rotina:    isr
 532           	; Descricao: Incrementa o valor da variável global sysclk.
 533           	; Entradas:  -
 534           	; Saidas:    -
 535           	; Efeitos:   *** Para completar ***
 536           	isr:
 537 0146 01 24		push	r1
 538 0148 00 24		push	r0
 539 014A 00 60		mov	r0, #INT_CS_ADDRESS & 0xFF
 540 014C F0 7F		movt	r0, #(INT_CS_ADDRESS >> 8) & 0xFF
 541 014E 02 28		strb	r2, [r0, #0]
 542 0150 60 0C		ldr	r0, var_addr_isr
 543 0152 01 08		ldrb	r1, [r0, #0]
 544 0154 91 A0		add	r1, r1, #1
 545 0156 01 28		strb	r1, [r0, #0]
 546 0158 00 04		pop	r0
 547 015A 01 04		pop	r1
 548 015C 20 B0		movs	pc, lr
 549           	
 550 015E AC 01	var_addr_isr:		.word var
 551           	
 552           	; Rotina:    sysclk_init
 553           	; Descricao: Inicia uma nova contagem no periferico pTC com o intervalo de
 554           	;            contagem recebido em R0, em ticks, limpando eventuais pedidos de
 555           	;            interrupção pendentes e iniciando com o valor zero a variavel
 556           	;            global sysclk.
 557           	;            Interface exemplo: void sysclk_init( uint8_t interval );
 558           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 559           	; Saidas:    -
 560           	; Efeitos:   Inicia a contagem no periférico a partir do valor zero, limpando
 561           	;            eventuais pedidos de interrupção pendentes e iniciando com o
 562           	;            valor zero a variavel global sysclk
 563           	sysclk_init:
 564 0160 0E 24		push	lr
 565 0162 71 0C		ldr		r1, SYSCLK_ADDR
 566 0164 02 60		mov		r2, #0
 567 0166 12 20		str 	r2, [r1]
 568 0168 05 5C		bl		ptc_init
 569 016A 0F 04		pop		pc
 570           		
 571           	; Rotina:    sysclk_get_ticks
 572           	; Descricao: Devolve o valor corrente da variável global sysclk.
 573           	;            Interface exemplo: uint16_t sysclk_get_ticks ( );
 574           	; Entradas:  -
 575           	; Saidas:    *** Para completar ***
 576           	; Efeitos:   -
 577           	sysclk_get_ticks:
 578 016C 20 0C		ldr		r0, SYSCLK_ADDR
 579 016E 00 00		ldr		r0, [r0]
 580 0170 0F B7		mov		pc, lr
 581           	
 582           	SYSCLK_ADDR:
 583 0172 B0 01		.word	sysclk
 584           	
 585           	/************************************************************************************
 586           	 * Gestor de periférico para o Pico Timer/Counter (pTC): HAL pTC
 587           	 ************************************************************************************/
 588           	; Rotina:    ptc_init
 589           	; Descricao: Faz a iniciacao do periférico pTC, habilitando o seu funcionamento
 590           	;            em modo contínuo e com o intervalo de contagem recebido em R0, em
 591           	;            ticks.
 592           	;            Interface exemplo: void ptc_init( uint8_t interval );
 593           	; Entradas:  R0 - Valor do novo intervalo de contagem, em ticks.
 594           	; Saidas:    -
 595           	; Efeitos:   Inicia a contagem no periferico a partir do valor zero, limpando
 596           	;            o pedido de interrupcao eventualmente pendente.
 597           	ptc_init:
 598 0174 0E 24	    push    lr
 599 0176 00 24		push	r0
 600 0178 0A 5C		bl 		ptc_stop
 601 017A 00 04		pop		r0
 602 017C 21 0D		ldr		r1, PTC_ADDR
 603 017E 90 28		strb	r0, [r1, #PTC_TMR_ADDRESS]
 604 0180 0D 5C	    bl  	ptc_clr_irq
 605 0182 01 5C		bl 		ptc_start
 606 0184 0F 04		pop pc
 607           	
 608           	
 609           	; Rotina:    ptc_start
 610           	; Descricao: Habilita a contagem no periferico pTC.
 611           	;            Interface exemplo: void ptc_start( );
 612           	; Entradas:  -
 613           	; Saidas:    -
 614           	; Efeitos:   -
 615           	ptc_start:
 616 0186 D0 0C		ldr		r0, PTC_ADDR
 617 0188 11 60		mov		r1, #PTC_CMD_START
 618 018A 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 619 018C 0F B7		mov		pc, lr
 620           	
 621           	; Rotina:    ptc_stop
 622           	; Descricao: Para a contagem no periferico pTC.
 623           	;            Interface exemplo: void ptc_stop( );
 624           	; Entradas:  -
 625           	; Saidas:    -
 626           	; Efeitos:   O valor do registo TC do periferico e colocado a zero.
 627           	ptc_stop:
 628 018E 90 0C		ldr		r0, PTC_ADDR
 629 0190 01 60		mov		r1, #PTC_CMD_STOP
 630 0192 01 29		strb	r1, [r0, #PTC_TC_ADDRESS]
 631 0194 0F B7		mov		pc, lr
 632           	
 633           	; Rotina:    ptc_get_value
 634           	; Descricao: Devolve o valor corrente da contagem do periferico pTC.
 635           	;            Interface exemplo: uint8_t ptc_get_value( );
 636           	; Entradas:  -
 637           	; Saidas:    R0 - O valor corrente do registo TC do periferico.
 638           	; Efeitos:   -
 639           	ptc_get_value:
 640 0196 51 0C		ldr		r1, PTC_ADDR
 641 0198 10 09		ldrb	r0, [r1, #PTC_TC_ADDRESS]
 642 019A 0F B7		mov		pc, lr
 643           	
 644           	; Rotina:    ptc_clr_irq
 645           	; Descricao: Sinaliza o periferico pTC que foi atendido um pedido de
 646           	;            interrupção.
 647           	;            Interface exemplo: void ptc_clr_irq( );
 648           	; Entradas:  -
 649           	; Saidas:    -
 650           	; Efeitos:   -
 651           	ptc_clr_irq:
 652 019C 20 0C		ldr		r0, PTC_ADDR
 653 019E 81 29		strb	r1, [r0, #PTC_TIR_ADDRESS]
 654 01A0 0F B7		mov		pc, lr
 655           	
 656           	PTC_ADDR:
 657 01A2 00 FF		.word	PTC_ADDRESS
 658           	
 659           	
 660           	
 661           	period:
 662 01A4 05		.byte 0x05 ; 1s
 663 01A5 0A	    .byte 0x0A ; 2s
 664 01A6 0F	    .byte 0x0F ; 3s
 665 01A7 14	    .byte 0x14 ; 4s
 666 01A8 19	    .byte 0x19 ; 5s
 667 01A9 1E	    .byte 0x1E ; 6s
 668 01AA 23	    .byte 0x23 ; 7s
 669 01AB 28	    .byte 0x28 ; 8s
