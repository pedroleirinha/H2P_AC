 506           	;
 507           	; >> Função CONVERT_MOLEINPUT_MOLEOUTPUT <<
 508           	; Tipo: - FOLHA -
 509           	; Parametros de entrada:
 510           	;   uint4_t num_ -------> r0
 511           	;
 512           	; variaveis locais:
 513           	;   uint8_t contador  --> r2
 514           	;
 515           	; Parametros de saida:
 516           	;   uint8_t ---------> r0
 517           	;
 518           	convert_moleinput_moleoutput:
 519 018C 01 60		MOV R1, #0
 520           	convert_while:
 521           	
 522 018E 80 E8	    LSR r0, r0, #1          
 523 0190 02 40		BZS convert_end
 524 0192 91 A0	    ADD r1, r1, #1          ; m => contador; m--
 525 0194 FC 5B	    B	convert_while
 526           	
 527           	convert_end:
 528 0196 80 B0		MOV R0, R1
 529 0198 0F B7		MOV PC, LR
 530           	; END CONVERT
