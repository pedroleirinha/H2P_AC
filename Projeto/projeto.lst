 884           	stack_top:
 885           	
 886           	
 887           	; SE A FREQ FOR 100kH, dá 0.01ms por cada contagem de clock. Se for até 255, dá no maximo 2,5ms
 888           	; SE A FREQ FOR 1kH, dá 1ms por cada contagem de clock. Se for até 255, dá no maximo 255ms
 889           	
 890           	; COM 10HZ
 891           	; 	TEMPO		CICLOS	PL		
 892           	; 	10 s		100		99 	[0x63]
 893           	; 	9  s		90		89	[0x59]
 894           	; 	8  s		80		79	[0x4F]
 895           	; 	7  s		70		69	[0x45]
 896           	; 	6  s		60		59	[0x3B]
 897           	; 	5  s		50		49	[0x31]
 898           	; 	4  s		40		39	[0x27]
 899           	; 	3  s		30		29	[0x1D]
 900           	; 	2  s		20		19	[0x13]
 901           	; 	1  s		10		09	[0x09]
 902           	; 	0.5s		5		04	[0x04]
 903           	; 
 903           	
