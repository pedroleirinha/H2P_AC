 512           	;;						;;
 513           	;; 		PORTS API 		;;
 514           	;; 						;;
 515           	
 516           	; OUTPORT_SET_BITS
 517           	; Introduz os BITS ao valor já no outputport através de uma mascara
 518           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 519           	;
 520           	outport_set_bits:
 521 0176 0E 24	    PUSH LR
 522           	    
 523 0178 61 0D	    LDR r1, out_port_img_addr
 524 017A 11 08	    LDRB r1, [r1]
 525           	
 526 017C 80 C8	    ORR r0, r0, r1
 527           	
 528 017E 08 5C	    BL outport_write
 529           	    
 530 0180 0F 04	    POP PC
 531           	
 532           	; OUTPORT_CLR_BITS
 533           	; Limpa os BITS do valor já no outputport através de uma mascara
 534           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 535           	;
 536           	outport_clr_bits:
 537 0182 0E 24	    PUSH LR
 538           	    
 539 0184 01 0D	    LDR r1, out_port_img_addr
 540 0186 11 08	    LDRB r1, [r1]
 541           	
 542 0188 10 B0	    MVN r0, r0
 543 018A 80 C0	    AND r0, r0, r1
 544           	
 545 018C 01 5C	    BL outport_write
 546           	    
 547 018E 0F 04	    POP PC
 548           	
 549           	
 550           	; Rotina:    outport_write
 551           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 552           	;            Interface exemplo: void outport_write( uint8_t value );
 553           	; Entradas:  r0 - valor a escrever no porto de saida
 554           	; Saidas:    -
 555           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 556           	outport_write:
 557 0190 01 6C		mov	 r1, #OUTPORT_ADDRESS & 0xFF
 558 0192 F1 7F		movt r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 559 0194 10 28		strb r0, [r1, #0]
 560           	
 561           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 562           		; uma mascara
 563           	
 564 0196 71 0C	    ldr r1, out_port_img_addr    
 565 0198 10 28	    strb r0, [r1, #0]
 566           	
 567 019A 0F B7		mov	pc, lr
 568           	
 569           	; Rotina:    INPORT_READ
 570           	; Descricao: lê do porto de saida os 8 bits.
 571           	;            Interface exemplo: uint8_t outport_write();
 572           	; Entradas:   - 
 573           	; Saidas:    r0 - valor lido do porto de entrada
 574           	
 575           	inport_read:
 576 019C 20 0C	    ldr r0, input_port_addr
 577 019E 00 08	    ldrb r0, [r0]
 578 01A0 0F B7	    mov pc, lr
 579           	
 580 01A2 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 581 01A4 C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 582 01A6 10 02	out_port_img_addr:  .word outport_img
 583           	
 584           	
