 464           	;
 465           	; >> Função CONVERT_MOLEINPUT_MOLEOUTPUT <<
 466           	; Tipo: - FOLHA -
 467           	; Parametros de entrada:
 468           	;   uint4_t num_ -------> r0
 469           	;
 470           	; variaveis locais:
 471           	;   uint8_t contador  --> r2
 472           	;
 473           	; Parametros de saida:
 474           	;   uint8_t ---------> r0
 475           	;
 476           	convert_moleinput_moleoutput:
 477 015E 01 60		MOV R1, #0
 478           	convert_while:
 479           	
 480 0160 80 E8	    LSR r0, r0, #1          
 481 0162 02 40		BZS convert_end
 482 0164 91 A0	    ADD r1, r1, #1          ; m => contador; m--
 483 0166 FC 5B	    B	convert_while
 484           	
 485           	convert_end:
 486 0168 80 B0		MOV R0, R1
 487 016A 0F B7		MOV PC, LR
 488           	; END CONVERT
