 420           	; OUTPORT_SET_BITS
 421           	; Introduz os BITS ao valor já no outputport através de uma mascara
 422           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 423           	;
 424           	outport_set_bits:
 425 011A 0E 24	    PUSH LR
 426           	    
 427 011C 61 0D	    LDR r1, out_port_img_addr
 428 011E 11 08	    LDRB r1, [r1]
 429           	
 430 0120 80 C8	    ORR r0, r0, r1
 431           	
 432 0122 08 5C	    BL outport_write
 433           	    
 434 0124 0F 04	    POP PC
 435           	
 436           	; OUTPORT_CLR_BITS
 437           	; Limpa os BITS do valor já no outputport através de uma mascara
 438           	; R0 -> é a mascara que será aplicada ao valor já existente no output-port
 439           	;
 440           	outport_clr_bits:
 441 0126 0E 24	    PUSH LR
 442           	    
 443 0128 01 0D	    LDR r1, out_port_img_addr
 444 012A 11 08	    LDRB r1, [r1]
 445           	
 446 012C 10 B0	    MVN r0, r0
 447 012E 80 C0	    AND r0, r0, r1
 448           	
 449 0130 01 5C	    BL outport_write
 450           	    
 451 0132 0F 04	    POP PC
 452           	
 453           	
 454           	; Rotina:    outport_write
 455           	; Descricao: Escreve num porto de saida a 8 bits o valor passado como argumento.
 456           	;            Interface exemplo: void outport_write( uint8_t value );
 457           	; Entradas:  r0 - valor a escrever no porto de saida
 458           	; Saidas:    -
 459           	; Efeitos:   r1 - guarda o endereco do porto alvo da escrita
 460           	outport_write:
 461 0134 01 6C		mov	 r1, #OUTPORT_ADDRESS & 0xFF
 462 0136 F1 7F		movt r1, #(OUTPORT_ADDRESS >> 8) & 0xFF
 463 0138 10 28		strb r0, [r1, #0]
 464           	
 465           		; É necessário guardar o ultimo valor escrito no output port para conseguirmos modificar o ultimo valor com
 466           		; uma mascara
 467           	
 468 013A 71 0C	    ldr r1, out_port_img_addr    
 469 013C 10 28	    strb r0, [r1, #0]
 470           	
 471 013E 0F B7		mov	pc, lr
 472           	
 473           	; Rotina:    INPORT_READ
 474           	; Descricao: lê do porto de saida os 8 bits.
 475           	;            Interface exemplo: uint8_t outport_write();
 476           	; Entradas:   - 
 477           	; Saidas:    r0 - valor lido do porto de entrada
 478           	
 479           	inport_read:
 480 0140 20 0C	    ldr r0, input_port_addr
 481 0142 00 08	    ldrb r0, [r0]
 482 0144 0F B7	    mov pc, lr
 483           	
 484 0146 B0 FF	input_port_addr:	.word INPUTPORT_ADDR
 485 0148 C0 FF	out_port_addr:		.word OUTPORT_ADDRESS
 486 014A B4 01	out_port_img_addr:  .word outport_img
